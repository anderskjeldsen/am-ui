namespace Am.Ui.Tests
{
    // Reproduces the AppLauncher example layout (VStack > [Separator, Panel >
    // HStack > Buttons]) inside a 150x100 simulator window and asserts that
    // each button's text cell ends up inside its own painted area — the bug
    // we hit on real Amiga where Panel.paintAll's missing pushClipRect made
    // child clip rects land at the wrong absolute coords, so labels were
    // half-clipped.
    //
    // The amigaos-sim font is a fixed 8-pixel cell per character. With the
    // foreground pen at draw time, drawString fills the cell with the pen
    // index. So we can read pixels via HeadlessPainter.getPixelAt to verify:
    //   - somewhere inside each button → non-zero (button background was drawn)
    //   - somewhere inside the label cell → non-zero (label was drawn,
    //     i.e. NOT clipped out)
    class AppLauncherLayoutTest {
        import Am.Lang
        import Am.Ui
        import Am.Tests

        test buttonsRenderInsideTheirBounds() {
            var window = Window.openWindow(0S, 0S, 150US, 100US, null, null)

            // Mirror AppLauncher: VStack root with default padding,
            // a separator, and a Panel containing an HStack of buttons.
            var root = new VStack(0S)
            root.setDefaultPadding()

            var sep = new Separator(SeparatorOrientation.Horizontal)
            root.addChild(sep)

            var appPanel = new Panel()
            appPanel.setDefaultPadding()
            appPanel.setDefaultBorder()
            appPanel.growX = 255UB
            appPanel.growY = 0UB
            root.addChild(appPanel)

            var appsRow = new HStack(0S)
            appsRow.setDefaultPadding()
            appsRow.growX = 0UB
            appsRow.growY = 0UB
            appPanel.setChild(appsRow)

            // Three buttons, like the AppLauncher cards.
            var btn1 = new Button("A", (v) => { return true })
            btn1.setDefaultPadding()
            btn1.setDefaultBorder()
            btn1.growX = 1UB
            appsRow.addChild(btn1)

            var btn2 = new Button("B", (v) => { return true })
            btn2.setDefaultPadding()
            btn2.setDefaultBorder()
            btn2.growX = 1UB
            appsRow.addChild(btn2)

            var btn3 = new Button("C", (v) => { return true })
            btn3.setDefaultPadding()
            btn3.setDefaultBorder()
            btn3.growX = 1UB
            appsRow.addChild(btn3)

            window.setRootView(root)
            window.layout()
            window.repaint()

            // Each button is at absolute Y = root.padding.top + sep.height +
            // panel.margin.top + panel.border.top + panel.padding.top, with
            // its own border/padding added on top. Without computing exact
            // pixel positions, we walk the panel's interior row by row and
            // count how many pixels inside it are non-zero. If the bug is
            // back, the panel's content area will be mostly zero (clipped
            // away) — with the fix, it should be largely painted.
            var paintedInsidePanel = AppLauncherLayoutTest.countNonZeroInPanel(window, appPanel)

            window.close()

            // Empirically a 150-wide panel with three buttons has hundreds
            // of painted pixels when the layout works; pre-fix it would
            // typically have an order of magnitude fewer (only the topmost
            // strip survives the misplaced clip).
            ("painted pixels inside panel: " + paintedInsidePanel.toString()).println()
            Assert.assertTrue(paintedInsidePanel > 100)
        }

        // Same panel-shaped layout as the test above, but assert specifically
        // that a button's label rendered as a full 8-pixel-tall block. If the
        // clip-rect bug were back, the label would be partially clipped — the
        // tallest run of label pixels (pen 1) bounded above by a pen-0 pixel
        // would shrink below 8.
        test buttonTextRenders8PixelsHigh() {
            var window = Window.openWindow(0S, 0S, 150US, 100US, null, null)

            var root = new VStack(0S)
            root.setDefaultPadding()

            var sep = new Separator(SeparatorOrientation.Horizontal)
            root.addChild(sep)

            var appPanel = new Panel()
            appPanel.setDefaultPadding()
            appPanel.setDefaultBorder()
            appPanel.growX = 255UB
            appPanel.growY = 0UB
            root.addChild(appPanel)

            var appsRow = new HStack(0S)
            appsRow.setDefaultPadding()
            appsRow.growX = 0UB
            appsRow.growY = 0UB
            appPanel.setChild(appsRow)

            var btn1 = new Button("A", (v) => { return true })
            btn1.setDefaultPadding()
            btn1.setDefaultBorder()
            btn1.growX = 1UB
            appsRow.addChild(btn1)

            var btn2 = new Button("B", (v) => { return true })
            btn2.setDefaultPadding()
            btn2.setDefaultBorder()
            btn2.growX = 1UB
            appsRow.addChild(btn2)

            window.setRootView(root)
            window.layout()
            window.repaint()

            // Print every column with an 8-tall pen-1 run and where it starts,
            // so we can verify the blocks land at the labels' computed Y.
            AppLauncherLayoutTest.dumpLabelBlocks(window, appPanel)

            // Compute the expected label Y from layout math:
            //   sep.height = 1 (thickness, no padding/border).
            //   panel.y = 1, panel.margin.top = 0, panel.borderWidths.top = 1, panel.padding.top = 2
            //   HStack.y inside panel = 0+1+2 = 3, so HStack absolute y = 1 + 3 = 4
            //   button.y inside HStack = 0, so button absolute y = 4
            //   label.y inside button = (8/2 - 8/2) + 0 + 1 + 5 = 6,
            //     so label absolute y = 4 + 6 = 10
            //   label cell spans rows [10, 18).
            // Expected X: button1 spans [6, 75), button2 spans [75, 144).
            //   innerWidth = 69 - 14 = 55; lx = (55/2 - 8/2) + 7 = 30
            //   button1 label cell: [6+30, 6+30+8) = [36, 44)
            //   button2 label cell: [75+30, 75+30+8) = [105, 113)
            var btn1Hit = AppLauncherLayoutTest.allEightRowsPenOne(window, 36S, 43S, 10S)
            var btn2Hit = AppLauncherLayoutTest.allEightRowsPenOne(window, 105S, 112S, 10S)

            window.close()

            Assert.assertTrue(btn1Hit)
            Assert.assertTrue(btn2Hit)
        }

        // Verify the 8x8 label block at (xStart..xEnd, y..y+7) is fully pen 1.
        static fun allEightRowsPenOne(window: Window, xStart: Short, xEnd: Short, y: Short): Bool {
            var x = xStart
            while (x <= xEnd) {
                var dy = 0
                while (dy < 8) {
                    var py = (y.toInt() + dy).toShort()
                    var pen = HeadlessPainter.getPixelAt(window, x, py)
                    if (pen != 1UB) {
                        ("MISS at (" + x.toString() + "," + py.toString() + ") pen=" + pen.toString()).println()
                        return false
                    }
                    dy = dy + 1
                }
                x = (x.toInt() + 1).toShort()
            }
            return true
        }

        // Print every (x, y) where a pen-1 run of height 8 starts, bounded by
        // pen 0 above. Useful for eyeballing label-block positions.
        static fun dumpLabelBlocks(window: Window, panel: Panel) {
            var startX = panel.x
            var startY = panel.y
            var sumX = panel.x.toInt() + panel.width.toInt()
            var sumY = panel.y.toInt() + panel.height.toInt()
            var endX = sumX.toShort()
            var endY = sumY.toShort()
            var x = startX
            while (x < endX) {
                var y = startY
                while (y < endY) {
                    var here = HeadlessPainter.getPixelAt(window, x, y)
                    var above: UByte = 0UB
                    if (y > startY) {
                        var ay = (y.toInt() - 1).toShort()
                        above = HeadlessPainter.getPixelAt(window, x, ay)
                    }
                    if (here == 1UB && above == 0UB) {
                        var run = 0
                        var ry = y
                        var inRun = true
                        while (inRun && ry < endY) {
                            var p = HeadlessPainter.getPixelAt(window, x, ry)
                            if (p == 1UB) {
                                run = run + 1
                                ry = (ry.toInt() + 1).toShort()
                            } else {
                                inRun = false
                            }
                        }
                        if (run == 8) {
                            ("8-tall pen-1 block at x=" + x.toString() + " y=" + y.toString()).println()
                        }
                        y = ry
                    } else {
                        y = (y.toInt() + 1).toShort()
                    }
                }
                x = (x.toInt() + 1).toShort()
            }
        }

        // Sweep every column inside the panel looking for a vertical run of
        // pen-1 pixels of EXACTLY `expectedHeight`, preceded by a pen-0 pixel
        // (or the panel top edge). The preceded-by-zero filter excludes the
        // right border (pen 1, but butted against the pen-2 top border, not
        // pen 0). The exact-height filter excludes Panel's own left border
        // (pen 1, full panel height ~26) and Button's right border (pen 1,
        // full button height ~20) — only the 8-pixel-tall label cell
        // matches. Returns true if any matching column is found.
        static fun hasLabelBlockOfHeight(window: Window, panel: Panel, expectedHeight: Int): Bool {
            var startX = panel.x
            var startY = panel.y
            var sumX = panel.x.toInt() + panel.width.toInt()
            var sumY = panel.y.toInt() + panel.height.toInt()
            var endX = sumX.toShort()
            var endY = sumY.toShort()

            var x = startX
            while (x < endX) {
                var y = startY
                while (y < endY) {
                    var here = HeadlessPainter.getPixelAt(window, x, y)
                    var above: UByte = 0UB
                    if (y > startY) {
                        var ay = (y.toInt() - 1).toShort()
                        above = HeadlessPainter.getPixelAt(window, x, ay)
                    }
                    if (here == 1UB && above == 0UB) {
                        var run = 0
                        var ry = y
                        var inRun = true
                        while (inRun && ry < endY) {
                            var p = HeadlessPainter.getPixelAt(window, x, ry)
                            if (p == 1UB) {
                                run = run + 1
                                ry = (ry.toInt() + 1).toShort()
                            } else {
                                inRun = false
                            }
                        }
                        if (run == expectedHeight) {
                            return true
                        }
                        y = ry
                    } else {
                        y = (y.toInt() + 1).toShort()
                    }
                }
                x = (x.toInt() + 1).toShort()
            }
            return false
        }

        // Sweep the panel's bounding box and count non-zero pixels.
        // Coordinates are in the window's coordinate system (post-layout
        // panel.x/y/width/height).
        static fun countNonZeroInPanel(window: Window, panel: Panel): Int {
            var count = 0
            var startX = panel.x
            var startY = panel.y
            var sumX = panel.x.toInt() + panel.width.toInt()
            var sumY = panel.y.toInt() + panel.height.toInt()
            var endX = sumX.toShort()
            var endY = sumY.toShort()
            var x = startX
            while (x < endX) {
                var y = startY
                while (y < endY) {
                    var pen = HeadlessPainter.getPixelAt(window, x, y)
                    if (pen != 0UB) {
                        count = count + 1
                    }
                    var ny = y.toInt() + 1
                    y = ny.toShort()
                }
                var nx = x.toInt() + 1
                x = nx.toShort()
            }
            return count
        }
    }
}
