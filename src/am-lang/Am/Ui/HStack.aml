
namespace Am.Ui 
{

    class HStack(var spacing: Short) : ViewGroup {
        import Am.Lang
        import Am.Collections

        override fun layoutChildren() {
            // Child positions are relative to this stack's outer box
            // (ViewGroup.paintAll's child pass translates by the raw
            // x, y) — start past the stack's own margin + border +
            // padding, mirroring VStack.layoutChildren. Previously the
            // children started at (0,0), which both ignored the
            // stack's margin AND left all the padding slack on the
            // right/bottom edge.
            var x = this.margin.left + this.borderWidths.left + this.padding.left
            var y = this.margin.top + this.borderWidths.top + this.padding.top

            var width = this.innerWidth()
            var minWidth = this.innerMinWidth()

            var unusedWidth = Short.max(width - minWidth, 0S)
            var remainingWidth = unusedWidth

            var sumGrowX = this.sumGrowX()

            var innerHeight = this.innerHeight()

            each(this.getChildren(), c) {
                var cw = c.minWidth() + ((c.growX.toInt() * unusedWidth.toInt()) / sumGrowX.toInt()).toShort()
                c.layout(x, y, cw.toUShort(), innerHeight.toUShort())
                x = x + cw + this.spacing
            }
        }

        fun innerMinWidth(): Short {
            // Count a `spacing` gap between every adjacent pair of children,
            // i.e. (n-1) gaps. Detect "not the first child" with a flag, NOT
            // `w > 0` — a leading zero-min child (e.g. a growX spacer) leaves
            // w at 0, which would skip the gap after it and under-count the
            // total by one spacing. That made layoutChildren over-estimate the
            // free space and push the trailing children `spacing` px past the
            // right edge (clipped last button / lost right padding).
            var w = 0S
            var first = true
            each(this.getChildren(), c) {
                if (!first) {
                    w = w + this.spacing
                }
                first = false
                w = w + c.minWidth()
            }
            return w
        }

        override fun minWidth(): Short {
            return this.innerMinWidth() + this.padding.left + this.padding.right + this.margin.left + this.margin.right + this.borderWidths.left + this.borderWidths.right
        }

        fun innerMinHeight(): Short {
            var minH = 0S
            each(this.getChildren(), c) {
                var cMinH = c.minHeight()
                if (cMinH > minH) {
                    minH = cMinH
                }
            }
            return minH
        }

        override fun minHeight(): Short {
            return this.innerMinHeight() + this.padding.top + this.padding.bottom + this.margin.top + this.margin.bottom + this.borderWidths.top + this.borderWidths.bottom
        }

        fun sumGrowX(): Short {
            var grow = 0S
            each(this.getChildren(), c) {
                grow = grow + c.growX.toShort()
            }
            if (grow == 0) {
                grow = 1S
            }
            return grow
        }

    }

