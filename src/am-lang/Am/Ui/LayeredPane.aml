namespace Am.Ui
{
    // A ViewGroup whose children are stacked by z-index. Paint walks
    // ascending z (later layers stamp on top); down/up/wheel mouse
    // events walk descending z (topmost gets first crack — first
    // consumer wins). Move events still broadcast across all layers
    // so each can decide whether to clear hover state — same shape
    // ViewGroup uses for siblings.
    //
    // Used as Window's overlay slot so docked sidebar apps and
    // popup menus can co-exist on the same surface: dock panels at
    // a lower z, popups at a higher z, popups always paint on top
    // and absorb clicks before reaching the panel underneath.
    //
    // Layers report their own desired position — LayeredPane lays
    // every child out at (0, 0, paneWidth, paneHeight) and lets the
    // child position any inner content inside that frame. Same
    // convention as OverlayHost (which positions a single AppPanel
    // against an edge inside the host's full-pane bounds).
    class LayeredPane() : ViewGroup {
        import Am.Lang
        import Am.Collections

        // Parallel to `children`. Always sorted ascending; we
        // maintain the invariant by inserting in the right place
        // in addLayer().
        private var zs: List<Int> = new List<Int>()

        // Add `view` at the given z. Higher z = on top. Ties go to
        // the later-added layer (it sits just above same-z views).
        fun addLayer(view: View, z: Int) {
            var idx = this.findInsertIndex(z)
            this.getChildren().insertAt(idx, view)
            this.zs.insertAt(idx, z)
            view.parentView = this
            // Match ViewGroup.addChild's lazy-attach: only fire
            // onAttach when this pane is already attached itself.
            if (this.getViewContext() != null) {
                view.onAttach(this.getViewContext())
            }
            // Tell the freshly-added layer (and its subtree) that
            // it needs to paint on the next cycle. For brand-new
            // layers, View.layout's old-footprint logic would
            // already flag a repaint when bounds transition from
            // 0,0,0,0 to the pane's size — but for *re-mounts* of
            // a singleton overlay (toggled off then back on with
            // unchanged bounds), the layout pass sees no change
            // and skips the dirty fire. Meanwhile the previous
            // remove invalidated peer layers, which overdrew this
            // layer's pixels in the offscreen buffer. Without an
            // explicit repaint here the layer would never paint
            // back in. Tree-wide so the subtree (panel + content)
            // wakes up as well.
            view.requestRepaintTree()
        }

        fun removeLayer(view: View) {
            var n = this.getChildren().getSize()
            var i = 0
            while (i < n) {
                if (this.getChildren().get(i) == view) {
                    // Capture the layer's actual painted rect in
                    // window coords BEFORE detaching, so we can tell
                    // surviving layers what region under them just
                    // became visible. PopupMenu / OverlayHost override
                    // getPaintedBounds to return a precise rect;
                    // default falls back to the full layer area.
                    var paneRect = this.computeWindowRect()
                    var local = view.getPaintedBounds()
                    var winRect = new Rectangle(
                        (paneRect.x + view.x) + local.x,
                        (paneRect.y + view.y) + local.y,
                        local.width,
                        local.height)
                    this.getChildren().removeAt(i)
                    this.zs.removeAt(i)
                    view.parentView = null
                    view.onDetach()
                    // Invalidate every surviving layer's overlap with
                    // the area the removed layer used to cover —
                    // their pixels there are still in the offscreen
                    // buffer but no longer correct (they reflect what
                    // showed UNDER the popup back when it was painted
                    // over them, not the cleared state we want now).
                    var m = this.getChildren().getSize()
                    var j = 0
                    while (j < m) {
                        this.getChildren().get(j).invalidateOverlapping(winRect)
                        j = j + 1
                    }
                    return
                }
                i = i + 1
            }
        }

        // True when `view` is currently mounted as a layer.
        fun containsLayer(view: View): Bool {
            var n = this.getChildren().getSize()
            var i = 0
            while (i < n) {
                if (this.getChildren().get(i) == view) {
                    return true
                }
                i = i + 1
            }
            return false
        }

        // Topmost layer (highest z) — useful for "close the top
        // popup on outside click" loops.
        fun topLayer(): View {
            var n = this.getChildren().getSize()
            if (n == 0) {
                return null
            }
            return this.getChildren().get(n - 1)
        }

        // Walk the parallel zs list to find where a new entry with
        // z=`z` should land so the list stays ascending. Same-z ties
        // go AFTER existing entries so a fresh layer added at the
        // current top z ends up on top.
        private fun findInsertIndex(z: Int): Int {
            var n = this.zs.getSize()
            var i = 0
            while (i < n) {
                if (this.zs.get(i) > z) {
                    return i
                }
                i = i + 1
            }
            return n
        }

        // Every layer gets the full pane area; layers handle their
        // own inner positioning. innerWidth/innerHeight are
        // method-call equivalents — direct `this.width` field
        // access trips the AmLang binder here for reasons we don't
        // fully understand (see TODO).
        override fun layoutChildren() {
            var iw = this.innerWidth().toUShort()
            var ih = this.innerHeight().toUShort()
            each(this.getChildren(), c) {
                c.layout(0S, 0S, iw, ih)
            }
        }

        override fun minWidth(): Short {
            return 0S
        }

        override fun minHeight(): Short {
            return 0S
        }

        // Cross-layer dirty propagation. Called by Window.markDirty
        // for every LayeredPane on the chain from the source view
        // up to the root. We figure out which of OUR layers contains
        // the source (if any), then invalidate every other layer
        // subject to z-order rules:
        //
        //   - Layers strictly above sourceZ always repaint — their
        //     pixels sit on top of the source and must overdraw to
        //     preserve the stack.
        //   - Layers at-or-below sourceZ repaint only when source
        //     is translucent (sourceOpaque == false). An opaque
        //     source fully covers them in `winRect`, so their
        //     pixels there aren't visible.
        //
        // When source isn't a descendant of any layer in this pane
        // (sourceLayer stays null), treat every layer as "above" —
        // we don't know the source's z, so the conservative move
        // is to repaint every overlapping layer.
        override fun propagateDirty(winRect: Rectangle, source: View, sourceOpaque: Bool) {
            // Find the direct layer (one of OUR children) on the
            // path from source upward. May be null if the source
            // isn't a descendant of any layer here (e.g. the
            // source is the pane itself). Recursive helper to
            // dodge amlc's if-assigns-null-inside-while renderer
            // crash.
            var sourceLayer = this.findLayerOnPathFrom(source)

            var sourceZ: Int = 0
            var sourceZKnown: Bool = false
            if (sourceLayer != null) {
                sourceZ = this.findLayerZ(sourceLayer)
                sourceZKnown = true
            }

            var n = this.getChildren().getSize()
            var i = 0
            while (i < n) {
                var layer = this.getChildren().get(i)
                if (layer != sourceLayer) {
                    var z = this.zs.get(i)
                    var higher = true
                    if (sourceZKnown) {
                        higher = z > sourceZ
                    }
                    if (higher || !sourceOpaque) {
                        layer.invalidateOverlapping(winRect)
                    }
                }
                i = i + 1
            }
        }

        // Walk `view`'s parentView chain until we hit a direct
        // child of THIS pane (i.e. `node.parentView == this`).
        // Returns null when the chain runs out without crossing
        // this pane — meaning `view` isn't a descendant of any
        // of our layers. Recursion side-steps the renderer
        // crash we hit on `if (...) { node = null }` inside a
        // while-loop body.
        private fun findLayerOnPathFrom(view: View): View {
            // Iterative walk with a hard depth cap so a stray
            // parentView cycle bails out instead of hanging the
            // whole window. Real UI trees never get close to 256
            // levels deep.
            var v = view
            var safety = 256
            while (v != null && safety > 0) {
                if (v.parentView == this) {
                    return v
                }
                v = v.parentView
                safety = safety - 1
            }
            return null
        }

        // Linear lookup of a layer's z-index. Returns 0 if not
        // found, but callers should have confirmed membership
        // first (see findLayerOnPathFrom).
        private fun findLayerZ(layer: View): Int {
            var n = this.getChildren().getSize()
            var i = 0
            while (i < n) {
                if (this.getChildren().get(i) == layer) {
                    return this.zs.get(i)
                }
                i = i + 1
            }
            return 0
        }

        // Mouse routing: front-to-back, first matching layer wins.
        // For move events the match is geometric (the topmost layer
        // whose painted bounds contain the cursor); for down / up /
        // wheel we just walk topmost-first and stop at the first
        // consumer (OverlayHost gates its own consumption on
        // panel.contains, so a click in the see-through area still
        // falls through to the chrome).
        //
        // Lower layers never see a move once a higher layer claims
        // the cursor. Any hover state they need to clear across
        // layer changes can subscribe to Window.addMouseEventListener
        // — that fires for every move with window-absolute coords,
        // regardless of which layer claimed the dispatch.
        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            if (type == MouseEventType.move) {
                var n = this.getChildren().getSize()
                var i = n - 1
                while (i >= 0) {
                    var c = this.getChildren().get(i)
                    var pb = c.getPaintedBounds()
                    var pbX1 = c.x + pb.x
                    var pbY1 = c.y + pb.y
                    var pbX2 = pbX1 + pb.width.toShort()
                    var pbY2 = pbY1 + pb.height.toShort()
                    if (x >= pbX1 && x < pbX2 && y >= pbY1 && y < pbY2) {
                        return c.onMouseEvent(type, button, x - c.x, y - c.y)
                    }
                    i = i - 1
                }
                return false
            }

            // down / up / wheel: topmost first.
            var n = this.getChildren().getSize()
            var i = n - 1
            while (i >= 0) {
                var c = this.getChildren().get(i)
                var lx = x - c.x
                var ly = y - c.y
                if (c.onMouseEvent(type, button, lx, ly)) {
                    return true
                }
                i = i - 1
            }
            return false
        }
    }
}
