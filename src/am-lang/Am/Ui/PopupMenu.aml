namespace Am.Ui
{
    // A floating context menu. Designed to be mounted as a layer on
    // a LayeredPane (so it sits above any docked sidebar app) at a
    // user-chosen anchor — typically the screen coords of whichever
    // [...] button or right-click triggered it.
    //
    // The PopupMenu fills the entire layer (so it can detect
    // outside-clicks and close itself) but only paints a small
    // rectangle at (anchorX, anchorY). Mouse hit-tests against that
    // rectangle, not the full layer.
    //
    // Step 2 supports a single level — `items[*].action` only.
    // Cascading submenus arrive in step 3; the PopupMenuItem data
    // shape already has a `submenu` slot reserved.
    class PopupMenu() : View {
        import Am.Lang
        import Am.Collections

        private var items: List<PopupMenuItem> = new List<PopupMenuItem>()

        // Where the menu's top-left corner lands. Caller sets these
        // *before* mounting on a LayeredPane; layout() ignores them
        // and just records the full pane size.
        var anchorX: Short = 0S
        var anchorY: Short = 0S

        // Theme. Defaults are the "light-gray panel, dark text"
        // scheme the user picked — themed callers (am-ide's
        // Program) override with their own AppPen indices.
        var backgroundPen: UByte    = 13UB  // textDim — light gray
        var textPen:       UByte    = 4UB   // editorBg — near-black
        var hoverBgPen:    UByte    = 9UB   // accent
        var hoverTextPen:  UByte    = 6UB   // textBright — white
        var borderPen:     UByte    = 12UB  // border — dark gray

        // Vertical / horizontal item insets. Per-row padding is
        // baked into the row height calc; PADDING_X is the gap
        // between the left edge of the popup and the start of the
        // item text.
        private static const PADDING_X: Short = 8S
        private static const PADDING_Y: Short = 4S
        private static const ROW_VPAD: Short  = 2S

        // -1 when no row is hovered.
        private var hoveredIndex: Int = -1

        // Currently-mounted submenu (and the parent row index it
        // belongs to). When the cursor moves to a different row,
        // any open submenu is closed before the new one is opened
        // — so menus cascade on hover, not click, with no manual
        // close needed by the caller.
        private var activeSubmenu: PopupMenu = null
        private var activeSubmenuIdx: Int = -1

        // Pixel gap between an item's label and the trailing ">"
        // submenu marker — kept identical to the left padding so
        // the marker visually mirrors the leading inset.
        private static const SUBMENU_MARKER_GAP: Short = 8S

        // Called when the popup wants to dismiss itself — either
        // because an item fired its action or because the user
        // clicked outside the menu rect. Mounting code wires this
        // to removeLayer() on the LayeredPane.
        var closeListener: () => Bool = null

        fun addItem(item: PopupMenuItem): PopupMenu {
            this.items.add(item)
            return this
        }

        fun getItems(): List<PopupMenuItem> {
            return this.items
        }

        // -------- geometry --------

        fun rowHeight(): Short {
            var f = this.getUsedFont()
            var fh = 12S
            if (f != null) {
                fh = f.getSize().toShort()
            }
            return fh + (PopupMenu.ROW_VPAD * 2S)
        }

        fun getUsedFont(): Font {
            var vc = this.getViewContext()
            if (vc == null) {
                return null
            }
            return vc.getWindow().font
        }

        fun menuWidth(): Short {
            var vc = this.getViewContext()
            if (vc == null) {
                // Fallback when not yet attached — caller almost
                // certainly recomputes after attach.
                return 120S
            }
            var win = vc.getWindow()
            var f = this.getUsedFont()
            var maxW = 0S
            var hasSubmenu = false
            var n = this.items.getSize()
            var i = 0
            while (i < n) {
                var item = this.items.get(i)
                var w = win.calculateStringWidth(f, item.label).toShort()
                if (w > maxW) {
                    maxW = w
                }
                if (item.submenu != null) {
                    hasSubmenu = true
                }
                i = i + 1
            }
            // Add room for the trailing ">" cascade marker if any
            // item in this menu has a submenu — otherwise the
            // marker overlaps the label text. The marker is
            // measured here against the same font drawString picks
            // up at paint, so the geometry matches.
            var markerExtent = 0S
            if (hasSubmenu) {
                var markerW = win.calculateStringWidth(f, ">").toShort()
                markerExtent = PopupMenu.SUBMENU_MARKER_GAP + markerW
            }
            // Padding on both sides, plus 1px border each side.
            return ((maxW + markerExtent) + (PopupMenu.PADDING_X * 2S)) + 2S
        }

        fun menuHeight(): Short {
            var n = this.items.getSize()
            // Borders top + bottom + vertical padding + N row heights.
            return ((this.rowHeight() * n.toShort()) + (PopupMenu.PADDING_Y * 2S)) + 2S
        }

        // True when (lx, ly) sits inside the rendered menu rect.
        // Coords are local to the layer (the LayeredPane gives us
        // the full pane area; the menu only paints a small rect
        // inside that).
        private fun isPointInMenu(lx: Short, ly: Short): Bool {
            var mw = this.menuWidth()
            var mh = this.menuHeight()
            return lx >= this.anchorX && lx < this.anchorX + mw
                && ly >= this.anchorY && ly < this.anchorY + mh
        }

        // Item index for a point inside the menu rect, or -1.
        private fun itemIndexAt(lx: Short, ly: Short): Int {
            if (!this.isPointInMenu(lx, ly)) {
                return -1
            }
            var rh = this.rowHeight()
            // 1px border + PADDING_Y above the first row.
            var startY = (this.anchorY + 1S) + PopupMenu.PADDING_Y
            var rel = ly - startY
            if (rel < 0S) {
                return -1
            }
            var idx = (rel / rh).toInt()
            if (idx < 0 || idx >= this.items.getSize()) {
                return -1
            }
            return idx
        }

        // -------- paint --------

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            var f = this.getUsedFont()
            if (f != null) {
                graphics.setFont(f)
            }

            var mw = this.menuWidth()
            var mh = this.menuHeight()
            var x1 = this.anchorX
            var y1 = this.anchorY
            var x2 = (x1 + mw) - 1S
            var y2 = (y1 + mh) - 1S

            // Background.
            graphics.setForegroundPen(this.backgroundPen)
            graphics.fillRect(x1, y1, x2, y2)

            // 1px border on all four sides.
            graphics.setForegroundPen(this.borderPen)
            graphics.drawLine(x1, y1, x2, y1)
            graphics.drawLine(x1, y2, x2, y2)
            graphics.drawLine(x1, y1, x1, y2)
            graphics.drawLine(x2, y1, x2, y2)

            // Rows.
            var rh = this.rowHeight()
            var rowY = (y1 + 1S) + PopupMenu.PADDING_Y
            var rowX = x1 + 1S
            var rowW = mw - 2S
            var n = this.items.getSize()
            var i = 0
            while (i < n) {
                var item = this.items.get(i)
                var bg = this.backgroundPen
                var fg = this.textPen
                if (i == this.hoveredIndex) {
                    bg = this.hoverBgPen
                    fg = this.hoverTextPen
                    graphics.setForegroundPen(bg)
                    graphics.fillRect(rowX, rowY, (rowX + rowW) - 1S, (rowY + rh) - 1S)
                }
                graphics.setBackgroundPen(bg)
                graphics.setForegroundPen(fg)
                var textX = rowX + PopupMenu.PADDING_X
                var textY = rowY + PopupMenu.ROW_VPAD
                graphics.drawString(item.label, textX, textY)
                // Hint that a submenu is available — a ">" pointer at
                // the right edge of the row, drawn in the same pen
                // as the row text so it picks up the hover-state
                // colour automatically.
                if (item.submenu != null) {
                    var marker = ">"
                    var win = this.getViewContext().getWindow()
                    var markerW = win.calculateStringWidth(this.getUsedFont(), marker).toShort()
                    var markerX = ((rowX + rowW) - PopupMenu.PADDING_X) - markerW
                    graphics.drawString(marker, markerX, textY)
                }
                rowY = rowY + rh
                i = i + 1
            }
        }

        // Open `sub` as a cascading submenu of `this`, replacing
        // whichever submenu was previously open. The parent stays
        // mounted; only the active submenu is swapped.
        //
        // The submenu's closeListener is wired to *both* unmount
        // the submenu AND fire this parent's close — so when the
        // user picks an action item inside the submenu (or
        // outside-clicks while it's open), the whole cascade
        // dismisses, not just the submenu.
        private fun swapToSubmenu(sub: PopupMenu, idx: Int) {
            if (this.activeSubmenu == sub) {
                return
            }
            this.closeActiveSubmenu()
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var win = vc.getWindow()
            sub.anchorX = (this.anchorX + this.menuWidth()) - 1S
            sub.anchorY = ((this.anchorY + 1S) + PopupMenu.PADDING_Y) + (idx.toShort() * this.rowHeight())
            sub.backgroundPen = this.backgroundPen
            sub.textPen       = this.textPen
            sub.hoverBgPen    = this.hoverBgPen
            sub.hoverTextPen  = this.hoverTextPen
            sub.borderPen     = this.borderPen
            var capturedWin    = win
            var capturedSub    = sub
            var capturedParent = this
            sub.closeListener = () => {
                capturedWin.closePopup(capturedSub)
                capturedParent.activeSubmenu = null
                capturedParent.activeSubmenuIdx = -1
                // Cascade the dismissal upward — picking an item
                // in a submenu (or outside-clicking it) should
                // close the entire menu chain, not just the
                // submenu. fireClose hits the parent's listener
                // which the IDE wires to closePopup the parent.
                capturedParent.fireClose()
                return true
            }
            win.openPopup(sub)
            this.activeSubmenu = sub
            this.activeSubmenuIdx = idx
        }

        // "Soft close" — unmount the currently-open submenu without
        // cascading to the parent. Used when the cursor moves to a
        // different parent row and we want to swap submenus (or
        // hide the cascade entirely if the new row has no submenu).
        private fun closeActiveSubmenu() {
            if (this.activeSubmenu == null) {
                return
            }
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var win = vc.getWindow()
            var sub = this.activeSubmenu
            // Wipe the chained closeListener so the upcoming
            // closePopup doesn't fire its body — that body would
            // cascade-close the parent (which is the OPPOSITE of
            // what soft-close means).
            sub.closeListener = null
            win.closePopup(sub)
            this.activeSubmenu = null
            this.activeSubmenuIdx = -1
        }

        // -------- mouse --------

        // The PopupMenu owns its own outside-click-to-close, so we
        // need to see every event that lands in the layer (not just
        // events inside the menu rect). LayeredPane gives us that
        // for free: layout = full pane area, so contains() is true
        // for everything inside the window.
        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            // Move events update hover highlight when over an item,
            // and cascade the open-submenu state:
            //   - cursor over a row with a submenu → open it
            //     (closing whichever submenu was open before, if any)
            //   - cursor over a non-submenu row → close any open
            //     submenu
            //   - cursor outside this menu's items (-1) → leave the
            //     submenu alone, because the cursor may have moved
            //     INTO the submenu and any close here would dismiss
            //     it before the user can interact with it
            if (type == MouseEventType.move) {
                var newHover = this.itemIndexAt(x, y)
                if (newHover != this.hoveredIndex) {
                    this.hoveredIndex = newHover
                    this.requestRepaint()
                    if (newHover >= 0) {
                        var hovered = this.items.get(newHover)
                        if (hovered.submenu != null) {
                            this.swapToSubmenu(hovered.submenu, newHover)
                        } else {
                            this.closeActiveSubmenu()
                        }
                    }
                }
                return false
            }

            if (type == MouseEventType.up && button == MouseButton.left) {
                if (this.isPointInMenu(x, y)) {
                    var idx = this.itemIndexAt(x, y)
                    if (idx >= 0) {
                        var item = this.items.get(idx)
                        // Items with a submenu are pure navigation —
                        // they don't fire actions on click. The
                        // submenu has already been opened by the
                        // hover handler; clicks here are no-ops.
                        if (item.submenu != null) {
                            return true
                        }
                        var act = item.action
                        if (act != null) {
                            act()
                        }
                        this.fireClose()
                    }
                    return true
                }
                // Outside-click on mouse-up: close. Returning true
                // means the click doesn't fall through to whatever's
                // underneath the popup — feels right for menu
                // dismissal (you don't usually want the same click
                // to also activate the thing the menu was sitting
                // over).
                this.fireClose()
                return true
            }
            // down events inside the menu are absorbed too so the
            // underlying view doesn't get partial events.
            if (type == MouseEventType.down && this.isPointInMenu(x, y)) {
                return true
            }
            return false
        }

        private fun fireClose() {
            var cb = this.closeListener
            if (cb != null) {
                cb()
            }
        }
    }
}
