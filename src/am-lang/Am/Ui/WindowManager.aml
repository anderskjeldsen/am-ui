
namespace Am.Ui 
{

    #implementationPlatforms "libc", "amigaos", "amigaos-sim", "morphos-ppc", "macos-arm"
    native class WindowManager {
        import Am.Lang

        private static var instance: WindowManager? = null

        static fun getInstance(): WindowManager {
            if (WindowManager.instance == null) {
                WindowManager.instance = new WindowManager()
            }
            return WindowManager.instance
        }

        
    }
}

