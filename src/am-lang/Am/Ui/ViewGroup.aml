
namespace Am.Ui 
{
    class ViewGroup : View {
        import Am.Lang
        import Am.Collections

        private var children: List<View> = new List<View>()
        
        var font: Font

        fun getChildren(): List<View> {
            return this.children
        }

        fun addChild(view: View) {
            this.children.add(view)
            if (this.getViewContext() != null) {
                view.onAttach(this.getViewContext())
            }
        }

        fun removeChild(view: View) {
            this.children.remove(view)
            view.onDetach()
        }

        fun removeChildren() {
            each(this.children, c) {
                c.onDetach()
            }
            var newList = List<View>.newList<View>()
            this.children = newList
        }

        override fun onAttach(viewContext: ViewContext) {
            base.onAttach(viewContext)
            each(this.children, c) {
                c.onAttach(viewContext)
            }
        }

        override fun onDetach() {
            base.onDetach()
            each(this.children, c) {
                c.onDetach()
            }
        }

        override fun requestRepaintTree() {
            base.requestRepaintTree()
            each(this.children, c) {
                c.requestRepaintTree()
            }
        }

        override fun applyScrollOffset(dy: Short) {
            each(this.children, c) {
                c.y = c.y + dy
            }
        }


        fun paintChildren(graphics: Graphics) {
            each(this.children, c) {
                c.paintAll(graphics)
            }
        }

        override fun paintAll(graphics: Graphics) {
            var b1 = graphics.shouldRepaintAll()
            var b2 = this.getRepaintRequested()

            var ix = this.x + this.margin.left
            var iy = this.y + this.margin.top

            // Set clipping area to this view's bounds (excluding margins)
            var viewWidth = this.width.toShort() - this.margin.left - this.margin.right
            var viewHeight = this.height.toShort() - this.margin.top - this.margin.bottom

            var currentClip = graphics.getCurrentClipRect()
            var viewClipRect: ClipRect = currentClip.createInnerClipRect(ix, iy, viewWidth.toUShort(), viewHeight.toUShort())
            graphics.pushClipRect(viewClipRect)

            if (b1 || b2) {
                graphics.translate(ix, iy)
                this.paint(graphics)
                // Report the inner box as dirty (the area paint() may
                // have touched). Children report their own bounds when
                // walked below.
                this.reportPaintedBounds(graphics, viewWidth, viewHeight)
                graphics.translate(-ix, -iy)
            }
            this.markAsPainted()

            graphics.popClipRect()


            // Always walk children: their paintAll() decides whether they
            // themselves need to repaint. Gating this loop on b1||b2 means
            // a partial repaint requested by a deep descendant never
            // reaches that descendant when its ancestors are clean.
            ix = this.x
            iy = this.y

            viewClipRect = currentClip.createInnerClipRect(ix, iy, this.width, this.height)
            graphics.pushClipRect(viewClipRect)

            graphics.translate(ix, iy)
            this.paintChildren(graphics)
            graphics.translate(-ix, -iy)

            graphics.popClipRect()
        }

        open fun layoutChildren() {
            each(this.children, c) {
                // Do nothing
            }
        }

        override fun layout(x: Short, y: Short, width: UShort, height: UShort) {
            base.layout(x, y, width, height)
            this.layoutChildren()
        }

        override fun findViewAt(x: Short, y: Short): View {
            if (this.contains(x, y)) {
                each(this.children, c) {
                    var lx = x - c.x
                    var ly = y - c.y

                    var v = c.findViewAt(lx, ly)
                    if (v != null) {
                        return v
                    }
                }
                return this
            }
            return null
        }

        // Walk children when the cursor sits inside this group. First
        // child that consumes wins. We gate on `contains` so wheel
        // ticks in empty padding around a group don't get absorbed
        // by an unrelated child further down the chain.
        override fun onMouseWheel(deltaY: Short, x: Short, y: Short): Bool {
            if (!this.contains(x, y)) {
                return false
            }
            each(this.children, c) {
                var lx = x - c.x
                var ly = y - c.y
                if (c.onMouseWheel(deltaY, lx, ly)) {
                    return true
                }
            }
            return false
        }

        override fun onKeyboardEvent(type: KeyboardEventType, keyCode: UShort, keyChar: UShort): Bool {
            each(this.children, c) {
                var consumed = c.onKeyboardEvent(type, keyCode, keyChar)
                if (consumed) {
                    return consumed
                }
            }
            return false
        }


        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            // Mouse-move broadcasts to every child regardless of this
            // group's contains() result, and regardless of whether an
            // earlier child consumed the event. Children rely on
            // receiving moves to detect "cursor just left me" — that's
            // how scrollbar / button hover state clears when the cursor
            // slides off into a sibling. Short-circuiting on the first
            // consumer would leave later children visually latched.
            if (type == MouseEventType.move) {
                var anyConsumed = false
                each(this.children, c) {
                    var lx = x - c.x
                    var ly = y - c.y
                    if (c.onMouseEvent(type, button, lx, ly)) {
                        anyConsumed = true
                    }
                }
                return anyConsumed
            }

            // Mouse-up always propagates to children regardless of
            // this group's own contains() result so that any descendant
            // currently holding a drag (ScrollView thumb, SplitterView,
            // etc.) gets a chance to clear its drag state when the user
            // releases the button outside the group's bounds. Without
            // this, a drag started in the sidebar but released over the
            // editor would never see the up event and the dragging
            // flag would stay latched on — leading to "the scrollbar
            // keeps following my mouse after I let go".
            if (this.contains(x, y) || type == MouseEventType.up) {
                each(this.children, c) {
                    var lx = x - c.x
                    var ly = y - c.y

                    var consumed = c.onMouseEvent(type, button, lx, ly)
                    if (consumed) {
                        return consumed
                    }
                }
            }
            return false
        }

        fun setupGroup(i: (it: ViewGroup) => ViewGroup) : ViewGroup {
            i(this)
            return this
        }
    }

}

