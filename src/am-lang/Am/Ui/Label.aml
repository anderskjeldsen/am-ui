
namespace Am.Ui 
{

    class Label(var text: String) : View {
        import Am.Lang

        var font: Font? = null
        var backgroundPen: UByte = 0UB
        var textPen: UByte = 1UB
        // Color overrides for the bg / text pens. Non-null wins.
        // Buttons propagate their resolved bg / text choice into the
        // private Label inside them via these fields so the glyph
        // sits on the right backdrop.
        var backgroundColor: UInt? = null
        var textColor: UInt?       = null
        // Layout flex controls (used by the status-bar footer):
        //
        //  shrinkable — this label yields space in a growX row. minWidth()
        //    reports only a small floor (an ellipsis-worth) so an HStack
        //    can hand it LESS than its full text width, and paint()
        //    truncates the rendered text with "..." to whatever width it
        //    actually got. Used for the branch/file label so a long path
        //    can't push the fixed status elements (tabs, Ln/Col) off the
        //    row.
        //
        //  minContentWidth — a floor (in px) on the text portion of
        //    minWidth(). Lets a label RESERVE a fixed width for its
        //    worst-case text (e.g. "Ln 99999, Col 9999") so its size
        //    doesn't change as the text grows/shrinks — no re-flow of the
        //    row, and the text never clips. Ignored when shrinkable.
        var shrinkable: Bool = false
        var minContentWidth: Short = 0S
        // Mouse-over support. Set hoverEnabled = true and pick a contrasting
        // bg pen to get the row to fill itself with that pen while the
        // mouse is over it. Disabled by default so plain Labels keep
        // their original transparent rendering.
        var hoverEnabled: Bool = false
        var hoverBackgroundPen: UByte = 0UB
        // Color override for the hover bg fill. Non-null wins.
        var hoverBackgroundColor: UInt? = null
        private var hovered: Bool = false

        // Optional trailing affordance — when set, this string is
        // painted at the right edge of the label whenever the mouse
        // is over the row, and clicking it fires
        // `trailingClickListener` instead of the regular
        // `clickListener`. Used by the folder tree for the per-row
        // [...] context-menu glyph; null on every other Label so
        // nothing changes for existing call sites.
        var trailingGlyph: String? = null
        var trailingPen: UByte = 1UB
        var trailingClickListener: ((view: View) => Bool)? = null

        // Optional: when set, paint THIS bitmap at the trailing slot
        // instead of `trailingGlyph` (still gated on hover; same hit
        // zone). Used by the IDE's icon-strip affordances — Git
        // sidebar's "+" comes from assets/icons.png so the row reads
        // as a clickable icon rather than an ASCII glyph. Width is
        // taken from the bitmap; height from the label's text height
        // so the icon is squashed/stretched as needed to align with
        // the baseline. Null → fall back to trailingGlyph.
        var trailingBitmap: Bitmap? = null

        // Extra pixel padding between the trailing affordance and
        // the row's right edge. Without it, the [...] / icon sits
        // flush against the scrollbar / sidebar border which reads
        // as cramped. The hit-test area still extends to the right
        // edge so a click past the visible icon still triggers it.
        var trailingRightPad: Short = 0S

        // When non-zero, paint a coloured bg under the trailing
        // affordance whenever the cursor is over that affordance
        // specifically (NOT just over the row). Reads as a hover
        // affordance on the icon, distinct from the row's own
        // hoverBackgroundPen.
        var trailingHoverBackgroundPen: UByte = 0UB
        // Padding around the trailing hover bg rectangle — a couple
        // of pixels on each side so the bg breathes a little past
        // the icon's literal glyph bounds.
        var trailingHoverBackgroundPad: Short = 2S

        // True while the cursor sits inside the trailing slot. Set
        // from onMouseEvent's move case; read by paint() to decide
        // whether to draw the trailing hover bg.
        private var trailingHovered: Bool = false

        // Optional SECOND hover-only affordance, painted just to the
        // left of `trailingGlyph` with the same BADGE_GAP separator.
        // Lets a row carry two distinct hover actions — Git sidebar
        // uses this for "+" (stage) + "I" (ignore) on untracked rows.
        // Same hover gating + click semantics as trailingGlyph; its
        // hit zone runs from the secondary glyph's left edge up to
        // the primary trailing glyph's left edge, so a click on the
        // primary still fires that one and not this one.
        var secondaryTrailingGlyph: String? = null
        var secondaryTrailingPen: UByte = 1UB
        var secondaryTrailingClickListener: ((view: View) => Bool)? = null
        // Bitmap variant of the secondary trailing affordance, mirroring
        // `trailingBitmap` for the primary slot. When set it takes
        // precedence over `secondaryTrailingGlyph` for both paint and
        // hit-testing. Git sidebar uses this for the "-" (discard) icon
        // on tracked rows.
        var secondaryTrailingBitmap: Bitmap? = null

        // Always-visible badge glyph painted at the far right of the
        // row (further right than `trailingGlyph`, which only paints
        // on hover). Used by the Git sidebar for the per-row "U"
        // (untracked) tag that should be readable without a hover.
        // The hover-only trailingGlyph sits just to the left of the
        // badge when both are configured.
        var badgeGlyph: String? = null
        var badgePen: UByte = 1UB
        // Pixel gap between the badge and the hover-only trailing
        // glyph (so the two don't visually merge into one blob).
        private static const BADGE_GAP: Short = 4S

        // Optional leading affordance — when set, this string paints
        // at the left edge of the label *always* (no hover gating),
        // pushing the regular `text` to the right by the glyph's
        // width plus a small gap. Used by the folder tree to mark
        // git-repo rows with a clickable "G" before the folder name.
        // Clicking the leading glyph fires `leadingClickListener`
        // instead of the row-wide click.
        var leadingGlyph: String? = null
        var leadingPen: UByte = 1UB
        var leadingClickListener: ((view: View) => Bool)? = null
        // Pixels of gap between the leading glyph and the regular text.
        var leadingGap: Short = 4S

        // Optional bitmap variant of the leading affordance. When set,
        // paints at the row's left edge BEFORE `leadingGlyph` so the
        // visual order is: leadingBitmap (icon), leadingGlyph (text
        // affordance), text. Same always-visible / click-independent
        // semantics as leadingGlyph; pen-tinted glyphs and a bitmap
        // can coexist when both are set (e.g. folder-tree row: chevron
        // bitmap + git-repo "G" glyph + folder name).
        var leadingBitmap: Bitmap? = null
        var leadingBitmapClickListener: ((view: View) => Bool)? = null

        fun getUsedFont(): Font? {
            if (this.font != null) {
                return this.font
            }
            var vc = this.getViewContext() 
            if (vc != null) {
                return vc.getWindow().font
            }
            return null
        }

        override fun minHeight(): Short {
            var font = this.getUsedFont()
            var textH = 0S
            if (font != null) {
                textH = font.getSize().toShort()
            } else {
                var vc = this.getViewContext()
                if (vc != null) {
                    var win = vc.getWindow()
                    textH = win.getCurrentFontSize().toShort()
                }
            }
            // Text is set but neither the label's font nor the
            // window's current font is resolvable yet (view built
            // detached — JSON-list row inside FormBuilder, deferred
            // mount, etc). Return a sensible glyph-height floor so
            // the enclosing VStack doesn't collapse this label to a
            // zero-height slot and stack the next sibling on top of
            // our glyphs. 8 px matches the Topaz/8 line height used
            // as the platform default when no other font is loaded.
            if (textH <= 0S && this.text != null && this.text.length() > 0UI) {
                textH = 8S
            }
            // Reserve room for a trailing bitmap if one is set, even
            // when it's hover-only painted — without this the row
            // collapses to text height and the bitmap clips against
            // the row below.
            if (this.trailingBitmap != null) {
                var bh = this.trailingBitmap.height.toShort()
                if (bh > textH) {
                    textH = bh
                }
            }
            // Same story for the always-visible leading bitmap.
            if (this.leadingBitmap != null) {
                var lbh = this.leadingBitmap.height.toShort()
                if (lbh > textH) {
                    textH = lbh
                }
            }
            return textH + this.padding.top + this.padding.bottom + this.margin.top + this.margin.bottom + this.borderWidths.top + this.borderWidths.bottom
        }

        override fun minWidth(): Short {
            var font = this.getUsedFont()
            var win = this.getViewContext().getWindow()
            // Shrinkable labels report only an ellipsis-worth so a
            // growX row can squeeze them; paint() truncates to fit.
            var textW: Short = 0S
            if (this.shrinkable) {
                textW = win.calculateStringWidth(font, "...").toShort()
            } else {
                textW = win.calculateStringWidth(font, this.text).toShort()
                // Reserve a fixed width for the worst-case text so the
                // label doesn't re-flow (or clip) as the text changes.
                if (textW < this.minContentWidth) {
                    textW = this.minContentWidth
                }
            }
            var leadW = 0S
            if (this.leadingBitmap != null) {
                leadW = leadW + this.leadingBitmap.width.toShort() + this.leadingGap
            }
            if (this.leadingGlyph != null) {
                leadW = leadW + win.calculateStringWidth(font, this.leadingGlyph).toShort() + this.leadingGap
            }
            // Match minHeight: report the full bounding box so HStack
            // layout actually reserves room for horizontal padding /
            // margin / border. Without this, the text draws at
            // x = padding.left but the label's width = textW, so any
            // glyph past textW is clipped — a Label with padding
            // wider than its glyph (e.g. an icon button) renders
            // invisible until you hover it (the hover bg is anchored
            // at x=0 and is visible up to the clipped width).
            return textW + leadW + this.padding.left + this.padding.right + this.margin.left + this.margin.right + this.borderWidths.left + this.borderWidths.right
        }

        // Truncate `s` with a trailing "..." so it fits within `avail`
        // pixels using the graphics' current font (paint() sets it just
        // above). Returns `s` unchanged when it already fits. Mirrors
        // TabView.truncateLabel; only used on shrinkable labels.
        private fun truncateToWidth(graphics: Graphics, s: String, avail: Short): String {
            if (s.isEmpty() || avail <= 0S) {
                return s
            }
            var fullW = graphics.calculateStringWidth(s).toShort()
            if (fullW <= avail) {
                return s
            }
            var ellipsis = "..."
            var elW = graphics.calculateStringWidth(ellipsis).toShort()
            if (elW >= avail) {
                return ellipsis
            }
            var budget = avail - elW
            var len = s.getLength()
            var lastFit = 0
            var i = 1
            while (i <= len) {
                var prefix = s.substring(0UI, i.toUInt())
                var w = graphics.calculateStringWidth(prefix).toShort()
                if (w > budget) {
                    break
                }
                lastFit = i
                i = i + 1
            }
            if (lastFit == 0) {
                return ellipsis
            }
            return s.substring(0UI, lastFit.toUInt()) + ellipsis
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            var bgPen = this.backgroundPen
            // bgColor stays null until something explicitly sets it
            // (resting or hover-with-color). We deliberately avoid
            // re-assigning null on the hover-pen branch — amlc
            // rejects `local = null` on a nullable-primitive local —
            // so the pen branch flips a useColor flag instead.
            var bgColor = this.backgroundColor
            var useColor = bgColor != null
            if (this.hoverEnabled && this.hovered) {
                var hbc: UInt? = this.hoverBackgroundColor
                if (hbc != null) {
                    bgColor = hbc
                    useColor = true
                } else {
                    bgPen = this.hoverBackgroundPen
                    useColor = false
                }
            }
            // When hover is in play, always paint the whole row's bg — on
            // an un-hover frame this is what wipes the previous hover
            // colour. Plain labels keep their original transparent
            // rendering when hover is disabled. The bg covers the full
            // label rect (including any vertical padding) so the hover
            // colour reads as a padded row, not a tight strip behind
            // the glyphs.
            //
            // Also paint when a backgroundColor was set explicitly
            // (e.g. propagated from a Button parent) — without this,
            // a Label sitting alone on a transparent parent would
            // ignore the color override.
            if (this.hoverEnabled || useColor) {
                var x2 = this.width.toShort() - 1S
                var y2 = this.height.toShort() - 1S
                if (useColor && bgColor != null) {

                    graphics.setForegroundColor(bgColor as UInt)
                } else {
                    graphics.setForegroundPen(bgPen)
                }
                graphics.fillRect(0S, 0S, x2, y2)
            }

            graphics.setBackgroundPen(bgPen)
            graphics.setForegroundPen(this.textPen)
            var font = this.getUsedFont()
            if (font != null) {
                graphics.setFont(font)
            }

            // Text sits inside the padding so vertical padding pushes
            // the glyphs down off the top edge — gives the hover bg
            // its visible breathing room above + below the text.
            // NOTE: paint-local (0,0) is the border box — paintAll
            // already translated past the margin — so margin must NOT
            // be re-added here (it double-counted and pushed glyphs
            // toward/past the clip's bottom-right).
            var textX = this.borderWidths.left + this.padding.left
            var textY = this.borderWidths.top + this.padding.top

            // Leading bitmap (always visible, sits at the very left
            // edge before any text glyph). When both bitmap and glyph
            // are set the bitmap paints first and the glyph paints
            // immediately after, then the text. Folder-tree rows use
            // this slot for the expand/collapse chevron with the git-
            // repo "G" coexisting in `leadingGlyph`.
            if (this.leadingBitmap != null) {
                var lbw = this.leadingBitmap.width.toShort()
                var lbh = this.leadingBitmap.height.toShort()
                // Centre the icon vertically in the row's content box rather
                // than top-aligning it with the text — a small (8/12 px) icon
                // top-aligned in a taller row reads as floating high. Centre
                // within (height - margins - borders) so it sits on the row's
                // visual middle next to the text.
                // height is the outer box, so margins come OUT of the
                // content height — but the icon's y starts at the
                // border box (post-margin paint origin), no margin.top.
                var contentH = this.height.toShort() - this.margin.top - this.margin.bottom - this.borderWidths.top - this.borderWidths.bottom
                var iconY = this.borderWidths.top + (contentH - lbh) / 2S
                graphics.drawBitmap(this.leadingBitmap, textX, iconY, lbw, lbh)
                textX = textX + lbw + this.leadingGap
            }

            // Leading glyph (always visible). Painted first; text
            // shifts right by the glyph width + gap.
            if (this.leadingGlyph != null) {
                graphics.setForegroundPen(this.leadingPen)
                graphics.drawString(this.leadingGlyph, textX, textY)
                var leadW = graphics.calculateStringWidth(this.leadingGlyph).toShort()
                textX = textX + leadW + this.leadingGap
                graphics.setForegroundPen(this.textPen)
            }

            if (this.shrinkable) {
                // Fit the text into whatever width the row actually gave
                // us, with a trailing "..." — (0,0) here is the border
                // box (paintAll already translated past the margin), so
                // the text's right limit excludes only the right border
                // + padding.
                var borderBoxW = this.width.toShort() - (this.margin.left + this.margin.right)
                var rightLimit = borderBoxW - (this.borderWidths.right + this.padding.right)
                var avail = rightLimit - textX
                var fitted = this.truncateToWidth(graphics, this.text, avail)
                graphics.drawString(fitted, textX, textY)
            } else {
                graphics.drawString(this.text, textX, textY)
            }

            // Always-visible badge at the far right (e.g. "U" for
            // untracked rows). Painted before the hover trailing
            // glyph so trailingGlyphX can compute its slot against
            // the badge's left edge.
            if (this.badgeGlyph != null) {
                var bx = this.badgeGlyphX(graphics)
                graphics.setForegroundPen(this.badgePen)
                graphics.drawString(this.badgeGlyph, bx, textY)
            }

            // Trailing affordance — only when the row is hovered.
            // Painted *after* the text so it sits on top of any
            // glyph the title would otherwise have written into the
            // right edge of the row. When a badge is also present,
            // the trailing glyph sits just to its left with a small
            // gap (BADGE_GAP).
            // Bitmap variant takes precedence over the text glyph. Same
            // hit-zone math, same hover gating; consumers either set
            // the bitmap OR the glyph for any given Label.
            if (this.hovered && this.trailingBitmap != null) {
                var btx = this.trailingGlyphX(graphics)
                var bw = this.trailingBitmap.width.toShort()
                var bh = this.trailingBitmap.height.toShort()
                // Centre vertically in the row, same as the leading bitmap.
                var tContentH = this.height.toShort() - this.margin.top - this.margin.bottom - this.borderWidths.top - this.borderWidths.bottom
                var btY = this.borderWidths.top + (tContentH - bh) / 2S
                if (this.trailingHovered && this.trailingHoverBackgroundPen != 0UB) {
                    var pad = this.trailingHoverBackgroundPad
                    graphics.setForegroundPen(this.trailingHoverBackgroundPen)
                    graphics.fillRect(btx - pad, btY - pad, btx + bw - 1S + pad, btY + bh - 1S + pad)
                }
                graphics.drawBitmap(this.trailingBitmap, btx, btY, bw, bh)
            } else if (this.hovered && this.trailingGlyph != null) {
                var tx = this.trailingGlyphX(graphics)
                if (this.trailingHovered && this.trailingHoverBackgroundPen != 0UB) {
                    var pad = this.trailingHoverBackgroundPad
                    var gw = graphics.calculateStringWidth(this.trailingGlyph).toShort()
                    var fh = graphics.getCurrentFontSize().toShort()
                    graphics.setForegroundPen(this.trailingHoverBackgroundPen)
                    graphics.fillRect(tx - pad, textY - fh + 2S, tx + gw - 1S + pad, textY + pad)
                }
                graphics.setForegroundPen(this.trailingPen)
                graphics.drawString(this.trailingGlyph, tx, textY)
            }
            if (this.hovered && this.secondaryTrailingBitmap != null) {
                var sbx = this.secondaryTrailingGlyphX(graphics)
                var sbw = this.secondaryTrailingBitmap.width.toShort()
                var sbh = this.secondaryTrailingBitmap.height.toShort()
                var sContentH = this.height.toShort() - this.margin.top - this.margin.bottom - this.borderWidths.top - this.borderWidths.bottom
                var sbY = this.borderWidths.top + (sContentH - sbh) / 2S
                graphics.drawBitmap(this.secondaryTrailingBitmap, sbx, sbY, sbw, sbh)
            } else if (this.hovered && this.secondaryTrailingGlyph != null) {
                var sx = this.secondaryTrailingGlyphX(graphics)
                graphics.setForegroundPen(this.secondaryTrailingPen)
                graphics.drawString(this.secondaryTrailingGlyph, sx, textY)
            }
        }

        // X coordinate where the secondary trailing glyph starts.
        // Sits just to the LEFT of the primary trailing slot with a
        // BADGE_GAP between the two so they don't blur into one blob.
        // Returns -1 when there's no secondary glyph configured.
        private fun secondaryTrailingGlyphX(graphics: Graphics): Short {
            if (this.secondaryTrailingGlyph == null && this.secondaryTrailingBitmap == null) {
                return -1S
            }
            // Bitmap width wins when a bitmap is set (paint prefers it).
            var secW: Short = 0S
            if (this.secondaryTrailingBitmap != null) {
                secW = this.secondaryTrailingBitmap.width.toShort()
            } else {
                secW = graphics.calculateStringWidth(this.secondaryTrailingGlyph).toShort()
            }
            var primaryX = this.trailingGlyphX(graphics)
            if (primaryX < 0S) {
                // No primary trailing — secondary takes its slot.
                // Paint-space: local (0,0) is the border box (paintAll
                // consumed the margin), so BOTH margins come off the
                // outer width before the border/padding inset.
                var rightInset = this.margin.left + this.margin.right + this.borderWidths.right + this.padding.right
                var rightEdge = this.width.toShort() - rightInset
                if (this.badgeGlyph != null) {
                    var badgeW = graphics.calculateStringWidth(this.badgeGlyph).toShort()
                    rightEdge = (rightEdge - badgeW) - Label.BADGE_GAP
                }
                return (rightEdge - this.trailingRightPad) - secW
            }
            return (primaryX - Label.BADGE_GAP) - secW
        }

        // Mouse-side mirror of secondaryTrailingGlyphX. Routes through
        // Window.calculateStringWidth like the other …FromWindow
        // helpers so onMouseEvent can hit-test without a Graphics in
        // hand.
        private fun secondaryTrailingGlyphXFromWindow(): Short {
            if (this.secondaryTrailingGlyph == null && this.secondaryTrailingBitmap == null) {
                return -1S
            }
            var vc = this.getViewContext()
            if (vc == null) {
                return -1S
            }
            var win = vc.getWindow()
            var f = this.getUsedFont()
            var secW: Short = 0S
            if (this.secondaryTrailingBitmap != null) {
                secW = this.secondaryTrailingBitmap.width.toShort()
            } else {
                secW = win.calculateStringWidth(f, this.secondaryTrailingGlyph).toShort()
            }
            var primaryX = this.trailingGlyphXFromWindow()
            if (primaryX < 0S) {
                var rightInset = this.margin.right + this.borderWidths.right + this.padding.right
                var rightEdge = this.width.toShort() - rightInset
                if (this.badgeGlyph != null) {
                    var badgeW = win.calculateStringWidth(f, this.badgeGlyph).toShort()
                    rightEdge = (rightEdge - badgeW) - Label.BADGE_GAP
                }
                return (rightEdge - this.trailingRightPad) - secW
            }
            return (primaryX - Label.BADGE_GAP) - secW
        }

        // X coordinate where the leading glyph ENDS (the click zone
        // extends from textX up to this value). Mirrors trailing's
        // window-side helper.
        private fun leadingGlyphRightX(): Short {
            if (this.leadingGlyph == null) {
                return -1S
            }
            var vc = this.getViewContext()
            if (vc == null) {
                return -1S
            }
            var leftInset = this.margin.left + this.borderWidths.left + this.padding.left
            // Glyph starts after the bitmap (and bitmap-to-glyph gap)
            // when a bitmap is also configured. Match paint().
            if (this.leadingBitmap != null) {
                leftInset = leftInset + this.leadingBitmap.width.toShort() + this.leadingGap
            }
            var glyphW = vc.getWindow().calculateStringWidth(this.getUsedFont(), this.leadingGlyph).toShort()
            return leftInset + glyphW
        }

        // Right edge of the leading bitmap's hit zone. -1 when no
        // bitmap is configured. Hit zone is [leftInset, this value].
        private fun leadingBitmapRightX(): Short {
            if (this.leadingBitmap == null) {
                return -1S
            }
            var leftInset = this.margin.left + this.borderWidths.left + this.padding.left
            return leftInset + this.leadingBitmap.width.toShort()
        }

        // X coordinate where the badge glyph starts (always painted
        // when set, sits flush against the row's right inset).
        // Returns -1 when there's no badge configured.
        private fun badgeGlyphX(graphics: Graphics): Short {
            if (this.badgeGlyph == null) {
                return -1S
            }
            var glyphW = graphics.calculateStringWidth(this.badgeGlyph).toShort()
            // Paint-space (border-box origin): both margins come off
            // the outer width. The FromWindow twin keeps the single
            // margin.right — event coords are outer-box relative.
            var rightInset = this.margin.left + this.margin.right + this.borderWidths.right + this.padding.right
            return (this.width.toShort() - rightInset) - glyphW
        }

        // Mouse-side version of badgeGlyphX. Mirrors trailing's
        // window-based helper so onMouseEvent can hit-test without
        // a Graphics handle.
        private fun badgeGlyphXFromWindow(): Short {
            if (this.badgeGlyph == null) {
                return -1S
            }
            var vc = this.getViewContext()
            if (vc == null) {
                return -1S
            }
            var glyphW = vc.getWindow().calculateStringWidth(this.getUsedFont(), this.badgeGlyph).toShort()
            var rightInset = this.margin.right + this.borderWidths.right + this.padding.right
            return (this.width.toShort() - rightInset) - glyphW
        }

        // X coordinate where the trailing glyph starts. Pulled out of
        // paint() so onMouseEvent can hit-test against the same value
        // without re-deriving it. When a badge is also configured,
        // the trailing slot shifts left of the badge by BADGE_GAP +
        // badge width — keeps the two glyphs from overlapping.
        // Returns -1 when there's no glyph configured.
        private fun trailingGlyphX(graphics: Graphics): Short {
            if (this.trailingGlyph == null && this.trailingBitmap == null) {
                return -1S
            }
            var glyphW: Short = 0S
            if (this.trailingBitmap != null) {
                glyphW = this.trailingBitmap.width.toShort()
            } else {
                glyphW = graphics.calculateStringWidth(this.trailingGlyph).toShort()
            }
            // Paint-space (border-box origin): both margins come off
            // the outer width; see badgeGlyphX.
            var rightInset = this.margin.left + this.margin.right + this.borderWidths.right + this.padding.right
            var rightEdge = this.width.toShort() - rightInset
            if (this.badgeGlyph != null) {
                var badgeW = graphics.calculateStringWidth(this.badgeGlyph).toShort()
                rightEdge = (rightEdge - badgeW) - Label.BADGE_GAP
            }
            // Pull the slot left by the trailingRightPad so the icon
            // doesn't sit flush against the row's right edge.
            return (rightEdge - this.trailingRightPad) - glyphW
        }

        // Mouse-side version — onMouseEvent doesn't have Graphics in
        // hand, so it goes via Window.calculateStringWidth (uses the
        // same font drawString picks up at paint time).
        private fun trailingGlyphXFromWindow(): Short {
            if (this.trailingGlyph == null && this.trailingBitmap == null) {
                return -1S
            }
            var vc = this.getViewContext()
            if (vc == null) {
                return -1S
            }
            var win = vc.getWindow()
            var f = this.getUsedFont()
            var glyphW: Short = 0S
            if (this.trailingBitmap != null) {
                glyphW = this.trailingBitmap.width.toShort()
            } else {
                glyphW = win.calculateStringWidth(f, this.trailingGlyph).toShort()
            }
            var rightInset = this.margin.right + this.borderWidths.right + this.padding.right
            var rightEdge = this.width.toShort() - rightInset
            if (this.badgeGlyph != null) {
                var badgeW = win.calculateStringWidth(f, this.badgeGlyph).toShort()
                rightEdge = (rightEdge - badgeW) - Label.BADGE_GAP
            }
            return (rightEdge - this.trailingRightPad) - glyphW
        }

        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            if (type == MouseEventType.move) {
                if (this.hoverEnabled) {
                    var inside = this.contains(x, y)
                    if (inside != this.hovered) {
                        this.hovered = inside
                        this.requestRepaint()
                    }
                    // Trailing-slot hover state — drives the
                    // trailingHoverBackgroundPen paint above.
                    // Only checked when the row is hovered AND a
                    // trailing affordance is configured; otherwise
                    // it stays false so the bg is never painted.
                    var newTrailing = false
                    if (inside && (this.trailingGlyph != null || this.trailingBitmap != null)) {
                        var tx = this.trailingGlyphXFromWindow()
                        if (tx >= 0S && x >= tx) {
                            var tRight = this.width.toShort()
                            if (this.badgeGlyph != null) {
                                var bx = this.badgeGlyphXFromWindow()
                                if (bx >= 0S) { tRight = bx }
                            }
                            if (x < tRight) { newTrailing = true }
                        }
                    }
                    if (newTrailing != this.trailingHovered) {
                        this.trailingHovered = newTrailing
                        this.requestRepaint()
                    }
                }
                // Return false so sibling labels also see the move event
                // and can clear their own hover state.
                return false
            }
            // Trailing-affordance click intercept — left-mouse-up that
            // lands at or past where the [...] glyph is drawn fires
            // trailingClickListener instead of the row-wide
            // clickListener. The trailing area is only "live" when
            // the row is hovered, matching the visual state (we
            // don't paint the glyph otherwise so a click that
            // misses the visible glyph shouldn't get the trailing
            // behaviour).
            if (type == MouseEventType.up && button == MouseButton.left && this.contains(x, y)) {
                if (this.hovered && (this.trailingGlyph != null || this.trailingBitmap != null)) {
                    var tx = this.trailingGlyphXFromWindow()
                    // Right edge of the trailing click area: if a
                    // badge is configured, the click area stops at
                    // the badge's left edge so clicks on the badge
                    // glyph itself don't fire the trailing action.
                    // Otherwise the area extends to the row's right.
                    var tRight = this.width.toShort()
                    if (this.badgeGlyph != null) {
                        var bx = this.badgeGlyphXFromWindow()
                        if (bx >= 0S) {
                            tRight = bx
                        }
                    }
                    if (tx >= 0S && x >= tx && x < tRight) {
                        var tcb = this.trailingClickListener
                        if (tcb != null) {
                            return tcb(this)
                        }
                        return true
                    }
                }
                // Secondary trailing — same gating as the primary,
                // hit zone is from this glyph's x up to the primary
                // trailing glyph's x (so a click on the primary still
                // routes to the primary).
                if (this.hovered && (this.secondaryTrailingGlyph != null || this.secondaryTrailingBitmap != null)) {
                    var sx = this.secondaryTrailingGlyphXFromWindow()
                    var sRight = this.trailingGlyphXFromWindow()
                    if (sRight < 0S) {
                        sRight = this.width.toShort()
                        if (this.badgeGlyph != null) {
                            var bx2 = this.badgeGlyphXFromWindow()
                            if (bx2 >= 0S) {
                                sRight = bx2
                            }
                        }
                    }
                    if (sx >= 0S && x >= sx && x < sRight) {
                        var scb = this.secondaryTrailingClickListener
                        if (scb != null) {
                            return scb(this)
                        }
                        return true
                    }
                }
                // Leading-bitmap click — independent of hover state.
                // Checked first so it can win when the icon sits at
                // the very left edge of the row; leading-glyph hit
                // zone starts past the bitmap (leadingGlyphRightX
                // honours the bitmap offset).
                if (this.leadingBitmap != null) {
                    var lbx2 = this.leadingBitmapRightX()
                    var lbLeft = this.margin.left + this.borderWidths.left + this.padding.left
                    if (lbx2 >= 0S && x >= lbLeft && x <= lbx2) {
                        var lbcb = this.leadingBitmapClickListener
                        if (lbcb != null) {
                            return lbcb(this)
                        }
                        /* No listener — fall through so the regular
                         * row clickListener still fires. */
                    }
                }
                // Leading glyph click — independent of hover state.
                if (this.leadingGlyph != null) {
                    var lx2 = this.leadingGlyphRightX()
                    var leftInset = this.margin.left + this.borderWidths.left + this.padding.left
                    if (this.leadingBitmap != null) {
                        leftInset = leftInset + this.leadingBitmap.width.toShort() + this.leadingGap
                    }
                    if (lx2 >= 0S && x >= leftInset && x <= lx2) {
                        var lcb = this.leadingClickListener
                        if (lcb != null) {
                            return lcb(this)
                        }
                    }
                }
            }
            return base.onMouseEvent(type, button, x, y)
        }
    }


}

