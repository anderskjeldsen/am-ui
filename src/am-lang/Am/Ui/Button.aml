
namespace Am.Ui 
{

    class Button(var text: String, var buttonClickListener: (view: View) => Bool) : View {
        import Am.Lang

        private var label: Label? = null
        private var active: Bool
        private var hovered: Bool

        // Theme knobs — defaults preserve the old hardcoded look so
        // existing callers don't change. The Label inside is created
        // lazily and its pens are reapplied every paint so changing
        // these vars after construction is honoured.
        var backgroundPen: UByte       = 0UB
        var activeBackgroundPen: UByte = 3UB
        var textPen: UByte             = 1UB

        // Color-flavoured overrides for the pen knobs above. When a
        // color field is non-null it wins over the matching pen —
        // paint() calls graphics.setForegroundColor(argb) instead of
        // setForegroundPen. The defaults are null so existing pen-
        // configured callers render unchanged; the FormBuilder XML
        // attribute path (M1 of the styling work) wires these from
        // `backgroundColor="#RRGGBB"`-style attrs.
        var backgroundColor: UInt?       = null
        var activeBackgroundColor: UInt? = null
        var textColor: UInt?             = null
        // hoverBackgroundColor is treated as an enable signal on its
        // own — when non-null the hover fill always uses it, so a
        // caller doesn't have to set both hoverBackgroundPenEnabled
        // and hoverBackgroundPen just to pick a hover colour.
        var hoverBackgroundColor: UInt? = null

        private var borderPens: BorderPens = new BorderPens(2UB, 2UB, 1UB, 1UB)
        private var activeBorderPens: BorderPens = new BorderPens(1UB, 1UB, 2UB, 2UB)

        // Optional flat-border colour. When non-null, paint() draws a
        // single-colour 1-px rectangle instead of the bevel borderPens
        // / activeBorderPens. Distinct from `hoverBorderColor` (which
        // only stamps on hover) — this one is the resting border.
        var borderColor: UInt? = null

        // When false, skip the bevel border in paint(). The View's
        // borderWidths still affect layout unless callers also call
        // setBorderWidths(0S) — keep both knobs so themes can pick
        // "flat fill, same footprint" vs "no border at all".
        var drawBorder: Bool = true

        // Optional hover overlay: a 1px solid border stamped on top
        // of the existing chrome whenever the cursor is over the
        // button. Drawn AFTER the bg fill / bevel so it sits visually
        // on top, and uses the button's existing outer rect — no
        // layout change. Disabled by default; themed callers opt in
        // (Settings save button = white).
        var hoverBorderEnabled: Bool = false
        var hoverBorderPen: UByte    = 1UB
        // Color override for the hover border. Non-null implies
        // enabled — paint() treats `hoverBorderColor != null` as the
        // same trigger as `hoverBorderEnabled`.
        var hoverBorderColor: UInt? = null

        // Optional hover background swap: when enabled, the bg fill
        // uses `hoverBackgroundPen` while the cursor is over the
        // button (but it isn't actively pressed). Off by default so
        // existing buttons render unchanged. `activeBackgroundPen`
        // still wins on press, so a button can have three distinct
        // bg pens — default / hover / pressed — without conflict.
        var hoverBackgroundPenEnabled: Bool = false
        var hoverBackgroundPen: UByte       = 12UB

        // When non-zero, the label + hover border are translated by
        // this many pixels DOWN while the button is held pressed
        // (active + hovered). The bg fill stays full-extent so the
        // press doesn't reveal the parent's colour on row 0. Default
        // 0 keeps existing buttons unchanged.
        var pressTranslateY: Short = 0S

        override fun setDefaultPadding() {
            this.setPadding(5S)
        }

        override fun setDefaultBorder() {
            this.setBorderWidths(2S, 1S)
        }

        override fun onAttach(viewContext: ViewContext) {
            base.onAttach(viewContext)
            var label = this.ensureLabel()
            label.onAttach(viewContext)
        }

        override fun onDetach() {
            base.onDetach()
            var label = this.ensureLabel()
            label.onDetach()
        }

        private fun ensureLabel(): Label {
            if (this.label == null) {
                this.label = new Label(this.text)
            }
            return this.label
        }

        override fun minHeight(): Short {
            var label = this.ensureLabel()
            var minH = label.minHeight() + this.padding.top + this.padding.bottom + this.margin.top + this.margin.bottom + this.borderWidths.top + this.borderWidths.bottom
            return minH
        }

        override fun minWidth(): Short {
            var label = this.ensureLabel()
            return label.minWidth() + this.padding.left + this.padding.right + this.margin.left + this.margin.right + this.borderWidths.left + this.borderWidths.right
        }

        override fun layout(x: Short, y: Short, width: UShort, height: UShort) {
            base.layout(x, y, width, height)
            var label = this.ensureLabel()
            var lx = ((this.innerWidth() / 2S) - (label.minWidth() / 2S)) + this.margin.left + this.borderWidths.left + this.padding.left
            var ly = ((this.innerHeight() / 2S) - (label.minHeight() / 2S)) + this.margin.top + this.borderWidths.top + this.padding.top
            label.layout(lx, ly, label.minWidth().toUShort(), label.minHeight().toUShort())            
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            var x1 = 0S
            var x2 = this.width as Short - (this.margin.right + this.margin.left + 1S)
            var y1 = 0S
            var y2 = this.height as Short - (this.margin.bottom + this.margin.top + 1S)

            var borderPens = this.borderPens
            var bgPen = this.backgroundPen
            // Track the chosen bg colour alongside the pen — when
            // `useColor` is true and bgColor is non-null it wins at
            // fill time. amlc rejects `local = null` on a nullable
            // primitive, so we toggle a separate flag for the
            // "explicitly want the pen path" branches instead of
            // clearing bgColor.
            var bgColor: UInt? = this.backgroundColor
            var useColor: Bool = (bgColor != null)
            if (this.active && this.hovered) {
                bgPen = this.activeBackgroundPen
                borderPens = this.activeBorderPens
                if (this.activeBackgroundColor != null) {
                    bgColor = this.activeBackgroundColor
                    useColor = true
                } else {
                    useColor = false
                }
            } else if (this.hovered && this.hoverBackgroundColor != null) {
                // Hover with an explicit colour override: take it.
                bgColor = this.hoverBackgroundColor
                useColor = true
            } else if (this.hovered && this.hoverBackgroundPenEnabled) {
                // Hover but not pressed: bg-only swap, border stays
                // at its default pens. Keeps the affordance subtle
                // (no bevel flip) and unambiguously distinct from
                // the pressed state.
                bgPen = this.hoverBackgroundPen
                useColor = false
            }

            // Background bl,bt - w-br,h-bb
            // amlc drops `nullable != null` checks on the colour path,
            // making the eventual `as UInt` cast throw NullCastError at
            // run-time. Until the binder is fixed, force the pen route
            // — Buttons that themed via explicit colours render with
            // the matching palette pen, but no crash.
            graphics.setForegroundPen(bgPen)
            graphics.fillRect(x1, y1, x2, y2)

            // Border priority:
            //   1. Flat `borderColor` overrides everything — themes
            //      that want a single-colour rectangle never want the
            //      4-pen bevel underneath bleeding through.
            //   2. Else bevel via existing pens (unless drawBorder=false).
            // Same amlc workaround as the bg path above — skip the
            // colour branch.
            if (this.drawBorder) {
                this.paintNativeBorder(graphics, borderPens)
            }

            // Press translate: while the button is held pressed
            // (active + hovered), shift the label + hover border 1px
            // (or whatever pressTranslateY is) down. The bg fill
            // stays at full extent so the press doesn't reveal the
            // parent's colour on the top row.
            var pressDy = 0S
            if (this.active && this.hovered) {
                pressDy = this.pressTranslateY
            }

            // Hover overlay border — a flat single-pen rectangle
            // stamped on top of bg + (optional) bevel, INSIDE the
            // button's outer rect so the total dimensions don't
            // change. Drawn last so it always wins the pixel.
            //
            // Border stays at its full y1..y2 extent regardless of
            // press state; only the label gets the press-translate.
            // Translating the border too pushed the bottom edge to
            // y2+1 — one pixel OUTSIDE the bg-fill area — and on
            // release that stray pixel wasn't overdrawn, leaving a
            // ghost line at the original bottom edge.
            // Same amlc binder workaround as the bg/border branches
            // above: skip the colour cast, use the pen.
            if (this.hovered && this.hoverBorderEnabled) {
                graphics.setForegroundPen(this.hoverBorderPen)
                graphics.drawLine(x1, y1, x2, y1)
                graphics.drawLine(x1, y2, x2, y2)
                graphics.drawLine(x1, y1, x1, y2)
                graphics.drawLine(x2, y1, x2, y2)
            }

            // Draw label. Use Label.paint() directly (not paintAll)
            // because the label is a private field — outside any
            // children list — so subtree-dirty walks never mark it
            // and paintAll's b1||b2 gate would short-circuit. The
            // Button is repainting right now anyway, so we just
            // always render the label too, replicating paintAll's
            // outer translate (margin) by hand.
            var label = this.ensureLabel()
            // Propagate the resolved bg / text choice into the label
            // so the inner glyph sits on the right backdrop. The
            // color path wins when set; otherwise fall back to pens
            // exactly like before. Only push bgColor when the button
            // actually chose the color path — propagating a stale
            // bgColor on a pen-only frame would make the label
            // ignore the pen swap.
            label.backgroundPen = bgPen
            if (useColor) {
                label.backgroundColor = bgColor
            }
            label.textPen = this.textPen
            if (this.textColor != null) {
                label.textColor = this.textColor
            }
            var labelIx = label.x + label.margin.left
            var labelIy = label.y + label.margin.top + pressDy
            graphics.translate(labelIx, labelIy)
            label.paint(graphics)
            graphics.translate(0S - labelIx, 0S - labelIy)
        }

        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
//            ("Button click: " + button.toString() + " " + x.toString() + " " + y.toString()).println()

            var wasHovered = this.hovered

            if (this.contains(x, y)) {
                this.hovered = true

                if (type == MouseEventType.up) {
//                    "Mouse up".println()
                    this.active = false
                    this.requestRepaint()

//                ("Button clicked: " + this.text).println()
                    var cl = this.buttonClickListener
                    if (cl != null) {
                        var res = cl(this)                    
                        return res
                    }
                } else if (type == MouseEventType.down) {
//                    "Mouse down".println()
                    this.active = true
                    this.requestRepaint()
                } else if (type == MouseEventType.move) {
                    // Repaint on hover transition when any visible
                    // state depends on hovered — that's `active` (press
                    // bevel / press translate), the optional hover
                    // border overlay, or the optional hover-bg pen.
                    // Vanilla buttons with none of those skip the
                    // repaint so we don't churn paint cycles every
                    // time the cursor crosses one. Mirror the exit
                    // check below — they must agree, otherwise the
                    // visible state goes stale on one of the edges.
                    if (!wasHovered) {
                        if (this.active || this.hoverBorderEnabled || this.hoverBackgroundPenEnabled) {
                            this.requestRepaint()
                        }
                    }
                }

            } else {
                this.hovered = false

                if (type == MouseEventType.up) {
                    if (this.active) {
                        this.active = false
                        this.requestRepaint()
                    }
                } else if (wasHovered) {
                    // Same reasoning as the enter case — repaint on
                    // exit if there's something visible to clear.
                    if (this.active || this.hoverBorderEnabled || this.hoverBackgroundPenEnabled) {
                        this.requestRepaint()
                    }
                }


            }
            return false
        }



    }
}

