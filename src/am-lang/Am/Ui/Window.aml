
namespace Am.Ui 
{
    #implementationPlatforms "libc", "amigaos", "amigaos-sim", "morphos-ppc"
    native class Window {
        import Am.Lang
        import Am.Collections

        private var rootView: View
        private var x: Short
        private var y: Short
        private var width: UShort
        private var height: UShort
        private var screen: Screen
        private var viewContext: ViewContextImpl
        private var graphics: LayerGraphics
        private var repaintRequested: Bool
        // When true, the next paint clears the window background and tells
        // every view to repaint regardless of its individual flag. Used
        // for initial paint, resizes, and structural changes like a tree
        // rebuild. Plain view-level requestRepaint() leaves this false so
        // only the views that asked for it actually re-render.
        private var fullRepaintRequested: Bool = true
        private var border: Insets
        private var backgroundPen: UByte
        private var fillBackground: Bool
        private var pixelScaleX: UByte
        private var pixelScaleY: UByte
        private var pixelMetrics: PixelMetrics
        private var title: String = ""
        private var screenTitle: String = ""
        private var menuStrip: MenuStrip

        // Window-level off-screen buffer for double-buffered painting.
        // Lazy-allocated the first time getOffscreen() is called and sized
        // to the host screen. Window.paint routes every view's painting
        // through this buffer and flushes the affected rect to the
        // visible surface as a single blit at the end of the cycle —
        // the user never sees the intermediate label-by-label fill that
        // direct on-screen painting would expose.
        private var offscreen: RenderableBitmap = null
        private var offscreenGraphics: Graphics = null

        // Dirty regions for the current paint cycle, in window-local
        // (post-border, pre-translate) coords. Views call
        // expandDirtyBounds() from paintAll() right after they paint;
        // at the end of the cycle each region is blitted from
        // offscreen back to the visible window.
        //
        // List instead of a single bounding rect so a small change
        // in the top-left + an unrelated small change in the
        // bottom-right don't force a full-diagonal blit. The list
        // is kept small via coalescing: overlapping / touching rects
        // merge when the bbox-of-the-pair isn't much larger than
        // the sum of their areas. See expandDirtyBounds() for the
        // heuristic.
        //
        // Cap at DIRTY_CAP rects; above that we fall back to a
        // single bounding rect (matches the pre-list behaviour as
        // a safety net for pathological cases).
        private var dirtyRegions: List<Rectangle> = new List<Rectangle>()
        private static const DIRTY_CAP: Int = 16

        // Tasks queued by worker threads to run on the main UI
        // thread before the next paint. Background work (Aminet
        // HTTP fetches, ChatGPT requests) does the slow I/O off-
        // thread, then posts the result-applying step here so
        // view-tree mutation lands on the main thread and not
        // mid-paint on a worker. AmLang has no mutex primitive;
        // the list is touched by both threads but the contention
        // window is tiny and the worst case is a task running on
        // the next pump tick instead of this one — never lost.
        private var pendingTasks: List<Runnable> = new List<Runnable>()

        // Queue `task` to run on the main thread. Safe to call
        // from a worker thread. Also wakes the main loop via
        // requestRepaint so any handleInput wait breaks promptly.
        fun postToMainThread(task: Runnable) {
            if (task == null) {
                return
            }
            this.pendingTasks.add(task)
            this.requestRepaint()
        }

        // Drain the pending-tasks queue. Called from the main
        // loop after handleInput returns. Tasks added by a worker
        // *during* this drain land on the list and run on this
        // same pump (the loop re-checks size each iteration).
        fun pumpMainThreadTasks() {
            while (this.pendingTasks.getSize() > 0) {
                var task = this.pendingTasks.get(0)
                this.pendingTasks.removeAt(0)
                if (task != null) {
                    task.run()
                }
            }
        }

        // Cross-layer dirty-rect propagation. When false (default),
        // markDirty() is a no-op — the only thing that adds rects
        // to dirtyRegions is the usual reportPaintedBounds call
        // from View.paintAll, identical to the pre-design behaviour.
        // When true, markDirty also walks every LayeredPane ancestor
        // of the source view and dirties overlapping peer layers
        // per the z-order rules in LayeredPane.propagateDirty (and
        // climbs translucent ancestors so a translucent source's
        // gaps see fresh parent-bg pixels). Flipped on in step 3
        // of the multi-layer dirty design once we have a real
        // cross-layer scenario to exercise.
        var crossLayerDirty: Bool = false

        var font: Font

        fun getRootView(): View {
            return this.rootView
        }

        fun setTitle(title: String) {
            this.title = title
            this.setTitleNative(this.title, this.screenTitle)
        }

        fun getTitle(): String {
            return this.title
        }

        fun setScreenTitle(screenTitle: String) {
            this.screenTitle = screenTitle
            this.setTitleNative(this.title, this.screenTitle)
        }

        fun getScreenTitle(): String {
            return this.screenTitle
        }

        // The screen this window is mounted on (null for the public
        // Workbench screen). Used by dialog/modal helpers that need
        // to open a second window on the SAME screen instead of
        // accidentally landing on Workbench.
        fun getScreen(): Screen {
            return this.screen
        }

        private fun setBorder(left: Short, top: Short, right: Short, bottom: Short) {
            this.border = new Insets(left, top, right, bottom)
        }

        fun setBackgroundPen(pen: UByte) {
            this.backgroundPen = pen
            this.requestRepaint()
        }

        fun getBackgroundPen(): UByte {
            return this.backgroundPen
        }

        fun setFillBackground(fill: Bool) {
            this.fillBackground = fill
            this.requestRepaint()
        }

        fun setRootView(view: View) {
            if (this.rootView == view) {
                return
            }
            if(this.rootView != null) {
                this.rootView.parentView = null
                this.rootView.onDetach()
            }
            this.rootView = view
            if (view != null) {
                // Root has no parent — used as the stop condition
                // for parentView-chain walks in cross-view dirty
                // propagation.
                view.parentView = null
//                "onAttach...".println()
                view.onAttach(this.viewContext)
            }
        }

        // Window-level mouse-event observers. Every mouse event the
        // window receives (down / up / move) is fed to each
        // registered listener with the original window-absolute
        // coords — *before* the regular tree dispatch — so a
        // listener can react first (close a popup on outside-click,
        // clear a stale hover when the cursor leaves a view, etc.)
        // independent of which view ends up consuming the event.
        //
        // Listeners run as passive observers: their return value is
        // currently ignored and the regular dispatch always runs
        // after they fire. Wrapped in MouseEventListener instead of
        // storing the lambda directly because AmLang's collection-
        // of-function-pointer typing has historically been brittle.
        // Lazy-allocated so we don't pay the List overhead until a
        // caller actually wants to listen.
        private var mouseListeners: List<MouseEventListener> = null

        fun addMouseEventListener(l: MouseEventListener) {
            if (this.mouseListeners == null) {
                this.mouseListeners = new List<MouseEventListener>()
            }
            this.mouseListeners.add(l)
        }

        fun removeMouseEventListener(l: MouseEventListener) {
            if (this.mouseListeners == null) {
                return
            }
            this.mouseListeners.remove(l)
        }

        // Fan an event out to every listener. Hoisting the loop
        // into its own method (instead of inlining it in
        // onMouseEvent) sidesteps a binder issue we hit when
        // iterating a `List<MouseEventListener>` in a context where
        // `this.X` chains. Inside this method's scope, the
        // generic-list type resolves cleanly and the index walk
        // compiles.
        private fun dispatchToMouseListeners(me: MouseEvent) {
            // Bind the list to a local first — chained `this.X.Y`
            // access trips the binder for generic-typed fields here.
            var list = this.mouseListeners
            if (list == null) {
                return
            }
            var n = list.getSize()
            var i = 0
            while (i < n) {
                list.get(i).listener(me)
                i = i + 1
            }
        }


        static fun openWindow(x: Short, y: Short, width: UShort, height: UShort, screen: Screen, windowManager: WindowManager): Window {
            var properties: WindowProperties = { borderless: false }
            return Window.openWindow(x, y, width, height, screen, windowManager, properties)
        }

        static fun openWindow(x: Short, y: Short, width: UShort, height: UShort, screen: Screen, windowManager: WindowManager, properties: WindowProperties): Window {
            var w = new Window()
            var vc = new ViewContextImpl()
            vc.setWindow(w)
            w.viewContext = vc
            w.x = x
            w.y = y
            w.fillBackground = true
            w.border = new Insets(0S, 0S, 0S, 0S)
            w.width = width
            w.height = height
            w.screen = screen
            w.open(x, y, width, height, screen, windowManager, properties)
            var graphics = LayerGraphics.fromWindow(w)
            w.graphics = graphics
            return w
        }

        fun requestRepaint() {
            var b = this.repaintRequested
            if (!b) {
                this.repaintRequested = true
                this.refresh()
            }
        }

        // Force a refresh message into the window's UserPort even if
        // a repaint is already pending. The dedupe in requestRepaint
        // is needed to avoid re-PutMsg'ing the (single, shared)
        // refresh_msg before the OS has dispatched the previous one
        // — but the same dedupe means a worker-thread poller that
        // calls requestRepaint() in a tight loop only ever wakes the
        // main Wait once and then goes silent. forceWake() is for
        // pollers: it sets the dedupe flag AND calls refresh()
        // regardless, so each call PutMsg's a fresh wake. Re-using
        // the same refresh_msg slot is documented as safe by the
        // native side (memset before PutMsg).
        fun forceWake() {
            this.repaintRequested = true
            this.refresh()
        }

        // Native handles for direct Signal() wakeup from another
        // task. Used by RunningProcess so that when bebbossh / ssh
        // writes output, our DOS-handler in the bebbossh process can
        // Signal amStudio's main task DIRECTLY (skipping the IDCMP
        // message round-trip), making the output appear in real time
        // without depending on AmLang's polling cadence.
        //
        // getUserPortTaskPtr  → ULONG cast of window->UserPort->mp_SigTask
        //                       (i.e. the task that owns the UserPort —
        //                       amStudio's main task)
        // getUserPortSigBit   → window->UserPort->mp_SigBit (UBYTE,
        //                       returned widened to Int)
        native fun getUserPortTaskPtr(): Long
        native fun getUserPortSigBit(): Int

        // Schedule a full repaint — wipes the window background and forces
        // every view (not just ones with their own flag) to repaint on the
        // next paint cycle. Use for resizes / structural changes; everyday
        // view updates should call requestRepaint() on the affected view.
        fun requestFullRepaint() {
            this.fullRepaintRequested = true
            this.requestRepaint()
        }
        // Synchronously paints the root view into the window. On native
        // platforms paint() is normally driven by the OS event loop in
        // response to refresh(); tests (and simple synchronous flows) can
        // call this to force a paint without depending on input events.
        fun repaint() {
            this.paint()
        }

        // Expands the current paint cycle's dirty bounds to enclose
        // the given rect. Called from each View.paintAll / ViewGroup.paintAll /
        // Panel.paintAll / ScrollView.paintAll variant right after the
        // view's paint() runs, so the union at the end of the cycle
        // covers every pixel that was actually re-drawn. Coords are
        // window-local (the same frame Window.paint sets up before
        // walking rootView — i.e. (innerX, innerY) is the origin a
        // freshly-translated graphics sees).
        //
        // Negative widths/heights are no-ops so a caller computing
        // bounds from a view that hasn't been laid out yet doesn't
        // poison the union.
        // Add a painted rect to this cycle's dirty list. Three
        // optimisations keep the list small:
        //
        //   1. Containment: if the new rect is already fully
        //      inside an existing entry, drop it.
        //   2. Coalescing: walk the existing entries; any that
        //      touch or overlap the new rect get absorbed into a
        //      growing bbox WHEN the bbox area isn't much bigger
        //      than the sum of the two areas (the rule of thumb
        //      is bbox <= 1.5 × (areaA + areaB), so we waste at
        //      most ~50% extra pixels per merge — much cheaper
        //      than a separate blit's per-call overhead). Rects
        //      that touch/overlap but fail the area test stay
        //      separate (good for two screen-corner edits).
        //   3. Cap: above DIRTY_CAP entries we collapse the
        //      entire list into one bounding rect — matches the
        //      pre-list behaviour and bounds worst-case flush cost.
        //
        // Coords are window-local (the same frame Window.paint
        // sets up before walking rootView). Negative widths /
        // heights are no-ops so a caller computing bounds from a
        // not-yet-laid-out view doesn't poison the list.
        fun expandDirtyBounds(x: Short, y: Short, w: Short, h: Short) {
            if (w <= 0S || h <= 0S) {
                return
            }
            var x2 = x + w
            var y2 = y + h

            // 1) Containment — drop redundant.
            var n = this.dirtyRegions.getSize()
            var i = 0
            while (i < n) {
                var r = this.dirtyRegions.get(i)
                var rx2 = r.x + r.width.toShort()
                var ry2 = r.y + r.height.toShort()
                if (x >= r.x && y >= r.y && x2 <= rx2 && y2 <= ry2) {
                    return
                }
                i = i + 1
            }

            // 2) Coalesce — absorb any touch/overlap entries when
            //    the merge cost is acceptable.
            var curX1 = x
            var curY1 = y
            var curX2 = x2
            var curY2 = y2
            i = 0
            while (i < this.dirtyRegions.getSize()) {
                var r = this.dirtyRegions.get(i)
                var rx1 = r.x
                var ry1 = r.y
                var rx2 = rx1 + r.width.toShort()
                var ry2 = ry1 + r.height.toShort()

                // Touch / overlap test: rects DON'T touch when one
                // is strictly outside the other on either axis.
                var disjoint = (rx2 < curX1) || (curX2 < rx1) || (ry2 < curY1) || (curY2 < ry1)
                var coalesced = false
                if (!disjoint) {
                    var bX1 = curX1
                    if (rx1 < bX1) { bX1 = rx1 }
                    var bY1 = curY1
                    if (ry1 < bY1) { bY1 = ry1 }
                    var bX2 = curX2
                    if (rx2 > bX2) { bX2 = rx2 }
                    var bY2 = curY2
                    if (ry2 > bY2) { bY2 = ry2 }

                    // Areas are computed as Int to avoid Short
                    // overflow on a near-full-window rect.
                    var bboxArea = (bX2 - bX1).toInt() * (bY2 - bY1).toInt()
                    var curArea  = (curX2 - curX1).toInt() * (curY2 - curY1).toInt()
                    var rArea    = (rx2 - rx1).toInt() * (ry2 - ry1).toInt()
                    var sumArea  = curArea + rArea
                    // Merge when bbox <= 1.5 × sum, i.e.
                    // 2 × bbox <= 3 × sum (integer-friendly).
                    if (bboxArea * 2 <= sumArea * 3) {
                        curX1 = bX1
                        curY1 = bY1
                        curX2 = bX2
                        curY2 = bY2
                        this.dirtyRegions.removeAt(i)
                        // List shifted left — re-check the same
                        // index next iteration; skip the i++.
                        coalesced = true
                    }
                }
                if (!coalesced) {
                    i = i + 1
                }
            }

            // 3) Cap fallback — collapse to a single bounding rect.
            if (this.dirtyRegions.getSize() >= Window.DIRTY_CAP - 1) {
                var j = 0
                var jn = this.dirtyRegions.getSize()
                while (j < jn) {
                    var rr = this.dirtyRegions.get(j)
                    var rrx2 = rr.x + rr.width.toShort()
                    var rry2 = rr.y + rr.height.toShort()
                    if (rr.x < curX1)  { curX1 = rr.x }
                    if (rr.y < curY1)  { curY1 = rr.y }
                    if (rrx2 > curX2)  { curX2 = rrx2 }
                    if (rry2 > curY2)  { curY2 = rry2 }
                    j = j + 1
                }
                this.dirtyRegions.clear()
            }

            this.dirtyRegions.add(new Rectangle(curX1, curY1, (curX2 - curX1).toUShort(), (curY2 - curY1).toUShort()))
        }

        private fun resetDirtyBounds() {
            this.dirtyRegions.clear()
        }

        private fun hasDirtyBounds(): Bool {
            return this.dirtyRegions.getSize() > 0
        }

        // Entry point for cross-view dirty-rect propagation: a
        // view that just dirtied `winRect` (window-local coords)
        // calls here; we add the rect to the flush list AND walk
        // the source's ancestor chain so every LayeredPane on the
        // way to root gets a chance to invalidate overlapping
        // peer layers. Translucent sources also dirty their
        // immediate ancestor chain (recursively, while ancestors
        // are also translucent) so parent-bg pixels visible
        // through the source's gaps get redrawn.
        //
        // Wrapped in the `crossLayerDirty` flag so the whole
        // method is a no-op until the gate flips. Today only the
        // existing reportPaintedBounds-from-paintAll path reaches
        // expandDirtyBounds, exactly as before this design.
        fun markDirty(winRect: Rectangle, source: View) {
            if (!this.crossLayerDirty) {
                return
            }
            this.expandDirtyBounds(winRect.x, winRect.y, winRect.width.toShort(), winRect.height.toShort())

            var sourceOpaque = true
            if (source != null) {
                sourceOpaque = source.isOpaque()
            }

            // Walk ancestors. propagateDirty on a non-LayeredPane
            // is a no-op (View default). LayeredPane override does
            // the z-aware peer invalidation. Hard depth cap on the
            // walk so a stray parentView cycle can't hang the IDE.
            if (source != null) {
                var p = source.parentView
                var safety = 256
                while (p != null && safety > 0) {
                    p.propagateDirty(winRect, source, sourceOpaque)
                    p = p.parentView
                    safety = safety - 1
                }
            }

            // Translucent climb: the immediate parent's bg shows
            // through the source's gaps, so it needs to repaint
            // its overlap. Recurse upward while parents are also
            // translucent. Stops at the first opaque ancestor.
            if (source != null && !sourceOpaque) {
                this.translucentClimb(source.parentView, winRect)
            }
        }

        // Recursive helper for markDirty's translucent climb. The
        // straight-line while-loop form (`if (opaque) { pp = null }
        // else { pp = pp.parentView }`) trips amlc's renderer on
        // the if-assigns-null-inside-a-while shape; recursion side-
        // steps it cleanly.
        private fun translucentClimb(view: View, winRect: Rectangle) {
            if (view == null) {
                return
            }
            view.invalidateOverlapping(winRect)
            if (view.isOpaque()) {
                return
            }
            this.translucentClimb(view.parentView, winRect)
        }

        private fun paint() {
            // The whole paint cycle goes to the off-screen buffer; we
            // blit only the affected sub-rect back to the visible
            // surface at the end. Painting directly to the screen used
            // to expose every label's fillRect / drawString in real
            // time, which on a sidebar with many rows reads as a
            // visible flicker when anything triggers a repaint.
            var off = this.getOffscreenGraphics()
            var full = this.fullRepaintRequested
            // Reset the repaint flags BEFORE running the paint chain
            // so that a view which calls `requestRepaint()` from
            // inside its own paint (e.g. an animation that wants the
            // next frame) actually re-queues a refresh — otherwise
            // requestRepaint's `if (!b)` guard sees the flag still
            // set from this cycle, no IDCMP_REFRESHWINDOW gets
            // posted, and the animation freezes after one frame.
            this.repaintRequested = false
            this.fullRepaintRequested = false
            if (full) {
                // Tell every view in the tree to repaint, even if their
                // own flag is unset. Partial repaints leave this off, so
                // only views with their own requestRepaint() actually paint.
                off.requestRepaintAll()
            }
            this.resetDirtyBounds()
            if (this.rootView != null) {
                var innerX = this.border.left
                var innerY = this.border.top
                var innerWidth = this.width - (this.border.left + this.border.right).toUShort()
                var innerHeight = this.height - (this.border.top + this.border.bottom).toUShort()

                var windowClipRect: ClipRect = { x: innerX, y: innerY, width: innerWidth, height: innerHeight }
                off.pushClipRect(windowClipRect)

                if (full && this.fillBackground) {
                    off.setForegroundPen(this.backgroundPen)
                    off.fillRect(0S + this.border.left, 0S + this.border.top, this.width.toShort() - (1S + this.border.right), this.height.toShort() - (1S + this.border.bottom))
                    this.expandDirtyBounds(innerX, innerY, innerWidth.toShort(), innerHeight.toShort())
                }
                if (this.font != null) {
                    off.setFont(this.font)
                }

                // Enter content-local coord space so the translate accumulator
                // matches the absolute clip rect we just pushed; otherwise every
                // nested createInnerClipRect bakes in (border.left, border.top)
                // while the translate stack does not, and child paints land at
                // window-frame coords while their clips are at content coords.
                off.translate(innerX, innerY)
                // Window holds exactly one rootView and paints it.
                // Apps that want layered behaviour (popups, docked
                // overlays, drag ghosts) mount a LayeredPane as
                // their rootView and stack views via addLayer.
                this.rootView.paintAll(off)
                off.translate(0S - innerX, 0S - innerY)

                off.popClipRect()

                this.flushDirtyBounds(innerX, innerY, innerWidth, innerHeight)
            }
            off.finalizeRepaintCycle()
        }

        private fun onResize(x: Short, y: Short, width: UShort, height: UShort) {
            this.x = x
            this.y = y
            this.width = width
            this.height = height
            this.layout()
        }

        fun layout() {
            var b = this.border
            var innerW = this.width - (b.left + b.right).toUShort()
            var innerH = this.height - (b.top + b.bottom).toUShort()
            if (this.rootView != null) {
                this.rootView.layout(0S, 0S, innerW, innerH)
            }
        }

        fun onCloseButtonClick() {
            this.close()
        }

        // Soft keyboard focus: when set, this view gets first crack
        // at every key event before the usual rootView walk. If the
        // focused view returns false (didn't consume), dispatch
        // falls through to the normal tree walk. Used for views
        // that aren't naturally first in keyboard-walk order — e.g.
        // an inline terminal docked below an editor that always
        // consumes keys.
        private var keyboardFocus: View = null

        // Window-wide focus-change listeners. Fired whenever
        // setKeyboardFocus / clearKeyboardFocus actually changes the
        // focused view — same focus passed in twice is a no-op so a
        // mouse-down that just re-focuses the already-focused field
        // doesn't fire the listener (or waste a repaint cycle).
        //
        // Listeners receive (oldFocus, newFocus) where either side
        // can be null (no view was / no view is focused). Return
        // value is ignored — included so the closure type matches
        // the rest of the codebase's listener convention.
        //
        // The function reference is wrapped in FocusChangedListener
        // instead of being stored as a bare function type in the
        // List's generic parameter, because amlc currently NPEs the
        // binder on `HashMap<K, fn>` / `List<fn>` shapes (see
        // KNOWN_BUGS.md "HashMap<K, (...) => V>"). The wrapper class
        // is essentially free at runtime.
        private var focusChangedListeners: List<FocusChangedListener>
            = new List<FocusChangedListener>()

        fun addFocusChangedListener(listener: (oldFocus: View, newFocus: View) => Bool) {
            this.focusChangedListeners.add(new FocusChangedListener(listener))
        }

        fun setKeyboardFocus(view: View) {
            this.assignFocus(view)
        }

        fun clearKeyboardFocus(view: View) {
            if (this.keyboardFocus == view) {
                this.assignFocus(null)
            }
        }

        // Move keyboard focus to the next / previous focusable view in
        // the rootView's tree order. Wrap around at the ends so Tab
        // from the last input lands on the first. If nothing in the
        // tree reports focusable, no-op. If nothing is currently
        // focused, focusNext starts at index 0 and focusPrev at the
        // last entry.
        //
        // Called by onKeyboardEvent's Tab / Shift+Tab handler AFTER
        // the currently-focused view declines the key (so an editor
        // that wants Tab for indent keeps it; a TextField with no
        // submit handler falls through and lets Tab navigate).
        fun focusNext(): Bool {
            return this.advanceFocus(1)
        }

        fun focusPrev(): Bool {
            return this.advanceFocus(-1)
        }

        // Focus the first focusable view inside `root`. Used by
        // overlay / sidebar open paths so a freshly-mounted Settings,
        // ChatGpt or find bar starts with its input ready for typing.
        // No-op when the subtree has no focusable view.
        fun focusFirstIn(root: View): Bool {
            if (root == null) {
                return false
            }
            var list = new List<View>()
            root.collectFocusable(list)
            if (list.getSize() == 0) {
                return false
            }
            this.setKeyboardFocus(list.get(0))
            return true
        }

        private fun advanceFocus(dir: Int): Bool {
            if (this.rootView == null) {
                return false
            }
            var list = new List<View>()
            this.rootView.collectFocusable(list)
            var n = list.getSize()
            if (n == 0) {
                return false
            }
            var idx = -1
            var i = 0
            while (i < n) {
                if (list.get(i) == this.keyboardFocus) {
                    idx = i
                    i = n
                } else {
                    i = i + 1
                }
            }
            var next: Int = 0
            if (idx < 0) {
                // No current focus — pick first (forward) or last (back).
                if (dir > 0) {
                    next = 0
                } else {
                    next = n - 1
                }
            } else {
                next = ((idx + dir) + n) % n
            }
            this.setKeyboardFocus(list.get(next))
            return true
        }

        // Single chokepoint for focus mutations. Detects whether the
        // focus actually moved, requests a repaint on the old AND new
        // focused views so e.g. a TextField can swap its filled
        // cursor for a hollow outline (and vice versa), then fires
        // the focus-changed listeners.
        private fun assignFocus(newFocus: View) {
            var oldFocus = this.keyboardFocus
            if (oldFocus == newFocus) {
                return
            }
            this.keyboardFocus = newFocus
            if (oldFocus != null) {
                oldFocus.requestRepaint()
            }
            if (newFocus != null) {
                newFocus.requestRepaint()
            }
            var i = 0
            while (i < this.focusChangedListeners.getSize()) {
                var cb = this.focusChangedListeners.get(i)
                cb.fn(oldFocus, newFocus)
                i = i + 1
            }
        }

        // Read the current keyboard-focused view (or null). Used by
        // views like TextEditor and CliView to gate their key
        // handling — they consume only when they're the focused
        // view, so a click elsewhere makes them stop swallowing
        // every keystroke.
        fun getKeyboardFocus(): View {
            return this.keyboardFocus
        }

        fun onKeyboardEvent(type: KeyboardEventType, keyCode: UShort, keyChar: UShort) {
            var kf = this.keyboardFocus
            if (kf != null) {
                if (kf.onKeyboardEvent(type, keyCode, keyChar)) {
                    return
                }
            }
            // Tab moves focus to the next focusable view when the
            // currently-focused view declined the key (or there is no
            // focus). Editors and other consumers of Tab return true
            // first and keep the key. Only handle on key-down so the
            // navigation doesn't fire twice per press.
            if (type == KeyboardEventType.down && keyChar == 9US) {
                if (this.focusNext()) {
                    return
                }
            }
            this.rootView?.onKeyboardEvent(type, keyCode, keyChar)
        }

        // Mouse-wheel dispatch. Routed by cursor position (the
        // rootView hit-tests x/y), NOT by keyboard focus — wheeling
        // over the editor scrolls the editor even when the terminal
        // has key focus, and vice versa. Called from the native
        // event loop when an IDCMP_EXTENDEDMOUSE wheel event arrives.
        fun onMouseWheel(deltaY: Short, x: Short, y: Short) {
            var lx = x - this.border.left
            var ly = y - this.border.top
            this.rootView?.onMouseWheel(deltaY, lx, ly)
        }

        // Most recent mouse event's content-local coords (window
        // coords minus border). Cached here so listeners deep in
        // the view tree — where x/y have been progressively
        // localised by every parent in the dispatch chain — can
        // still ask "where was the click in window space?" via
        // getLastMouseX/Y. Updated on every mouse event before the
        // dispatch walk, so the value is current at the moment any
        // synchronous listener runs.
        private var lastMouseX: Short = 0S
        private var lastMouseY: Short = 0S

        fun getLastMouseX(): Short {
            return this.lastMouseX
        }

        fun getLastMouseY(): Short {
            return this.lastMouseY
        }

        fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short) {
            var lx = x - this.border.left
            var ly = y - this.border.top
            this.lastMouseX = lx
            this.lastMouseY = ly

            // Window-level listeners get the *absolute* coords (pre-
            // border-subtraction). They run BEFORE the regular
            // dispatch so a listener can react (close a popup,
            // clear hover state, etc.) before any view consumes the
            // event. Return value is currently ignored — see the
            // declaration of `mouseListeners` for the rationale.
            // All listeners get the absolute coords pre-dispatch.
            // The actual walk lives in dispatchToMouseListeners
            // because the generic-list iteration didn't bind
            // cleanly when inlined here — see that method's comment.
            this.dispatchToMouseListeners(new MouseEvent(type, button, x, y))

            this.rootView?.onMouseEvent(type, button, lx, ly)
        }

        fun calculateStringWidth(font: Font, text: String): UShort {
            var graphics = this.getGraphics()
            if (font != null) {                
                graphics.setFont(font)
            }
            return graphics.calculateStringWidth(text)
        }

        fun getCurrentFontSize(): UByte {
            var graphics = this.getGraphics()
            if (graphics == null) {
                throw new Exception("Graphics is null")
            }
            return graphics.getCurrentFontSize()
        }

        native fun copyToClipboard(text: String)

        native fun pasteFromClipboard(): String

        fun setMenuStrip(strip: MenuStrip) {
            this.menuStrip = strip
            if (strip == null) {
                this.nativeClearMenuStrip()
                return
            }
            this.nativeBeginMenuStrip()
            var menuIndex = 0
            each (menu in strip.menus) {
                this.nativeAddMenu(menu.title)
                each (item in menu.items) {
                    this.nativeAddMenuItem(menuIndex, item, item.label, item.commKey)
                    // One level of cascade. Intuition supports
                    // NM_SUB inside NM_ITEM but not arbitrary
                    // depths, so we only walk subItems one level
                    // deep and ignore any grand-children.
                    if (item.subItems.getSize() > 0) {
                        each (sub in item.subItems) {
                            this.nativeAddMenuSubItem(menuIndex, sub, sub.label, sub.commKey)
                        }
                    }
                }
                menuIndex++
            }
            this.nativeFinalizeMenuStrip()
        }

        private native fun nativeBeginMenuStrip()
        private native fun nativeAddMenu(title: String)
        private native fun nativeAddMenuItem(menuIndex: Int, item: MenuItem, label: String, commKey: String)
        // Append a NM_SUB entry under the most recently added
        // NM_ITEM in the menu identified by `menuIndex`. Order
        // matters: the native side stamps sub-items against the
        // last NM_ITEM it saw for the same `menuIndex`.
        private native fun nativeAddMenuSubItem(menuIndex: Int, item: MenuItem, label: String, commKey: String)
        private native fun nativeFinalizeMenuStrip()
        private native fun nativeClearMenuStrip()

        private fun getGraphics(): LayerGraphics  {
            return this.graphics
//            return this.viewContext.getGraphics()
        }

        fun getPixelMetrics(): PixelMetrics {
            if (this.pixelMetrics == null) {
                this.pixelMetrics = new PixelMetrics(this.pixelScaleX, this.pixelScaleY)
            }
            return this.pixelMetrics
        }
/*
        fun getPixelScaleX(): UByte {
            return this.pixelScaleX
        }

        fun getPixelScaleY(): UByte {
            return this.pixelScaleY
        }
*/
        // Lazy-allocate the window-level offscreen buffer (sized to the
        // host screen) and return it. Used together with
        // getOffscreenGraphics() + flushOffscreenRect() for double-buffered
        // painting inside a view.
        fun getOffscreen(): RenderableBitmap {
            if (this.offscreen == null) {
                var w = this.getHostScreenWidth()
                var h = this.getHostScreenHeight()
                this.offscreen = RenderableBitmap.empty(w, h, this)
            }
            return this.offscreen
        }

        // Cached Graphics bound to the offscreen bitmap. The translate
        // state on this object accumulates across calls — callers should
        // undo whatever they translate, just like with the window's own
        // graphics.
        fun getOffscreenGraphics(): Graphics {
            if (this.offscreenGraphics == null) {
                this.offscreenGraphics = this.getOffscreen().createGraphics()
            }
            return this.offscreenGraphics
        }

        // Blit a rectangle from the offscreen bitmap to this window at the
        // same coords. Caller passes absolute window-relative coords;
        // we cancel the in-flight translate on the on-screen graphics so
        // the blit lands at the absolute (x, y) rather than at
        // (currentTranslate + x). Without this the destination ends up
        // double-translated (once via the caller computing x/y from
        // graphics.getTranslateX/Y(), once via blitBitmapRect itself
        // applying that same translate again).
        fun flushOffscreenRect(x: Short, y: Short, w: UShort, h: UShort) {
            var off = this.getOffscreen()
            var g = this.graphics
            var tx = g.getTranslateX()
            var ty = g.getTranslateY()
            g.blitBitmapRect(off.getBitmap(), x, y, w, h, x - tx, y - ty)
        }

        // End-of-paint blit: walks every rect accumulated this
        // cycle (post-coalescing), clamps each to the inner area,
        // and fires a flushOffscreenRect per surviving region. A
        // freshly-allocated `new List` per cycle is avoided — the
        // coalescing in expandDirtyBounds keeps the list short
        // (most paint cycles end with 1-3 entries).
        //
        // No dirty content (clean paint pass — `repaintRequested`
        // was set but no view actually painted) → no blits. This
        // is the common case for redundant requestRepaint cascades
        // that don't change any visible pixels.
        private fun flushDirtyBounds(innerX: Short, innerY: Short, innerW: UShort, innerH: UShort) {
            var n = this.dirtyRegions.getSize()
            if (n == 0) {
                return
            }
            var maxX = innerX + innerW.toShort()
            var maxY = innerY + innerH.toShort()
            var i = 0
            while (i < n) {
                var r = this.dirtyRegions.get(i)
                var x1 = r.x
                var y1 = r.y
                var x2 = x1 + r.width.toShort()
                var y2 = y1 + r.height.toShort()
                if (x1 < innerX) { x1 = innerX }
                if (y1 < innerY) { y1 = innerY }
                if (x2 > maxX) { x2 = maxX }
                if (y2 > maxY) { y2 = maxY }
                if (x2 > x1 && y2 > y1) {
                    this.flushOffscreenRect(x1, y1, (x2 - x1).toUShort(), (y2 - y1).toUShort())
                }
                i = i + 1
            }
        }

        native fun handleInput()
        native fun isOpen(): Bool
        private native fun refresh()
        private native fun setTitleNative(windowTitle: String, screenTitle: String)
        // Pixel dimensions of the host Intuition screen (not this window).
        // Used to size the lazily-allocated offscreen bitmap so any view
        // anywhere in the window can flush into it.
        native fun getHostScreenWidth(): UShort
        native fun getHostScreenHeight(): UShort

        private native fun open(x: Short, y: Short, width: UShort, height: UShort, screen: Screen, windowManager: WindowManager, properties: WindowProperties)
        native fun close()
        fun dispose() {
            this.viewContext = null
            this.graphics = null
        }

        fun getScaledX(x: Short): Short {
            return x * this.pixelScaleX.toShort()            
        }

        fun getScaledY(y: Short): Short {
            return y * this.pixelScaleY.toShort()            
        }

    }
}

