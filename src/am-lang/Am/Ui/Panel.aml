
namespace Am.Ui 
{

    class Panel() : View {
        import Am.Lang

        private var child: View

        var backgroundPen: UByte = 0UB
        var drawBorder: Bool = true
        var borderPens: BorderPens = new BorderPens(1UB, 1UB, 2UB, 2UB)
        // When non-negative this value replaces the child-derived
        // minWidth — used for resizable side panels whose width is
        // not bounded by their content (e.g. a sidebar wrapping a
        // file tree). Padding/margin/border still apply on top.
        // A negative value (the default) preserves the original
        // "size to content" behaviour.
        var preferredWidth: Short = -1S

        override fun setDefaultPadding() {
            this.setPadding(4S, 2S)
        }

        override fun setDefaultBorder() {
            this.setBorderWidths(2S, 1S)
        }

        override fun onAttach(viewContext: ViewContext) {
            base.onAttach(viewContext)
            this.child?.onAttach(viewContext)
        }

        override fun onDetach() {
            base.onDetach()
            this.child?.onDetach()
        }

        // Panel keeps its content in a single `child` slot outside
        // ViewGroup.children, so the default View-level walk would
        // mark only the panel itself dirty. Mirror the recursion into
        // the child so callers asking to redraw "this whole subtree"
        // actually redraw the contents too — otherwise paintAll
        // wipes the panel background and the unmarked child is left
        // clean, producing a blank rectangle until something hovers
        // its rows.
        override fun requestRepaintTree() {
            base.requestRepaintTree()
            this.child?.requestRepaintTree()
        }

        override fun minHeight(): Short {
            var ch = 0S
            if (this.child != null) {
                ch = this.child.minHeight()
            }
            return ch + this.padding.top + this.padding.bottom + this.margin.top + this.margin.bottom + this.borderWidths.top + this.borderWidths.bottom
        }

        override fun minWidth(): Short {
            var cw = 0S
            if (this.preferredWidth >= 0S) {
                cw = this.preferredWidth
            } else if (this.child != null) {
                cw = this.child.minWidth()
            }
            return cw + this.padding.left + this.padding.right + this.margin.left + this.margin.right + this.borderWidths.left + this.borderWidths.right
        }

        override fun layout(x: Short, y: Short, width: UShort, height: UShort) {
            base.layout(x, y, width, height)
            if (this.child != null) {
                var c = this.child
                c.layout(this.margin.left + this.borderWidths.left + this.padding.left, this.margin.top + this.borderWidths.top + this.padding.top, this.innerWidth().toUShort(), this.innerHeight().toUShort())
            }
        }

        override fun paintAll(graphics: Graphics) {
            var b1 = graphics.shouldRepaintAll()
            var b2 = this.getRepaintRequested()

            // Phase 1: paint the panel itself (background + border) inside a
            // clip that excludes the margin. Clip and translate must be pushed
            // together so descendants' createInnerClipRect math stays in sync
            // with the running translate origin.
            var ix = this.x + this.margin.left
            var iy = this.y + this.margin.top
            var viewWidth = this.width.toShort() - this.margin.left - this.margin.right
            var viewHeight = this.height.toShort() - this.margin.top - this.margin.bottom

            var currentClip = graphics.getCurrentClipRect()
            var viewClipRect: ClipRect = currentClip.createInnerClipRect(ix, iy, viewWidth.toUShort(), viewHeight.toUShort())
            graphics.pushClipRect(viewClipRect)

            if (b1 || b2) {
                graphics.translate(ix, iy)
                this.paint(graphics)
                graphics.translate(-ix, -iy)
            }
            this.markAsPainted()

            graphics.popClipRect()

            // Phase 2: paint the child. The translate is by the panel's outer
            // (x, y) — the child was laid out at (margin.l + border.l + padding.l,
            // margin.t + border.t + padding.t) inside that — so the clip pushed
            // here must match: outer (x, y, width, height). Mirrors ViewGroup.paintAll.
            // Always walk the child so its own partial repaint reaches it
            // even when the panel itself isn't repainting.
            if (this.child != null) {
                ix = this.x
                iy = this.y

                viewClipRect = currentClip.createInnerClipRect(ix, iy, this.width, this.height)
                graphics.pushClipRect(viewClipRect)

                graphics.translate(ix, iy)
                this.child.paintAll(graphics)
                graphics.translate(-ix, -iy)

                graphics.popClipRect()
            }
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            var x1 = 0S
            var x2 = this.width.toShort() - (this.margin.right + this.margin.left + 1S)
            var y1 = 0S
            var y2 = this.height.toShort() - (this.margin.bottom + this.margin.top + 1S)

            var borderPens = this.borderPens

            // Background bl,bt - w-br,h-bb
            graphics.setForegroundPen(this.backgroundPen)
            graphics.fillRect(x1, y1, x2, y2)

            if (this.drawBorder) {
                this.paintNativeBorder(graphics, borderPens)
            }
        }

        fun setChild(child: View) {
            this.child = child
            if (child != null) {
                if (this.getViewContext() != null) {
                    child.onAttach(this.getViewContext())
                }
            } else {
                child.onDetach()
            }
        }

        fun getChild(): View {
            return this.child
        }

        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            // Same rationale as ViewGroup.onMouseEvent: mouse-up has
            // to reach the wrapped child even when the cursor has
            // moved off the panel, otherwise a drag started inside
            // the panel (e.g. a ScrollView thumb) never sees the
            // release and stays latched.
            if (this.contains(x, y) || type == MouseEventType.up) {
                var c = this.child
                var lx = x - c.x
                var ly = y - c.y

                var consumed = c.onMouseEvent(type, button, lx, ly)
                if (consumed) {
                    return consumed
                }
            }
            return false
        }

        // ViewGroup forwards keyboard events to its children; Panel
        // holds a single child but isn't a ViewGroup, so without this
        // override keystrokes never reach things like a TextEditor
        // nested inside a Panel.
        override fun onKeyboardEvent(type: KeyboardEventType, keyCode: UShort, keyChar: UShort): Bool {
            var c = this.child
            if (c != null) {
                return c.onKeyboardEvent(type, keyCode, keyChar)
            }
            return false
        }

    }
}

