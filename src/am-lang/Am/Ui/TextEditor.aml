namespace Am.Ui
{
    // Minimal multi-line text editor with incremental repaints.
    //
    // Background and border are intentionally not painted — the editor
    // composites onto whatever container holds it (set fillBackground
    // = true if you want the editor to wipe its own area).
    //
    // The render loop calls drawLine() for each visible line so a
    // syntax-highlighting subclass can override just that hook later.
    //
    // Editing operations queue two pieces of state for the next paint:
    //
    //   1. A *pending scroll* — a single ScrollRaster operation that
    //      shifts a range of rows up or down using the blitter. Used by
    //      Enter / Backspace-across-line so we don't have to re-render
    //      every line below the cursor when one row is inserted/removed.
    //
    //   2. A *dirty line range* — the inclusive line indices whose text
    //      actually changed (or whose cursor mark needs to move). Only
    //      these lines are re-rasterised on the next paint.
    //
    // A full repaint (dirtyLineFrom == -1) still happens on setText(),
    // on resize, when shouldRepaintAll() is set on the graphics, or
    // when two scrolls would overlap in one paint cycle.
    //
    // Current editing support:
    //   - left / right / up / down arrows move the cursor
    //   - typing inserts printable ASCII at the cursor
    //   - backspace removes the char before the cursor (joins lines)
    //   - return inserts a new line and splits the current one
    //
    // Limitations: no scrollback past the editor's height (content past
    // the bottom is just clipped), no focus system. Left-click moves the
    // cursor to the character cell under the pointer.
    class TextEditor() : View {
        import Am.Lang
        import Am.Collections

        var font: Font
        var textPen: UByte = 1UB
        var cursorPen: UByte = 1UB
        var fillBackground: Bool = false
        var backgroundPen: UByte = 0UB

        // Scrollbar pens. Defaults match the historical "host pens"
        // colours so untouched code keeps rendering the same way;
        // themed callers swap these for editor-appropriate greys.
        var scrollbarThumbPen: UByte = 1UB
        var scrollbarTrackPen: UByte = 0UB
        var scrollbarThumbHoverPen: UByte = 1UB

        // Tab character render width, in pixels (not "tab stops" — a
        // tab is a fixed pixel advance, matching the user's chosen
        // editor convention). Used everywhere we measure or draw a
        // line, so colForPixelX / cursor X / segment drawing all stay
        // in sync.
        var tabWidthPx: Short = 4S

        // Horizontal skip distance for Shift+Left / Shift+Right.
        // Cursor advances by this many cols at once, clamped to the
        // start / end of the CURRENT line (no wrap into siblings).
        var horizontalSkipCols: Int = 5

        private static const SCROLLBAR_W: Short = 10S
        private static const MIN_THUMB_H: Short = 16S
        private static const THUMB_INSET: Short = 1S

        // Thumb hover / drag state. Same shape as ScrollView's, but
        // local to the editor because TextEditor manages its own
        // scrolling (incremental ScrollRaster + dirty-line book-
        // keeping) rather than delegating to a ScrollView wrapper.
        private var thumbHovered: Bool = false
        private var draggingThumb: Bool = false
        private var dragMouseStartY: Short = 0S
        private var dragScrollStartLine: Int = 0
        // useOffscreen routes paints through the window's screen-sized
        // offscreen buffer for flicker-free rendering. The offscreen path
        // currently always does a full content render — the incremental
        // scroll/dirty pipeline only kicks in for the direct (visible)
        // render path.
        var useOffscreen: Bool = false

        // One String per line. Always contains at least one entry (an
        // empty string for the initial "" state) so cursor maths can
        // assume currentLine() is non-null.
        var lines: List<String> = TextEditor.singleEmptyLine()

        private var cursorLine: Int = 0
        private var cursorCol: Int = 0

        // First line index visible at the top of the viewport. The
        // renderer subtracts this from each line's index when computing
        // its on-screen y position, so lines above scrollLine are
        // outside the visible area and are skipped. Auto-advanced by
        // ensureCursorVisible() whenever the cursor would otherwise
        // move off-screen.
        private var scrollLine: Int = 0

        // Fired after every user-initiated edit (insertChar /
        // insertNewLine / backspace). Does NOT fire on setText —
        // setText is the load-from-disk pathway and should not mark a
        // buffer dirty. Consumers (the IDE) use this to flip the
        // owning tab's dirty flag.
        var contentChangeListener: () => Bool = null

        // Fired whenever cursorLine or cursorCol changes — including
        // on setText (which moves the cursor back to 0,0) so a tab
        // switch can immediately resync any external display. Used
        // by the IDE to keep the status-bar Ln/Col indicator live.
        var cursorChangeListener: (line: Int, col: Int) => Bool = null

        // Incremental-repaint state. -1 = no pending partial repaint, do
        // a full render on the next paint() (the default state after
        // every paint cycle).
        private var dirtyLineFrom: Int = -1
        private var dirtyLineTo: Int = -1
        // Sticky "next paint must be a full render" flag. Needed
        // separately from `dirtyLineFrom == -1` because a subsequent
        // partial-dirty call (e.g. an extra auto-repeated cursor move
        // arriving before the paint cycle runs) would otherwise
        // overwrite the -1 sentinel and silently downgrade the next
        // paint to a partial one — leaving any line that wasn't in
        // the new dirty range showing stale post-scroll content.
        private var pendingFullRepaint: Bool = false
        // Pending scroll: shift the rows starting at pendingScrollLineFrom
        // by pendingScrollDy pixels (positive = down, negative = up).
        // pendingScrollLineFrom == -1 means no scroll queued.
        private var pendingScrollLineFrom: Int = -1
        private var pendingScrollDy: Short = 0S

        private static fun singleEmptyLine(): List<String> {
            var l = new List<String>()
            l.add("")
            return l
        }

        // -------- incremental-repaint bookkeeping --------

        private fun markDirtyLine(line: Int) {
            this.markDirty(line, line)
        }

        // Union the existing dirty range with [lo, hi].
        private fun markDirty(lo: Int, hi: Int) {
            if (this.dirtyLineFrom < 0 || lo < this.dirtyLineFrom) {
                this.dirtyLineFrom = lo
            }
            if (hi > this.dirtyLineTo) {
                this.dirtyLineTo = hi
            }
        }

        // Tell the next paint to redraw both the previous cursor's line
        // (to erase the old cursor mark) and the new cursor's line.
        private fun markCursorMoveDirty(oldLine: Int) {
            var newLine = this.cursorLine
            if (oldLine == newLine) {
                this.markDirtyLine(newLine)
                return
            }
            if (oldLine < newLine) {
                this.markDirty(oldLine, newLine)
            } else {
                this.markDirty(newLine, oldLine)
            }
        }

        private fun forceFullRepaint() {
            this.pendingFullRepaint = true
            this.dirtyLineFrom = -1
            this.dirtyLineTo = -1
            this.pendingScrollLineFrom = -1
            this.pendingScrollDy = 0S
        }

        // Composing two scrolls into one ScrollRaster correctly is
        // fiddly — when a second op tries to scroll while one is already
        // pending, we just fall back to a full repaint for that frame.
        private fun queueScroll(fromLine: Int, dy: Short) {
            if (this.pendingScrollLineFrom >= 0) {
                this.forceFullRepaint()
                return
            }
            this.pendingScrollLineFrom = fromLine
            this.pendingScrollDy = dy
        }

        // How many full lines fit inside the current viewport. Used by
        // ensureCursorVisible() and Page Up / Page Down handling.
        // Conservatively rounds down so partially-clipped trailing
        // lines aren't counted as fully visible.
        private fun visibleLineCount(): Int {
            var lh = this.getLineHeight()
            if (lh <= 0S) {
                return 1
            }
            var n = this.height.toShort() / lh
            if (n < 1S) {
                return 1
            }
            return n.toInt()
        }

        // -------- scrollbar geometry --------

        private fun needsScrollbar(): Bool {
            return this.lines.getSize() > this.visibleLineCount()
        }

        private fun scrollbarX(): Short {
            return this.width.toShort() - TextEditor.SCROLLBAR_W
        }

        // Width of the text area, excluding the scrollbar lane when
        // one is visible. Used by renderers + scrollRect so the
        // scrollbar pixels aren't shifted along with the text rows.
        private fun viewportWidth(): Short {
            var w = this.width.toShort()
            if (this.needsScrollbar()) {
                w = w - TextEditor.SCROLLBAR_W
            }
            return w
        }

        private fun maxScrollLine(): Int {
            var m = this.lines.getSize() - this.visibleLineCount()
            if (m < 0) {
                return 0
            }
            return m
        }

        private fun thumbHeight(): Short {
            var vpH = this.height.toShort().toInt()
            var visible = this.visibleLineCount()
            var total = this.lines.getSize()
            if (total <= 0) {
                return TextEditor.MIN_THUMB_H
            }
            // Visible-fraction → thumb-height mapping. Promote to
            // Int so the (vpH * visible) product doesn't overflow on
            // long viewports.
            var th = (vpH * visible) / total
            if (th < TextEditor.MIN_THUMB_H.toInt()) {
                th = TextEditor.MIN_THUMB_H.toInt()
            }
            if (th > vpH) {
                th = vpH
            }
            return th.toShort()
        }

        private fun thumbY(): Short {
            var maxS = this.maxScrollLine()
            if (maxS <= 0) {
                return 0S
            }
            var travel = (this.height.toShort() - this.thumbHeight()).toInt()
            if (travel <= 0) {
                return 0S
            }
            var ty = (this.scrollLine * travel) / maxS
            return ty.toShort()
        }

        private fun isPointOverThumb(x: Short, y: Short): Bool {
            if (!this.needsScrollbar()) {
                return false
            }
            if (x < this.scrollbarX()) {
                return false
            }
            var ty = this.thumbY()
            var th = this.thumbHeight()
            return y >= ty && y < ty + th
        }

        // Synchronous repaint helper. Mirrors ScrollView's — drag
        // updates need to land in the visible window during the
        // drag, not after the next event-loop tick.
        private fun forceRepaintNow() {
            this.forceFullRepaint()
            this.requestRepaint()
            var w = this.getWindow()
            if (w != null) {
                w.repaint()
            }
        }

        private fun setThumbHovered(hovered: Bool) {
            if (this.thumbHovered == hovered) {
                return
            }
            this.thumbHovered = hovered
            this.forceRepaintNow()
        }

        private fun paintScrollbar(graphics: Graphics) {
            if (!this.needsScrollbar()) {
                return
            }
            var sbX = this.scrollbarX()
            var sbW = TextEditor.SCROLLBAR_W
            var vpH = this.height.toShort()

            graphics.setForegroundPen(this.scrollbarTrackPen)
            graphics.fillRect(sbX, 0S, (sbX + sbW) - 1S, vpH - 1S)

            var ty = this.thumbY()
            var th = this.thumbHeight()
            var thumbPen = this.scrollbarThumbPen
            if (this.thumbHovered || this.draggingThumb) {
                thumbPen = this.scrollbarThumbHoverPen
            }
            graphics.setForegroundPen(thumbPen)
            graphics.fillRect((sbX + TextEditor.THUMB_INSET), ty, ((sbX + sbW) - TextEditor.THUMB_INSET) - 1S, (ty + th) - 1S)
        }

        // Adjust scrollLine so the cursor sits inside the viewport.
        // Called after every cursor move (arrows, click, insert,
        // backspace, page nav). Returns true if scrollLine actually
        // changed — caller can then force a full repaint to redraw the
        // newly-visible band of lines.
        private fun ensureCursorVisible(): Bool {
            var oldScroll = this.scrollLine
            if (this.cursorLine < this.scrollLine) {
                this.scrollLine = this.cursorLine
            } else {
                var visible = this.visibleLineCount()
                var lastVisible = (this.scrollLine + visible) - 1
                if (this.cursorLine > lastVisible) {
                    this.scrollLine = (this.cursorLine - visible) + 1
                }
            }
            if (this.scrollLine < 0) {
                this.scrollLine = 0
            }
            return this.scrollLine != oldScroll
        }

        // -------- public API --------

        fun setText(text: String) {
            var newLines = new List<String>()
            if (text != null && !text.isEmpty()) {
                var arr = text.split(0x000AUS)
                var i = 0
                while (i < arr.length()) {
                    newLines.add(arr[i])
                    i++
                }
            }
            if (newLines.getSize() == 0) {
                newLines.add("")
            }
            this.lines = newLines
            this.cursorLine = 0
            this.cursorCol = 0
            this.scrollLine = 0
            this.forceFullRepaint()
            this.requestRepaint()
            this.fireCursorChanged()
        }

        fun getText(): String {
            var sb = new StringBuilder()
            var i = 0
            while (i < this.lines.getSize()) {
                if (i > 0) {
                    sb.addChar(0x000AUS)
                }
                sb.add(this.lines.get(i))
                i++
            }
            return sb.toString()
        }

        fun getLineCount(): Int {
            return this.lines.getSize()
        }

        fun getUsedFont(): Font {
            if (this.font != null) {
                return this.font
            }
            var vc = this.getViewContext()
            if (vc != null) {
                return vc.getWindow().font
            }
            return null
        }

        private fun getLineHeight(): Short {
            var f = this.getUsedFont()
            if (f != null) {
                return f.getSize().toShort()
            }
            var vc = this.getViewContext()
            if (vc != null) {
                return vc.getWindow().getCurrentFontSize().toShort()
            }
            return 8S
        }

        override fun minWidth(): Short {
            return 0S
        }

        override fun minHeight(): Short {
            return this.getLineHeight()
        }

        private fun currentLine(): String {
            if (this.cursorLine < 0 || this.cursorLine >= this.lines.getSize()) {
                return ""
            }
            return this.lines.get(this.cursorLine)
        }

        private fun clampCursorCol() {
            var len = this.currentLine().length()
            if (this.cursorCol < 0) {
                this.cursorCol = 0
            } else if (this.cursorCol > len) {
                this.cursorCol = len
            }
        }

        // -------- cursor moves --------

        private fun moveCursorLeft() {
            var oldLine = this.cursorLine
            if (this.cursorCol > 0) {
                this.cursorCol = this.cursorCol - 1
            } else if (this.cursorLine > 0) {
                this.cursorLine = this.cursorLine - 1
                this.cursorCol = this.currentLine().length()
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun moveCursorRight() {
            var oldLine = this.cursorLine
            var lineLen = this.currentLine().length()
            if (this.cursorCol < lineLen) {
                this.cursorCol = this.cursorCol + 1
            } else if (this.cursorLine < (this.lines.getSize() - 1)) {
                this.cursorLine = this.cursorLine + 1
                this.cursorCol = 0
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun moveCursorUp() {
            var oldLine = this.cursorLine
            if (this.cursorLine > 0) {
                this.cursorLine = this.cursorLine - 1
                this.clampCursorCol()
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun moveCursorDown() {
            var oldLine = this.cursorLine
            if (this.cursorLine < (this.lines.getSize() - 1)) {
                this.cursorLine = this.cursorLine + 1
                this.clampCursorCol()
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        // Skip Left / Skip Right — Shift+arrow horizontal. Jumps
        // `horizontalSkipCols` cols at a time, clamped to the current
        // line. Crucially does NOT wrap into the previous / next line
        // the way moveCursorLeft / moveCursorRight do — at the line
        // end, the cursor just stops.
        private fun skipLeft() {
            var oldLine = this.cursorLine
            var newCol = this.cursorCol - this.horizontalSkipCols
            if (newCol < 0) {
                newCol = 0
            }
            if (newCol == this.cursorCol) {
                return
            }
            this.cursorCol = newCol
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun skipRight() {
            var oldLine = this.cursorLine
            var lineLen = this.currentLine().length()
            var newCol = this.cursorCol + this.horizontalSkipCols
            if (newCol > lineLen) {
                newCol = lineLen
            }
            if (newCol == this.cursorCol) {
                return
            }
            this.cursorCol = newCol
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        // Page Up / Page Down — move the cursor by one viewport's worth
        // of lines, clamped to the buffer. After moving we always force
        // a full repaint because we know the viewport shifted (saves
        // the incremental-repaint pipeline from having to reason about
        // a multi-line jump combined with a scroll).
        private fun pageDown() {
            var oldLine = this.cursorLine
            var step = this.visibleLineCount()
            var target = this.cursorLine + step
            var lastLine = this.lines.getSize() - 1
            if (target > lastLine) {
                target = lastLine
            }
            this.cursorLine = target
            this.clampCursorCol()
            this.markCursorMoveDirty(oldLine)
            this.ensureCursorVisible()
            this.forceFullRepaint()
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun pageUp() {
            var oldLine = this.cursorLine
            var step = this.visibleLineCount()
            var target = this.cursorLine - step
            if (target < 0) {
                target = 0
            }
            this.cursorLine = target
            this.clampCursorCol()
            this.markCursorMoveDirty(oldLine)
            this.ensureCursorVisible()
            this.forceFullRepaint()
            this.requestRepaint()
            this.fireCursorChanged()
        }

        // -------- edits --------

        private fun insertChar(c: UShort) {
            var line = this.currentLine()
            var sb = new StringBuilder()
            if (this.cursorCol > 0) {
                sb.add(line.substring(0UI, this.cursorCol.toUInt()))
            }
            sb.addChar(c)
            if (this.cursorCol < line.length()) {
                sb.add(line.substringToEnd(this.cursorCol.toUInt()))
            }
            this.lines.set(this.cursorLine, sb.toString())
            this.cursorCol = this.cursorCol + 1
            this.markDirtyLine(this.cursorLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
        }

        private fun insertNewLine() {
            var oldCursorLine = this.cursorLine
            var line = this.currentLine()
            var before = ""
            var after = ""
            if (this.cursorCol > 0) {
                before = line.substring(0UI, this.cursorCol.toUInt())
            }
            if (this.cursorCol < line.length()) {
                after = line.substringToEnd(this.cursorCol.toUInt())
            }
            this.lines.set(this.cursorLine, before)
            this.lines.insertAt(this.cursorLine + 1, after)
            this.cursorLine = this.cursorLine + 1
            this.cursorCol = 0

            // If the new cursor row would otherwise scroll off the
            // bottom of the viewport, advance scrollLine and do a full
            // repaint — the incremental scroll-raster path can't
            // represent "insert a line AND scroll the viewport" in a
            // single frame correctly, so we fall back here.
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            } else {
                // Shift everything below the split point DOWN by one row
                // so we don't have to re-render those lines, then
                // re-render the two lines that actually changed (split
                // source + new line).
                var lineHeight = this.getLineHeight()
                this.queueScroll(oldCursorLine + 1, lineHeight)
                this.markDirty(oldCursorLine, oldCursorLine + 1)
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
        }

        private fun fireContentChanged() {
            var cb = this.contentChangeListener
            if (cb != null) {
                cb()
            }
        }

        private fun fireCursorChanged() {
            // Defensive re-clamp before reporting. Every caller already
            // calls clampCursorCol() after a line change, but if any
            // path ever leaks a stale cursorCol (e.g. pageUp into a
            // shorter line where the clamp didn't take), the status
            // bar would otherwise display a column that doesn't match
            // where the cursor actually renders. clampCursorCol() is
            // a no-op when cursorCol is already in [0, lineLength].
            this.clampCursorCol()
            var cb = this.cursorChangeListener
            if (cb != null) {
                cb(this.cursorLine, this.cursorCol)
            }
        }

        fun getCursorLine(): Int {
            return this.cursorLine
        }

        fun getCursorCol(): Int {
            return this.cursorCol
        }

        private fun backspace() {
            var hadChange = false
            if (this.cursorCol > 0 || this.cursorLine > 0) {
                hadChange = true
            }
            if (this.cursorCol > 0) {
                var line = this.currentLine()
                var sb = new StringBuilder()
                sb.add(line.substring(0UI, (this.cursorCol - 1).toUInt()))
                if (this.cursorCol < line.length()) {
                    sb.add(line.substringToEnd(this.cursorCol.toUInt()))
                }
                this.lines.set(this.cursorLine, sb.toString())
                this.cursorCol = this.cursorCol - 1
                this.markDirtyLine(this.cursorLine)
                if (this.ensureCursorVisible()) {
                    this.forceFullRepaint()
                }
            } else if (this.cursorLine > 0) {
                // Merge: previous line absorbs the current one, lines
                // below shift UP by one row.
                var mergedAt = this.cursorLine - 1
                var prev = this.lines.get(this.cursorLine - 1)
                var cur = this.currentLine()
                this.cursorCol = prev.length()
                this.lines.set(this.cursorLine - 1, prev + cur)
                this.lines.removeAt(this.cursorLine)
                this.cursorLine = this.cursorLine - 1

                // If the merge would pull the cursor above the
                // viewport (cursor moved up to a line that's now off
                // the top), advance scrollLine to match and do a full
                // repaint — the scroll-raster path can't represent
                // "remove a line AND shift the viewport up" in a
                // single frame.
                if (this.ensureCursorVisible()) {
                    this.forceFullRepaint()
                } else {
                    var lineHeight = this.getLineHeight()
                    this.queueScroll(mergedAt + 1, 0S - lineHeight)
                    var visible = (this.height.toShort() / lineHeight).toInt() + 1
                    this.markDirty(mergedAt, mergedAt + visible)
                }
            }
            this.requestRepaint()
            if (hadChange) {
                this.fireContentChanged()
                this.fireCursorChanged()
            }
        }

        // -------- rendering --------

        // Pixel width of `s` with tabs counted as `tabWidthPx`.
        // Splits the string on tab and sums each segment's natural
        // width plus one tab gap between consecutive segments.
        //
        // Two flavours because the editor measures from two
        // contexts: the paint path has Graphics in hand (and
        // Graphics always has a font set on the underlying
        // RastPort, even before our `font` field is populated by
        // onAttach); the click path only has the Font reference.
        // Falling back to Graphics in the paint path matters — on
        // the very first paint after a file is opened, getUsedFont()
        // can still return null, and the old "Font-only" measure
        // returned 0 here, which made the right-of-text fill cover
        // the entire row and erase the line we'd just drawn.
        //
        // Fast path: a line with no tab is a single
        // calculateStringWidth call, no array allocation.
        private fun measureLineWidthG(graphics: Graphics, s: String): Short {
            if (s == null || s.length() == 0) {
                return 0S
            }
            if (s.indexOf("\t") < 0) {
                return graphics.calculateStringWidth(s).toShort()
            }
            var parts = s.split(0x0009US)
            var w = 0S
            var i = 0
            var n = parts.length()
            while (i < n) {
                var seg = parts[i]
                if (seg.length() > 0) {
                    w = w + graphics.calculateStringWidth(seg).toShort()
                }
                if (i < n - 1) {
                    w = w + this.tabWidthPx
                }
                i = i + 1
            }
            return w
        }

        private fun measureLineWidthF(f: Font, s: String): Short {
            if (f == null || s == null || s.length() == 0) {
                return 0S
            }
            if (s.indexOf("\t") < 0) {
                return f.calculateStringWidth(s).toShort()
            }
            var parts = s.split(0x0009US)
            var w = 0S
            var i = 0
            var n = parts.length()
            while (i < n) {
                var seg = parts[i]
                if (seg.length() > 0) {
                    w = w + f.calculateStringWidth(seg).toShort()
                }
                if (i < n - 1) {
                    w = w + this.tabWidthPx
                }
                i = i + 1
            }
            return w
        }

        // Subclasses override this when they want to render the line as
        // multiple coloured runs (syntax highlighting). Default draws
        // the entire line with `this.textPen`, with tab characters
        // expanded to a `tabWidthPx`-wide gap.
        open fun drawLine(graphics: Graphics, line: String, lineIndex: Int, x: Short, y: Short) {
            graphics.setForegroundPen(this.textPen)
            // Fast path: no tabs, just dump the line. drawString is
            // a single native call vs. one per segment.
            if (line.indexOf("\t") < 0) {
                graphics.drawString(line, x, y)
                return
            }
            var parts = line.split(0x0009US)
            var curX = x
            var i = 0
            var n = parts.length()
            while (i < n) {
                var seg = parts[i]
                if (seg.length() > 0) {
                    graphics.drawString(seg, curX, y)
                    curX = curX + graphics.calculateStringWidth(seg).toShort()
                }
                if (i < n - 1) {
                    curX = curX + this.tabWidthPx
                }
                i = i + 1
            }
        }

        // Render every visible line — used for full repaints (initial
        // paint, expose, setText, etc.). renderLines paints each row
        // with JAM2 (so each glyph cell carries its own bg) and the
        // right-of-text fill, and fillBelowLastLine covers the rows
        // past the buffer end — so every visible pixel is touched
        // without needing an extra full-viewport clear up front. The
        // clear is what was causing the visible flash on every scroll.
        private fun renderContent(graphics: Graphics) {
            this.renderLines(graphics, 0, this.lines.getSize() - 1, true)
            this.fillBelowLastLine(graphics)
        }

        // Render a clamped sub-range of lines. Used by incremental
        // updates after ScrollRaster has done the bulk shift.
        private fun renderLineRange(graphics: Graphics, fromLine: Int, toLine: Int) {
            this.renderLines(graphics, fromLine, toLine, false)
        }

        // The shared rendering loop. The trailing "fillBelowLastLine"
        // pass is only needed when we're doing a full repaint — partial
        // repaints know they don't need to touch the area below the
        // visible lines.
        private fun renderLines(graphics: Graphics, fromLine: Int, toLine: Int, isFullRepaint: Bool) {
            graphics.setBackgroundPen(this.backgroundPen)

            var f = this.getUsedFont()
            if (f != null) {
                graphics.setFont(f)
            }

            var lineHeight = this.getLineHeight()
            var availableHeight = this.height.toShort()
            // Excludes the scrollbar lane when one is visible — keep
            // the right-of-text fill from painting over the bar.
            var viewWidth = this.viewportWidth()

            // Clamp the requested range to lines that fall inside the
            // current viewport. `scrollLine` is the line currently at
            // y=0; anything below it (i < scrollLine) is above the
            // viewport, anything past `scrollLine + visibleCount` is
            // below the viewport. Both ends are no-ops to render.
            var lo = fromLine
            if (lo < this.scrollLine) { lo = this.scrollLine }
            var hi = toLine
            var lastLine = this.lines.getSize() - 1
            if (hi > lastLine) { hi = lastLine }

            var i = lo
            while (i <= hi) {
                // y is in viewport coords — i=scrollLine renders at y=0.
                var y = ((i - this.scrollLine) * lineHeight.toInt()).toShort()
                if (y >= availableHeight) {
                    return
                }
                var line = this.lines.get(i)
                var lineBottom = (y + lineHeight) - 1S

                this.drawLine(graphics, line, i, 0S, y)

                if (this.fillBackground) {
                    // Tabs expand to a fixed pixel width, so the line's
                    // on-screen extent isn't just calculateStringWidth.
                    // Go via graphics — our `f` reference can still be
                    // null on the very first paint after a file opens,
                    // and a 0-width result here would make the fill
                    // cover the whole row and erase the text we just
                    // drew (was leaving the editor blank until the
                    // first scroll forced a font set elsewhere).
                    var textWidth = this.measureLineWidthG(graphics, line)
                    if (textWidth < viewWidth) {
                        graphics.setForegroundPen(this.backgroundPen)
                        graphics.fillRect(textWidth, y, viewWidth - 1S, lineBottom)
                    }
                }

                if (i == this.cursorLine) {
                    var cursorX = 0S
                    if (this.cursorCol > 0) {
                        var before = line.substring(0UI, this.cursorCol.toUInt())
                        cursorX = this.measureLineWidthG(graphics, before)
                    }
                    graphics.setForegroundPen(this.cursorPen)
                    graphics.fillRect(cursorX, y, cursorX, lineBottom)
                }
                i = i + 1
            }
        }

        private fun fillBelowLastLine(graphics: Graphics) {
            if (!this.fillBackground) {
                return
            }
            var lineHeight = this.getLineHeight()
            var availableHeight = this.height.toShort()
            // Last line's y is computed against scrollLine so that the
            // fill aligns with whatever the visible lines actually
            // ended at.
            var y = ((this.lines.getSize() - this.scrollLine) * lineHeight.toInt()).toShort()
            if (y < 0S) {
                y = 0S
            }
            if (y < availableHeight) {
                graphics.setForegroundPen(this.backgroundPen)
                graphics.fillRect(0S, y, this.viewportWidth() - 1S, availableHeight - 1S)
            }
        }

        // ScrollRaster the strip starting at pendingScrollLineFrom down to
        // the bottom of the visible editor by pendingScrollDy pixels.
        // After this the pixels for the unchanged lines are already in
        // the right place, and only the dirty lines need rendering.
        //
        // `pendingScrollLineFrom` is an *absolute* line index, but the
        // RastPort y axis is viewport-relative — we have to subtract
        // `scrollLine` before scaling by lineHeight, otherwise we'd
        // scroll a band of pixels that has nothing to do with the
        // edited rows (this was leaving stale text below the edit
        // point until the cursor stepped through it).
        private fun applyPendingScroll(graphics: Graphics) {
            var lineHeight = this.getLineHeight()
            var availableHeight = this.height.toShort()
            var relLine = this.pendingScrollLineFrom - this.scrollLine
            if (relLine < 0) {
                relLine = 0
            }
            var startY = (relLine * lineHeight.toInt()).toShort()
            if (startY >= availableHeight) {
                return
            }
            var h = availableHeight - startY
            if (h <= 0S) {
                return
            }
            // viewportWidth excludes the scrollbar lane so the bar
            // pixels stay put while the text rows shift.
            graphics.scrollRect(0S, startY, this.viewportWidth().toUShort(), h.toUShort(), 0S, this.pendingScrollDy, this.backgroundPen)
        }

        // Render via the window-level offscreen buffer (no flicker, but
        // also no incremental updates — every paint re-renders all
        // visible lines into offscreen and blits the rect back).
        private fun renderViaOffscreen(graphics: Graphics) {
            var window = this.getViewContext().getWindow()
            var off = window.getOffscreenGraphics()

            var absX = graphics.getTranslateX()
            var absY = graphics.getTranslateY()

            off.translate(absX, absY)
            var clip: ClipRect = { x: absX, y: absY, width: this.width, height: this.height }
            off.pushClipRect(clip)

            this.renderContent(off)

            off.popClipRect()
            off.translate(0S - absX, 0S - absY)

            window.flushOffscreenRect(absX, absY, this.width, this.height)
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            // dirtyLineFrom < 0 used to be the only "full-repaint" signal,
            // but that bit got clobbered if a partial-dirty mark
            // arrived between forceFullRepaint() and the paint cycle.
            // pendingFullRepaint sticks across markDirty calls so a
            // post-scroll auto-repeated cursor move can't silently
            // demote the next paint to partial.
            var forceFull = graphics.shouldRepaintAll() || this.pendingFullRepaint || this.dirtyLineFrom < 0
            if (this.useOffscreen) {
                this.renderViaOffscreen(graphics)
            } else if (forceFull) {
                this.renderContent(graphics)
            } else {
                if (this.pendingScrollLineFrom >= 0 && this.pendingScrollDy != 0S) {
                    this.applyPendingScroll(graphics)
                }
                this.renderLineRange(graphics, this.dirtyLineFrom, this.dirtyLineTo)
            }

            // Re-stamp the scrollbar on every paint — partial paints
            // never touch the lane (viewportWidth() excludes it), so
            // we just paint the bar unconditionally to keep the thumb
            // in sync with scrollLine + total line count.
            this.paintScrollbar(graphics)

            // Consume the partial-repaint state — the next paint starts
            // from "full repaint" again unless an edit op reschedules.
            this.pendingFullRepaint = false
            this.dirtyLineFrom = -1
            this.dirtyLineTo = -1
            this.pendingScrollLineFrom = -1
            this.pendingScrollDy = 0S
        }

        // -------- mouse positioning --------

        // Find the column index in `line` whose character cell most closely
        // aligns with `pixelX`. Walks one character at a time using the
        // font's own glyph-width measurement so the math stays correct for
        // proportional fonts. Boundary heuristic: place the cursor before
        // the character whose midpoint is past `pixelX`.
        private fun colForPixelX(line: String, pixelX: Short): Int {
            if (pixelX <= 0S || line.length() == 0) {
                return 0
            }
            var f = this.getUsedFont()
            if (f == null) {
                return 0
            }
            var len = line.length()
            var prevWidth = 0S
            var col = 0
            while (col < len) {
                var prefix = line.substring(0UI, (col + 1).toUInt())
                // Tab-aware so a click after a tab lands in the
                // right column (the prior measurement used raw
                // calculateStringWidth, which counted tabs as the
                // font's default glyph width).
                var curWidth = this.measureLineWidthF(f, prefix)
                var glyphMid = (prevWidth + curWidth) / 2S
                if (pixelX < glyphMid) {
                    return col
                }
                prevWidth = curWidth
                col = col + 1
            }
            return len
        }

        // Click-to-position. Left mouse-down inside the editor moves the
        // cursor to the character cell under the pointer. Mid-button and
        // motion events fall through to the base handler.
        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            // Active thumb drag — track move/up regardless of where
            // the cursor went so the bar keeps following.
            if (this.draggingThumb) {
                if (type == MouseEventType.move) {
                    var dy = (y - this.dragMouseStartY).toInt()
                    var travel = (this.height.toShort() - this.thumbHeight()).toInt()
                    if (travel > 0) {
                        var maxS = this.maxScrollLine()
                        var newScroll = this.dragScrollStartLine + (dy * maxS) / travel
                        if (newScroll < 0) { newScroll = 0 }
                        if (newScroll > maxS) { newScroll = maxS }
                        if (newScroll != this.scrollLine) {
                            this.scrollLine = newScroll
                            this.forceRepaintNow()
                        }
                    }
                    return true
                }
                if (type == MouseEventType.up) {
                    this.draggingThumb = false
                    this.forceRepaintNow()
                    return true
                }
            }

            if (!this.contains(x, y)) {
                this.setThumbHovered(false)
                return base.onMouseEvent(type, button, x, y)
            }

            // Hover lighting — runs on every in-bounds move.
            if (type == MouseEventType.move) {
                this.setThumbHovered(this.isPointOverThumb(x, y))
            }

            // Click landed in the scrollbar lane?
            if (this.needsScrollbar() && x >= this.scrollbarX()) {
                if (type == MouseEventType.down && button == MouseButton.left) {
                    var ty = this.thumbY()
                    var th = this.thumbHeight()
                    if (y >= ty && y < ty + th) {
                        this.draggingThumb = true
                        this.dragMouseStartY = y
                        this.dragScrollStartLine = this.scrollLine
                    } else {
                        // Track click — page by a viewport's worth of
                        // lines toward the click.
                        var page = this.visibleLineCount()
                        var maxS = this.maxScrollLine()
                        var newScroll = this.scrollLine
                        if (y < ty) {
                            newScroll = newScroll - page
                        } else {
                            newScroll = newScroll + page
                        }
                        if (newScroll < 0) { newScroll = 0 }
                        if (newScroll > maxS) { newScroll = maxS }
                        if (newScroll != this.scrollLine) {
                            this.scrollLine = newScroll
                            this.forceRepaintNow()
                        }
                    }
                    return true
                }
                // Other events inside the lane are swallowed so they
                // don't fall through into the cursor-positioning path
                // and move the cursor under the bar.
                return false
            }

            if (type == MouseEventType.down && button == MouseButton.left && this.contains(x, y)) {
                // Claim keyboard focus so subsequent typing routes to
                // this editor — the CliView in a bottom panel
                // otherwise keeps focus from its own click and
                // would swallow our keys.
                var vc = this.getViewContext()
                if (vc != null) {
                    var w = vc.getWindow()
                    if (w != null) {
                        w.setKeyboardFocus(this)
                    }
                }

                var oldLine = this.cursorLine
                var lineHeight = this.getLineHeight()
                var lastLine = this.lines.getSize() - 1
                if (lineHeight <= 0S) {
                    return base.onMouseEvent(type, button, x, y)
                }
                // y is in viewport coords (0 = top of editor area).
                // Add scrollLine back to recover the absolute line
                // index in the buffer.
                var newLine = (y.toInt() / lineHeight.toInt()) + this.scrollLine
                if (newLine < 0) { newLine = 0 }
                if (newLine > lastLine) { newLine = lastLine }
                var lineText = this.lines.get(newLine)
                var newCol = this.colForPixelX(lineText, x)
                this.cursorLine = newLine
                this.cursorCol = newCol
                this.markCursorMoveDirty(oldLine)
                this.requestRepaint()
                this.fireCursorChanged()
                return true
            }
            return base.onMouseEvent(type, button, x, y)
        }

        // Wheel scrolls the buffer without moving the cursor.
        // 3 lines per tick — fast enough to feel responsive on long
        // files, slow enough to land on a specific row.
        override fun onMouseWheel(deltaY: Short, x: Short, y: Short): Bool {
            if (!this.contains(x, y)) {
                return false
            }
            var totalLines = this.lines.getSize()
            var visible = this.visibleLineCount()
            var maxScroll = totalLines - visible
            if (maxScroll < 0) {
                maxScroll = 0
            }
            var newScroll = this.scrollLine + (deltaY.toInt() * 3)
            if (newScroll < 0) {
                newScroll = 0
            }
            if (newScroll > maxScroll) {
                newScroll = maxScroll
            }
            if (newScroll == this.scrollLine) {
                return true
            }
            this.scrollLine = newScroll
            this.forceFullRepaint()
            this.requestRepaint()
            return true
        }

        override fun onKeyboardEvent(type: KeyboardEventType, keyCode: UShort, keyChar: UShort): Bool {
            if (type != KeyboardEventType.down) {
                return false
            }
            // Focus gate: only consume keys when we're the focused
            // view, so typing in the terminal isn't echoed into the
            // active editor as well. A null focus means "nothing is
            // claiming keys" — in that case let the editor handle
            // so initial typing still works without a click.
            var vc = this.getViewContext()
            if (vc != null) {
                var w = vc.getWindow()
                if (w != null) {
                    var focus = w.getKeyboardFocus()
                    if (focus != null && focus != this) {
                        return false
                    }
                }
            }
            // AmigaOS raw key codes for arrows. The native handler
            // tags shifted arrows with keyChar=1 — we route Shift+Up
            // and Shift+Down to page navigation (the Amiga keyboard
            // has no dedicated PgUp/PgDn keys; this matches the
            // long-standing CED convention).
            if (keyCode == 76US && keyChar == 1US) {
                this.pageUp()
                return true
            }
            if (keyCode == 77US && keyChar == 1US) {
                this.pageDown()
                return true
            }
            // Shift+Left / Shift+Right — same keyChar=1 shift marker
            // as the page-nav arrows. Jumps several cols at a time,
            // clamped to the line — no wrap into the prev/next line.
            if (keyCode == 79US && keyChar == 1US) {
                this.skipLeft()
                return true
            }
            if (keyCode == 78US && keyChar == 1US) {
                this.skipRight()
                return true
            }
            if (keyCode == 79US) {
                this.moveCursorLeft()
                return true
            }
            if (keyCode == 78US) {
                this.moveCursorRight()
                return true
            }
            if (keyCode == 76US) {
                this.moveCursorUp()
                return true
            }
            if (keyCode == 77US) {
                this.moveCursorDown()
                return true
            }
            // ASCII char keys.
            if (keyChar == 8US) {
                this.backspace()
                return true
            }
            if (keyChar == 13US || keyChar == 10US) {
                this.insertNewLine()
                return true
            }
            // Tab — insert literal tab for now.
            if (keyChar == 9US) {
                this.insertChar(9US)
                return true
            }
            if (keyChar >= 32US && keyChar <= 126US) {
                this.insertChar(keyChar)
                return true
            }
            return false
        }
    }
}
