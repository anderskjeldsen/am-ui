namespace Am.Ui
{
    // Minimal multi-line text editor with incremental repaints.
    //
    // Background and border are intentionally not painted — the editor
    // composites onto whatever container holds it (set fillBackground
    // = true if you want the editor to wipe its own area).
    //
    // The render loop calls drawLine() for each visible line so a
    // syntax-highlighting subclass can override just that hook later.
    //
    // Editing operations queue two pieces of state for the next paint:
    //
    //   1. A *pending scroll* — a single ScrollRaster operation that
    //      shifts a range of rows up or down using the blitter. Used by
    //      Enter / Backspace-across-line so we don't have to re-render
    //      every line below the cursor when one row is inserted/removed.
    //
    //   2. A *dirty line range* — the inclusive line indices whose text
    //      actually changed (or whose cursor mark needs to move). Only
    //      these lines are re-rasterised on the next paint.
    //
    // A full repaint (dirtyLineFrom == -1) still happens on setText(),
    // on resize, when shouldRepaintAll() is set on the graphics, or
    // when two scrolls would overlap in one paint cycle.
    //
    // Current editing support:
    //   - left / right / up / down arrows move the cursor
    //   - typing inserts printable ASCII at the cursor
    //   - backspace removes the char before the cursor (joins lines)
    //   - return inserts a new line and splits the current one
    //
    // Limitations: no scrollback past the editor's height (content past
    // the bottom is just clipped), no focus system. Left-click moves the
    // cursor to the character cell under the pointer.
    class TextEditor() : View, Editable {
        import Am.Lang
        import Am.Collections

        var font: Font? = null
        var textPen: UByte = 1UB
        var cursorPen: UByte = 1UB
        var fillBackground: Bool = false
        var backgroundPen: UByte = 0UB

        // Scrollbar pens. Defaults match the historical "host pens"
        // colours so untouched code keeps rendering the same way;
        // themed callers swap these for editor-appropriate greys.
        var scrollbarThumbPen: UByte = 1UB
        var scrollbarTrackPen: UByte = 0UB
        var scrollbarThumbHoverPen: UByte = 1UB

        // Tab character render width, in pixels (not "tab stops" — a
        // tab is a fixed pixel advance, matching the user's chosen
        // editor convention). Used everywhere we measure or draw a
        // line, so colForPixelX / cursor X / segment drawing all stay
        // in sync. Default 32 = four Topaz/8 character cells (the
        // common "tab = 4 spaces" feel); themes with a wider font
        // should bump this to keep tabs visually 4 char-widths.
        var tabWidthPx: Short = 32S

        // Horizontal skip distance for Shift+Left / Shift+Right.
        // Cursor advances by this many cols at once, clamped to the
        // start / end of the CURRENT line (no wrap into siblings).
        var horizontalSkipCols: Int = 5

        // Pixels of vertical gap below each line of text. Folded
        // into getLineHeight() so layout, scrolling, cursor maths
        // and click hit-testing all see the same row stride.
        // Default 0 keeps the existing tight rendering; Program
        // bumps this on the editors it builds for visual breathing
        // room.
        var lineSpacing: Short = 0S

        private static const SCROLLBAR_W: Short = 10S
        private static const MIN_THUMB_H: Short = 16S
        private static const THUMB_INSET: Short = 1S

        // Thumb hover / drag state. Same shape as ScrollView's, but
        // local to the editor because TextEditor manages its own
        // scrolling (incremental ScrollRaster + dirty-line book-
        // keeping) rather than delegating to a ScrollView wrapper.
        private var thumbHovered: Bool = false
        private var draggingThumb: Bool = false
        private var dragMouseStartY: Short = 0S
        private var dragScrollStartLine: Int = 0
        // useOffscreen routes paints through the window's screen-sized
        // offscreen buffer for flicker-free rendering. The offscreen path
        // currently always does a full content render — the incremental
        // scroll/dirty pipeline only kicks in for the direct (visible)
        // render path.
        var useOffscreen: Bool = false

        // One String per line. Always contains at least one entry (an
        // empty string for the initial "" state) so cursor maths can
        // assume currentLine() is non-null.
        var lines: List<String> = TextEditor.singleEmptyLine()

        // Cursor position. Public so subclasses (HighlightedTextEditor)
        // can read and write directly when implementing
        // command-style edits like Ctrl+/ line-comment toggle.
        // External callers should prefer moveCursor* / setText, which
        // also fire the cursor-change listener.
        var cursorLine: Int = 0
        var cursorCol: Int = 0

        // -------- selection --------
        // Block (Amiga-speak for "selected area") spans every character
        // between the anchor at (selAnchorLine, selAnchorCol) and the
        // cursor at (cursorLine, cursorCol). Always character-flowing —
        // a multi-row block highlights the start row from the anchor
        // col to EOL, every middle row fully, and the end row from col 0
        // to the cursor col. No rectangular / column-mode rendering.
        //
        // `selMode` is a tri-state: 0 = no active selection-bound
        // gesture, 1 = "selecting" (Ctrl+B has armed the anchor or a
        // mouse drag is live, arrow keys extend the selection from the
        // anchor). When 0 and hasSelection() is also false, arrow keys
        // just move the cursor without producing a selection.
        //
        // `selDragging` is true while the left mouse button is held
        // after a press inside the editor — mouse moves while dragging
        // extend the selection.
        //
        // Theme: selectionBackgroundPen paints behind the selected
        // text. Defaults to the host's pen 7 which matches the IDE's
        // standard "selection" palette slot; non-IDE embedders can
        // override.
        var selectionBackgroundPen: UByte = 7UB
        var selAnchorLine: Int = -1
        var selAnchorCol: Int  = -1
        private var selDragging: Bool = false
        var selMode: Int = 0

        // True iff a non-collapsed selection currently exists. Used
        // by the render pass and by the IDE chrome (e.g. to gray out
        // edit menu entries when nothing is selected).
        fun hasSelection(): Bool {
            if (this.selAnchorLine < 0) {
                return false
            }
            if (this.selAnchorLine == this.cursorLine
                && this.selAnchorCol == this.cursorCol) {
                return false
            }
            return true
        }

        // Drop any active selection. Doesn't move the cursor — the
        // cursor stays where it is, the selection just "uncollapses
        // into" the cursor's current position.
        fun clearSelection() {
            this.selAnchorLine = -1
            this.selAnchorCol = -1
            this.selDragging = false
        }

        // Select the entire buffer: anchor at (0, 0), cursor at the
        // end of the last line. No-op on an empty buffer. Called
        // by Ctrl+A and by the IDE chrome's Edit → Select All.
        fun selectAll() {
            var n: Int = this.lines.getSize()
            if (n == 0) {
                return
            }
            var lastLine: String = this.lines.get(n - 1)
            var lastCol: Int = lastLine.length() as Int
            this.selAnchorLine = 0
            this.selAnchorCol  = 0
            this.cursorLine = n - 1
            this.cursorCol  = lastCol
            this.selMode = 1
            this.selDragging = false
            // Full repaint — plain requestRepaint marks only the row
            // the cursor moved TO as dirty, so lines above the cursor
            // never see the new selection state land on their glyphs.
            // The arrow-key selection-extend path uses the same
            // forceFullRepaint() call for the same reason.
            this.forceFullRepaint()
        }

        // Normalised selection bounds, returning the top-left and
        // bottom-right of the selection. Callers should check
        // hasSelection() first — when there's no selection these
        // values are meaningless. The four getters are separate
        // because AmLang doesn't have lightweight tuple returns.
        fun selStartLine(): Int {
            if (this.selAnchorLine < this.cursorLine) {
                return this.selAnchorLine
            }
            if (this.selAnchorLine > this.cursorLine) {
                return this.cursorLine
            }
            return this.selAnchorLine
        }
        fun selEndLine(): Int {
            if (this.selAnchorLine > this.cursorLine) {
                return this.selAnchorLine
            }
            if (this.selAnchorLine < this.cursorLine) {
                return this.cursorLine
            }
            return this.cursorLine
        }
        // For character selection: when the selection is on one line,
        // the start/end cols are the min/max of anchor and cursor;
        // when spanning multiple lines, the START col belongs to the
        // earlier line and the END col to the later line.
        fun selStartCol(): Int {
            if (this.selAnchorLine == this.cursorLine) {
                if (this.selAnchorCol < this.cursorCol) {
                    return this.selAnchorCol
                }
                return this.cursorCol
            }
            if (this.selAnchorLine < this.cursorLine) {
                return this.selAnchorCol
            }
            return this.cursorCol
        }
        fun selEndCol(): Int {
            if (this.selAnchorLine == this.cursorLine) {
                if (this.selAnchorCol > this.cursorCol) {
                    return this.selAnchorCol
                }
                return this.cursorCol
            }
            if (this.selAnchorLine > this.cursorLine) {
                return this.selAnchorCol
            }
            return this.cursorCol
        }
        // Per-line column range of the selection BG on `lineIdx`. Returns
        // -1 from both when the line has no selection coverage. Used by
        // drawLine (base + HighlightedTextEditor override) to switch the
        // text-bg pen between backgroundPen and selectionBackgroundPen
        // while walking chars — so each glyph paints with the right bg
        // cell.
        //
        //   - lines strictly inside [sStart, sEnd]: full text-width
        //     selection (start col 0, end col line.length()).
        //   - start row: from selStartCol() to line.length().
        //   - end row: from 0 to selEndCol().
        fun selStartColOnLine(lineIdx: Int): Int {
            if (!this.hasSelection()) {
                return -1
            }
            var sStart = this.selStartLine()
            var sEnd = this.selEndLine()
            if (lineIdx < sStart || lineIdx > sEnd) {
                return -1
            }
            if (lineIdx == sStart) {
                return this.selStartCol()
            }
            return 0
        }
        fun selEndColOnLine(lineIdx: Int): Int {
            if (!this.hasSelection()) {
                return -1
            }
            var sStart = this.selStartLine()
            var sEnd = this.selEndLine()
            if (lineIdx < sStart || lineIdx > sEnd) {
                return -1
            }
            if (lineIdx == sEnd) {
                return this.selEndCol()
            }
            return this.lines.get(lineIdx).length()
        }

        // First line index visible at the top of the viewport. The
        // renderer subtracts this from each line's index when computing
        // its on-screen y position, so lines above scrollLine are
        // outside the visible area and are skipped. Auto-advanced by
        // ensureCursorVisible() whenever the cursor would otherwise
        // move off-screen.
        private var scrollLine: Int = 0

        // Horizontal scroll offset in PIXELS (not columns — column
        // arithmetic breaks once tabs and proportional glyph widths
        // enter the picture). Each visible line is rendered at
        // x = (0 - scrollPixelX), so columns whose pixel position is
        // less than scrollPixelX fall off the left edge and the
        // viewport effectively shows a sliding window of each line.
        // Auto-advanced by the horizontal branch of
        // ensureCursorVisible() so the cursor never disappears off
        // either edge after a right-arrow / End / typing.
        //
        // Keeps a small margin of context past the cursor instead of
        // glueing it to the edge — see HSCROLL_MARGIN_PX below.
        private var scrollPixelX: Short = 0S

        // Number of pixels of breathing room kept between the cursor
        // and whichever edge it just bumped into. Without it, the
        // cursor sits right at the viewport edge after a scroll,
        // which reads as broken because the next character you type
        // appears with no visual lead-in.
        private static const HSCROLL_MARGIN_PX: Short = 16S

        // Fired after every user-initiated edit (insertChar /
        // insertNewLine / backspace). Does NOT fire on setText —
        // setText is the load-from-disk pathway and should not mark a
        // buffer dirty. Consumers (the IDE) use this to flip the
        // owning tab's dirty flag.
        var contentChangeListener: (() => Bool)? = null

        // Embedder-side find UI hooks. Ctrl+F fires
        // findRequestedListener (typically "show the find bar and
        // focus its input"); Ctrl+G fires findNextListener (step
        // through matches with whatever query the find bar last
        // held). Both are no-ops when null — the IDE wires them in
        // ensureEditor.
        var findRequestedListener: (() => Bool)? = null
        var findNextListener: (() => Bool)? = null

        // Ctrl+S — embedder-side "save this buffer". The editor
        // doesn't know its own path so it can't write to disk itself;
        // the IDE wires this in ensureEditor to the same writer the
        // File menu's Save item uses. Null = no-op (Ctrl+S falls
        // through and gets inserted as 0x13).
        var saveRequestedListener: (() => Bool)? = null

        // Last query string handed to findNext. Stored on the editor
        // so Ctrl+G can keep stepping through matches even after the
        // find bar closes. Cleared by setText (new file = new state).
        var lastFindQuery: String = ""

        // Fired whenever cursorLine or cursorCol changes — including
        // on setText (which moves the cursor back to 0,0) so a tab
        // switch can immediately resync any external display. Used
        // by the IDE to keep the status-bar Ln/Col indicator live.
        var cursorChangeListener: ((line: Int, col: Int) => Bool)? = null

        // Incremental-repaint state. -1 = no pending partial repaint, do
        // a full render on the next paint() (the default state after
        // every paint cycle).
        private var dirtyLineFrom: Int = -1
        private var dirtyLineTo: Int = -1
        // Sticky "next paint must be a full render" flag. Needed
        // separately from `dirtyLineFrom == -1` because a subsequent
        // partial-dirty call (e.g. an extra auto-repeated cursor move
        // arriving before the paint cycle runs) would otherwise
        // overwrite the -1 sentinel and silently downgrade the next
        // paint to a partial one — leaving any line that wasn't in
        // the new dirty range showing stale post-scroll content.
        private var pendingFullRepaint: Bool = false
        // Pending scroll: shift the rows starting at pendingScrollLineFrom
        // by pendingScrollDy pixels (positive = down, negative = up).
        // pendingScrollLineFrom == -1 means no scroll queued.
        private var pendingScrollLineFrom: Int = -1
        private var pendingScrollDy: Short = 0S

        // -------- undo --------
        // Bounded LIFO of pre-edit snapshots. Each editor instance has
        // its own — undo is per-file by construction. Ctrl+Z pops and
        // restores. The cap stops a long typing session from chewing
        // through Amiga RAM; the oldest entry is dropped when full.
        private var undoStack: List<UndoEntry> = new List<UndoEntry>()
        // Companion redo stack. `undo()` pushes the pre-undo state
        // here as it pops from undoStack; `redo()` reverses the flow.
        // Any fresh edit clears redoStack because a new mutation
        // invalidates the "linear" redo history — same convention as
        // every mainstream editor.
        private var redoStack: List<UndoEntry> = new List<UndoEntry>()
        private static const UNDO_CAP: Int = 100

        private static fun singleEmptyLine(): List<String> {
            var l = new List<String>()
            l.add("")
            return l
        }

        // Re-mount: every time this editor is added to an attached
        // parent (initial open or a tab switch back to it), force the
        // next paint to be full. Without this, the cursor-blink path
        // at the end of paint() leaves
        // `dirtyLineFrom == cursorLine` set for the next cycle so the
        // next paint runs as a partial repaint of just the cursor
        // row. While the editor is hidden between tabs that state
        // sits unchanged; on re-mount the first paint then repaints
        // only the cursor line, leaving the rest of the viewport
        // showing whatever was previously in the offscreen buffer
        // (typically the other tab's text). Forcing full on attach
        // makes the first paint refresh the whole viewport.
        override fun onAttach(viewContext: ViewContext) {
            base.onAttach(viewContext)
            this.forceFullRepaint()
        }

        // Not in the Tab / focusFirstIn discovery list: Tab inside an
        // editor inserts an indent, so being tab-discoverable would
        // both (a) make Tab get stuck on the editor instead of
        // walking to the next form input and (b) bury Tab's
        // navigation feature whenever an editor is anywhere on the
        // screen. Editors receive focus via direct click
        // (`setKeyboardFocus(this)` in onMouseEvent), which doesn't
        // go through `isFocusable`.
        override fun isFocusable(): Bool {
            return false
        }

        // -------- incremental-repaint bookkeeping --------

        private fun markDirtyLine(line: Int) {
            this.markDirty(line, line)
        }

        // Union the existing dirty range with [lo, hi].
        private fun markDirty(lo: Int, hi: Int) {
            if (this.dirtyLineFrom < 0 || lo < this.dirtyLineFrom) {
                this.dirtyLineFrom = lo
            }
            if (hi > this.dirtyLineTo) {
                this.dirtyLineTo = hi
            }
        }

        // Tell the next paint to redraw both the previous cursor's line
        // (to erase the old cursor mark) and the new cursor's line.
        private fun markCursorMoveDirty(oldLine: Int) {
            var newLine = this.cursorLine
            if (oldLine == newLine) {
                this.markDirtyLine(newLine)
                return
            }
            if (oldLine < newLine) {
                this.markDirty(oldLine, newLine)
            } else {
                this.markDirty(newLine, oldLine)
            }
        }

        // Not private so HighlightedTextEditor can flag a full repaint
        // after a command (Ctrl+/, brace-split) mutates `this.lines`
        // — the incremental-paint path can't model arbitrary line
        // insertions / deletions from outside the editor's own edit
        // primitives.
        fun forceFullRepaint() {
            this.pendingFullRepaint = true
            this.dirtyLineFrom = -1
            this.dirtyLineTo = -1
            this.pendingScrollLineFrom = -1
            this.pendingScrollDy = 0S
        }

        // Composing two scrolls into one ScrollRaster correctly is
        // fiddly — when a second op tries to scroll while one is already
        // pending, we just fall back to a full repaint for that frame.
        private fun queueScroll(fromLine: Int, dy: Short) {
            if (this.pendingScrollLineFrom >= 0) {
                this.forceFullRepaint()
                return
            }
            this.pendingScrollLineFrom = fromLine
            this.pendingScrollDy = dy
        }

        // How many full lines fit inside the current viewport. Used by
        // ensureCursorVisible() and Page Up / Page Down handling.
        // Conservatively rounds down so partially-clipped trailing
        // lines aren't counted as fully visible.
        private fun visibleLineCount(): Int {
            var lh = this.getLineHeight()
            if (lh <= 0S) {
                return 1
            }
            var n = this.height.toShort() / lh
            if (n < 1S) {
                return 1
            }
            return n.toInt()
        }

        // -------- scrollbar geometry --------

        private fun needsScrollbar(): Bool {
            return this.lines.getSize() > this.visibleLineCount()
        }

        private fun scrollbarX(): Short {
            return this.width.toShort() - TextEditor.SCROLLBAR_W
        }

        // Width of the text area, excluding the scrollbar lane when
        // one is visible. Used by renderers + scrollRect so the
        // scrollbar pixels aren't shifted along with the text rows.
        private fun viewportWidth(): Short {
            var w = this.width.toShort()
            if (this.needsScrollbar()) {
                w = w - TextEditor.SCROLLBAR_W
            }
            return w
        }

        private fun maxScrollLine(): Int {
            var m = this.lines.getSize() - this.visibleLineCount()
            if (m < 0) {
                return 0
            }
            return m
        }

        private fun thumbHeight(): Short {
            var vpH = this.height.toShort().toInt()
            var visible = this.visibleLineCount()
            var total = this.lines.getSize()
            if (total <= 0) {
                return TextEditor.MIN_THUMB_H
            }
            // Visible-fraction → thumb-height mapping. Promote to
            // Int so the (vpH * visible) product doesn't overflow on
            // long viewports.
            var th = (vpH * visible) / total
            if (th < TextEditor.MIN_THUMB_H.toInt()) {
                th = TextEditor.MIN_THUMB_H.toInt()
            }
            if (th > vpH) {
                th = vpH
            }
            return th.toShort()
        }

        private fun thumbY(): Short {
            var maxS = this.maxScrollLine()
            if (maxS <= 0) {
                return 0S
            }
            var travel = (this.height.toShort() - this.thumbHeight()).toInt()
            if (travel <= 0) {
                return 0S
            }
            var ty = (this.scrollLine * travel) / maxS
            return ty.toShort()
        }

        private fun isPointOverThumb(x: Short, y: Short): Bool {
            if (!this.needsScrollbar()) {
                return false
            }
            if (x < this.scrollbarX()) {
                return false
            }
            var ty = this.thumbY()
            var th = this.thumbHeight()
            return y >= ty && y < ty + th
        }

        // Synchronous repaint helper. Mirrors ScrollView's — drag
        // updates need to land in the visible window during the
        // drag, not after the next event-loop tick.
        private fun forceRepaintNow() {
            this.forceFullRepaint()
            this.requestRepaint()
            var w = this.getWindow()
            if (w != null) {
                w.repaint()
            }
        }

        private fun setThumbHovered(hovered: Bool) {
            if (this.thumbHovered == hovered) {
                return
            }
            this.thumbHovered = hovered
            this.forceRepaintNow()
        }

        private fun paintScrollbar(graphics: Graphics) {
            if (!this.needsScrollbar()) {
                return
            }
            var sbX = this.scrollbarX()
            var sbW = TextEditor.SCROLLBAR_W
            var vpH = this.height.toShort()

            graphics.setForegroundPen(this.scrollbarTrackPen)
            graphics.fillRect(sbX, 0S, (sbX + sbW) - 1S, vpH - 1S)

            var ty = this.thumbY()
            var th = this.thumbHeight()
            var thumbPen = this.scrollbarThumbPen
            if (this.thumbHovered || this.draggingThumb) {
                thumbPen = this.scrollbarThumbHoverPen
            }
            graphics.setForegroundPen(thumbPen)
            graphics.fillRect((sbX + TextEditor.THUMB_INSET), ty, ((sbX + sbW) - TextEditor.THUMB_INSET) - 1S, (ty + th) - 1S)
        }

        // Adjust scrollLine / scrollPixelX so the cursor sits inside
        // the viewport. Called after every cursor move (arrows,
        // click, insert, backspace, page nav). Returns true if
        // either scroll axis actually changed — caller can then
        // force a full repaint to redraw the newly-visible band of
        // lines / columns.
        private fun ensureCursorVisible(): Bool {
            var oldScrollLine = this.scrollLine
            var oldScrollX = this.scrollPixelX

            // ---- vertical (existing behaviour) -------------------
            if (this.cursorLine < this.scrollLine) {
                this.scrollLine = this.cursorLine
            } else {
                var visible = this.visibleLineCount()
                var lastVisible = (this.scrollLine + visible) - 1
                if (this.cursorLine > lastVisible) {
                    this.scrollLine = (this.cursorLine - visible) + 1
                }
            }
            if (this.scrollLine < 0) {
                this.scrollLine = 0
            }

            // ---- horizontal --------------------------------------
            // Compute the cursor's pixel X within its line. Uses the
            // font's calculateStringWidth (via measureLineWidthF) so
            // tabs and proportional widths are correctly accounted
            // for — same path the painter uses for drawing the
            // cursor itself, so the two never disagree.
            //
            // No font? Skip. The horizontal scroll only ever matters
            // when there's a font to measure against, and the paint
            // path also skips when font is null.
            var f = this.getUsedFont()
            if (f != null && this.cursorLine < this.lines.getSize()) {
                var line = this.lines.get(this.cursorLine)
                var cursorPixelX: Short = 0S
                if (this.cursorCol > 0 && line.length() > 0) {
                    var clampedCol = this.cursorCol
                    if (clampedCol > line.length()) {
                        clampedCol = line.length()
                    }
                    var prefix = line.substring(0UI, clampedCol.toUInt())
                    cursorPixelX = this.measureLineWidthF(f, prefix)
                }

                var viewW = this.viewportWidth()
                var margin = TextEditor.HSCROLL_MARGIN_PX
                // Don't try to keep a margin we can't afford — in a
                // tiny viewport just track the cursor 1:1.
                if (margin * 2S >= viewW) {
                    margin = 0S
                }

                // Cursor fell off the left edge (or close to it).
                if (cursorPixelX < this.scrollPixelX + margin) {
                    this.scrollPixelX = cursorPixelX - margin
                }
                // Cursor fell off the right edge.
                var rightLimit = (this.scrollPixelX + viewW) - margin
                if (cursorPixelX > rightLimit) {
                    this.scrollPixelX = (cursorPixelX + margin) - viewW
                }
                if (this.scrollPixelX < 0S) {
                    this.scrollPixelX = 0S
                }
            }

            return this.scrollLine != oldScrollLine
                || this.scrollPixelX != oldScrollX
        }

        // -------- public API --------

        fun setText(text: String) {
            var newLines = new List<String>()
            if (text != null && !text.isEmpty()) {
                var arr = text.split(0x000AUS)
                var i = 0
                while (i < arr.length()) {
                    newLines.add(arr[i])
                    i++
                }
            }
            if (newLines.getSize() == 0) {
                newLines.add("")
            }
            this.lines = newLines
            this.cursorLine = 0
            this.cursorCol = 0
            this.scrollLine = 0
            this.scrollPixelX = 0S
            this.lastFindQuery = ""
            // Loading a fresh file resets undo history — otherwise the
            // user could undo "all the way back" into the previous
            // buffer, which is never what they want.
            this.clearUndo()
            this.forceFullRepaint()
            this.requestRepaint()
            // Notify the subclass cache (HighlightedTextEditor uses
            // this to drop its per-line token cache). We don't fire
            // the public contentChangeListener here on purpose —
            // setText is the file-load path, and the embedder wires
            // the listener AFTER the load, so firing it would mark a
            // freshly-loaded tab dirty.
            this.onContentChanged()
            this.fireCursorChanged()
        }

        fun getText(): String {
            var sb = new StringBuilder()
            var i = 0
            while (i < this.lines.getSize()) {
                if (i > 0) {
                    sb.addChar(0x000AUS)
                }
                sb.add(this.lines.get(i))
                i++
            }
            return sb.toString()
        }

        fun getLineCount(): Int {
            return this.lines.getSize()
        }

        fun getUsedFont(): Font? {
            if (this.font != null) {
                return this.font
            }
            var vc = this.getViewContext()
            if (vc != null) {
                return vc.getWindow().font
            }
            return null
        }

        private fun getLineHeight(): Short {
            var fh = 8S
            var f = this.getUsedFont()
            if (f != null) {
                fh = f.getSize().toShort()
            } else {
                var vc = this.getViewContext()
                if (vc != null) {
                    fh = vc.getWindow().getCurrentFontSize().toShort()
                }
            }
            return fh + this.lineSpacing
        }

        override fun minWidth(): Short {
            return 0S
        }

        override fun minHeight(): Short {
            return this.getLineHeight()
        }

        private fun currentLine(): String {
            if (this.cursorLine < 0 || this.cursorLine >= this.lines.getSize()) {
                return ""
            }
            return this.lines.get(this.cursorLine)
        }

        private fun clampCursorCol() {
            var len = this.currentLine().length()
            if (this.cursorCol < 0) {
                this.cursorCol = 0
            } else if (this.cursorCol > len) {
                this.cursorCol = len
            }
        }

        // -------- cursor moves --------

        private fun moveCursorLeft() {
            var oldLine = this.cursorLine
            if (this.cursorCol > 0) {
                this.cursorCol = this.cursorCol - 1
            } else if (this.cursorLine > 0) {
                this.cursorLine = this.cursorLine - 1
                this.cursorCol = this.currentLine().length()
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun moveCursorRight() {
            var oldLine = this.cursorLine
            var lineLen = this.currentLine().length()
            if (this.cursorCol < lineLen) {
                this.cursorCol = this.cursorCol + 1
            } else if (this.cursorLine < (this.lines.getSize() - 1)) {
                this.cursorLine = this.cursorLine + 1
                this.cursorCol = 0
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun moveCursorUp() {
            var oldLine = this.cursorLine
            if (this.cursorLine > 0) {
                this.cursorLine = this.cursorLine - 1
                this.clampCursorCol()
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun moveCursorDown() {
            var oldLine = this.cursorLine
            if (this.cursorLine < (this.lines.getSize() - 1)) {
                this.cursorLine = this.cursorLine + 1
                this.clampCursorCol()
            }
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        // Skip Left / Skip Right — Shift+arrow horizontal. Jumps
        // `horizontalSkipCols` cols at a time, clamped to the current
        // line. Crucially does NOT wrap into the previous / next line
        // the way moveCursorLeft / moveCursorRight do — at the line
        // end, the cursor just stops.
        private fun skipLeft() {
            var oldLine = this.cursorLine
            var newCol = this.cursorCol - this.horizontalSkipCols
            if (newCol < 0) {
                newCol = 0
            }
            if (newCol == this.cursorCol) {
                return
            }
            this.cursorCol = newCol
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun skipRight() {
            var oldLine = this.cursorLine
            var lineLen = this.currentLine().length()
            var newCol = this.cursorCol + this.horizontalSkipCols
            if (newCol > lineLen) {
                newCol = lineLen
            }
            if (newCol == this.cursorCol) {
                return
            }
            this.cursorCol = newCol
            this.markCursorMoveDirty(oldLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireCursorChanged()
        }

        // Page Up / Page Down — move the cursor by one viewport's worth
        // of lines, clamped to the buffer. After moving we always force
        // a full repaint because we know the viewport shifted (saves
        // the incremental-repaint pipeline from having to reason about
        // a multi-line jump combined with a scroll).
        private fun pageDown() {
            var oldLine = this.cursorLine
            var step = this.visibleLineCount()
            var target = this.cursorLine + step
            var lastLine = this.lines.getSize() - 1
            if (target > lastLine) {
                target = lastLine
            }
            this.cursorLine = target
            this.clampCursorCol()
            this.markCursorMoveDirty(oldLine)
            this.ensureCursorVisible()
            this.forceFullRepaint()
            this.requestRepaint()
            this.fireCursorChanged()
        }

        private fun pageUp() {
            var oldLine = this.cursorLine
            var step = this.visibleLineCount()
            var target = this.cursorLine - step
            if (target < 0) {
                target = 0
            }
            this.cursorLine = target
            this.clampCursorCol()
            this.markCursorMoveDirty(oldLine)
            this.ensureCursorVisible()
            this.forceFullRepaint()
            this.requestRepaint()
            this.fireCursorChanged()
        }

        // -------- edits --------

        // Snapshot the current buffer + cursor + scroll into the undo
        // stack. Call this BEFORE mutating `this.lines`. Strings are
        // immutable so copying refs into a fresh List is enough — the
        // edit path replaces slot contents, never mutates a String.
        // When the cap is hit, drop the oldest entry; the most recent
        // history is what users actually reach for.
        // Not private — HighlightedTextEditor's toggleLineComment is
        // an edit path that doesn't route through insertChar /
        // insertNewLine, and needs to push its own snapshot.
        fun pushUndo() {
            var snap = new List<String>()
            var i = 0
            while (i < this.lines.getSize()) {
                snap.add(this.lines.get(i))
                i = i + 1
            }
            var entry = new UndoEntry()
            entry.lines = snap
            entry.cursorLine = this.cursorLine
            entry.cursorCol = this.cursorCol
            entry.scrollLine = this.scrollLine
            if (this.undoStack.getSize() >= TextEditor.UNDO_CAP) {
                this.undoStack.removeAt(0)
            }
            this.undoStack.add(entry)
            // A fresh mutation invalidates the redo history — after
            // undo -> edit, the user can't "redo forward" into the
            // discarded branch. Standard convention.
            this.redoStack = new List<UndoEntry>()
        }

        // Snapshot of the CURRENT buffer + cursor + scroll for use
        // by undo() / redo(). Shared factory so both directions push
        // identical shapes onto their respective stacks.
        private fun snapshotCurrent(): UndoEntry {
            var snap = new List<String>()
            var i = 0
            while (i < this.lines.getSize()) {
                snap.add(this.lines.get(i))
                i = i + 1
            }
            var entry = new UndoEntry()
            entry.lines = snap
            entry.cursorLine = this.cursorLine
            entry.cursorCol = this.cursorCol
            entry.scrollLine = this.scrollLine
            return entry
        }

        // Restore an UndoEntry's contents into the current editor
        // state. Shared restore path for undo() and redo() so they
        // stay in sync on every state field the entry snapshots.
        private fun applyEntry(entry: UndoEntry) {
            this.lines = entry.lines
            this.cursorLine = entry.cursorLine
            this.cursorCol = entry.cursorCol
            this.scrollLine = entry.scrollLine
            this.clampCursorCol()
            this.forceFullRepaint()
            this.requestRepaint()
            this.onContentChanged()
            this.fireCursorChanged()
            var cb = this.contentChangeListener
            if (cb != null) {
                cb()
            }
        }

        // Ctrl+Z. Restore the most recent undo snapshot if any, then
        // push the CURRENT state onto the redoStack so a subsequent
        // Ctrl+Shift+Z can walk forward. Returns true iff the stack
        // had something to pop.
        fun undo(): Bool {
            if (this.undoStack.getSize() == 0) {
                return false
            }
            var current = this.snapshotCurrent()
            this.redoStack.add(current)
            var top = this.undoStack.removeAt(this.undoStack.getSize() - 1)
            this.applyEntry(top)
            return true
        }

        // Ctrl+Shift+Z. Pop the most recent redo snapshot back into
        // the editor and push the CURRENT (pre-redo) state onto the
        // undoStack so Ctrl+Z still undoes the redo. Returns true iff
        // there was actually a redo entry available. Every new edit
        // path (through pushUndo) clears redoStack, so redo can only
        // walk contiguous with the current undo history.
        fun redo(): Bool {
            if (this.redoStack.getSize() == 0) {
                return false
            }
            var current = this.snapshotCurrent()
            if (this.undoStack.getSize() >= TextEditor.UNDO_CAP) {
                this.undoStack.removeAt(0)
            }
            this.undoStack.add(current)
            var top = this.redoStack.removeAt(this.redoStack.getSize() - 1)
            this.applyEntry(top)
            return true
        }

        // Drop all undo history. Called from setText so loading a fresh
        // file doesn't leave the user able to "undo" their way into the
        // previous buffer.
        private fun clearUndo() {
            this.undoStack = new List<UndoEntry>()
            this.redoStack = new List<UndoEntry>()
        }

        private fun insertChar(c: UShort) {
            var line = this.currentLine()
            // Skip-closer hook: if the char the user just typed
            // matches the next char in the buffer AND the subclass
            // says yes, just step over it instead of inserting. This
            // is what makes auto-pair feel natural — typing `)` after
            // an auto-inserted `)` advances the cursor instead of
            // producing `))`. Default returns false; HighlightedText-
            // Editor consults the per-language autoPairBrackets flag.
            if (this.shouldSkipInsertedChar(c, line, this.cursorCol)) {
                this.cursorCol = this.cursorCol + 1
                this.markDirtyLine(this.cursorLine)
                if (this.ensureCursorVisible()) {
                    this.forceFullRepaint()
                }
                this.requestRepaint()
                this.fireCursorChanged()
                return
            }
            this.pushUndo()
            var sb = new StringBuilder()
            if (this.cursorCol > 0) {
                sb.add(line.substring(0UI, this.cursorCol.toUInt()))
            }
            sb.addChar(c)
            // Auto-pair completion hook: subclass returns a string to
            // splice in *after* the typed char (cursor stays between
            // them). For `(` a HighlightedTextEditor with autoPairBrackets
            // on would return ")" — the buffer becomes "()" with the
            // cursor on the `)` ready for inside-the-pair typing.
            // Default returns null = no completion = base behaviour.
            var completion = this.completionForInsertedChar(c)
            if (completion != null && completion.length() > 0) {
                sb.add(completion)
            }
            if (this.cursorCol < line.length()) {
                sb.add(line.substringToEnd(this.cursorCol.toUInt()))
            }
            this.lines.set(this.cursorLine, sb.toString())
            this.cursorCol = this.cursorCol + 1
            this.markDirtyLine(this.cursorLine)
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
        }

        private fun insertNewLine() {
            this.pushUndo()
            var oldCursorLine = this.cursorLine
            var line = this.currentLine()
            var before = ""
            var after = ""
            if (this.cursorCol > 0) {
                before = line.substring(0UI, this.cursorCol.toUInt())
            }
            if (this.cursorCol < line.length()) {
                after = line.substringToEnd(this.cursorCol.toUInt())
            }
            var splitAt = this.cursorCol
            this.lines.set(this.cursorLine, before)
            this.lines.insertAt(this.cursorLine + 1, after)
            this.cursorLine = this.cursorLine + 1
            this.cursorCol = 0

            // Auto-indent hook. Subclasses (HighlightedTextEditor)
            // can return a leading-whitespace prefix to splice onto
            // the start of the new line so the cursor lands at the
            // same indent as the line we just split from. Default
            // implementation returns "" — no auto-indent — so the
            // base TextEditor keeps its historical behaviour.
            // Passes the WHOLE previous line (pre-split) AND the
            // column the split occurred at, so the hook can inspect
            // just the content that was BEFORE the cursor when
            // deciding e.g. "did this line end in `{`".
            var indent = this.computeIndentForNewLine(line, splitAt)
            if (indent != null && indent.length() > 0) {
                this.lines.set(this.cursorLine, indent + after)
                this.cursorCol = indent.length()
            }

            // Post-split hook. Fires AFTER the new line has its
            // auto-indent applied. Subclasses use this to react to
            // the full split context — typically to detect "Enter
            // pressed between `{` and `}`" and push the `}` onto a
            // third line below at the outer indent. Default no-op.
            this.postInsertNewLine(line, splitAt)

            // If the new cursor row would otherwise scroll off the
            // bottom of the viewport, advance scrollLine and do a full
            // repaint — the incremental scroll-raster path can't
            // represent "insert a line AND scroll the viewport" in a
            // single frame correctly, so we fall back here.
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            } else {
                // Shift everything below the split point DOWN by one row
                // so we don't have to re-render those lines, then
                // re-render the two lines that actually changed (split
                // source + new line).
                var lineHeight = this.getLineHeight()
                this.queueScroll(oldCursorLine + 1, lineHeight)
                this.markDirty(oldCursorLine, oldCursorLine + 1)
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
        }

        private fun fireContentChanged() {
            var cb = this.contentChangeListener
            if (cb != null) {
                cb()
            }
            // Subclass hook — fired AFTER the user-installed listener
            // so a HighlightedTextEditor invalidating its per-line
            // token cache doesn't race with whatever the embedder
            // wired contentChangeListener up to (typically tab-dirty
            // tracking). Default no-op; subclasses override.
            this.onContentChanged()
        }

        // Subclass-overridable "content just changed" hook. Distinct
        // from the public `contentChangeListener` var: that one is
        // owned by the embedder (the IDE wires it to mark the tab
        // dirty), while this method is for the editor's own subclass
        // to react without conflicting. Default no-op.
        open fun onContentChanged() {
        }

        // Subclass-overridable hook called from insertNewLine() right
        // after the cursor advances to the new line. Returns the
        // string to splice onto the start of the new line as
        // auto-indent — typically the leading whitespace of
        // `prevLineFull` (the line that just got split). `splitCol`
        // is the column the cursor was on BEFORE the split, so
        // subclasses can look only at the chars that ended up on
        // the original line — e.g. "did the line end in `{` right
        // before the split". Default returns "" so the base
        // TextEditor preserves its no-indent behaviour; Highlighted-
        // TextEditor overrides to consult a per-language behaviour.
        open fun computeIndentForNewLine(prevLineFull: String, splitCol: Int): String {
            return ""
        }

        // Subclass-overridable hook called from insertNewLine AFTER
        // computeIndentForNewLine has applied the auto-indent to the
        // freshly-split new line. Default no-op. HighlightedTextEditor
        // uses this to do the `{<Enter>}` split:
        //
        //   before:    something {|}
        //   after Enter (with this hook):
        //              something {
        //                  |
        //              }
        //
        // The hook can mutate `this.lines` and the cursor freely.
        open fun postInsertNewLine(prevLineFull: String, splitCol: Int) {
        }

        // Subclass-overridable hook called from insertChar(c) after
        // the typed char is buffered but before the buffer is written
        // back. Returns a string to splice in *immediately after* the
        // typed char without advancing the cursor — i.e. an auto-pair
        // completion. Returning null or "" means "no completion".
        //
        // Default returns null; HighlightedTextEditor overrides to
        // emit ")" for "(", "]" for "[", etc. when the file's
        // LanguageBehaviour has autoPairBrackets on.
        open fun completionForInsertedChar(c: UShort): String? {
            return null
        }

        // Subclass-overridable hook called BEFORE the typed char is
        // buffered. When true, insertChar treats the keystroke as a
        // "skip over the existing closer" gesture: it advances the
        // cursor by one column instead of inserting `c` (and skips
        // the completionForInsertedChar path entirely). The skip is
        // expected to fire ONLY when `c` matches the char at
        // `(line, col)` — otherwise behaviour gets surprising.
        //
        // Default returns false; HighlightedTextEditor consults
        // LanguageBehaviour.autoPairBrackets and matches the standard
        // closer set (`)` `]` `}` `"` `'`).
        open fun shouldSkipInsertedChar(c: UShort, line: String, col: Int): Bool {
            return false
        }

        // Toggle a line-comment prefix on the cursor's line. Returns
        // true when the toggle ran (the keypress is consumed), false
        // when the subclass declined (caller should treat the key as
        // not handled — vanilla TextEditor returns false because it
        // has no notion of a comment syntax). HighlightedTextEditor
        // overrides to consult LanguageBehaviour.commentLinePrefix.
        open fun toggleLineComment(): Bool {
            return false
        }

        // Search forward from just past the cursor for `query`. On a
        // hit, moves the cursor to the match start, scrolls so the
        // match is visible, repaints, and returns true. On a miss,
        // wraps around once and tries from the top of the buffer; if
        // still no match, leaves the cursor where it was and returns
        // false. Callers — typically the IDE's find bar — also call
        // setLastFindQuery so Ctrl+G repeats the same search.
        fun findNext(query: String): Bool {
            if (query == null || query.length() == 0) {
                return false
            }
            this.lastFindQuery = query
            var lineCount = this.lines.getSize()
            if (lineCount == 0) {
                return false
            }
            // First pass: from (cursorLine, cursorCol+1) to end-of-
            // buffer. The +1 stops Ctrl+G from re-matching the same
            // position the cursor is currently on.
            var startLine = this.cursorLine
            var startCol = this.cursorCol + 1
            if (TextEditor.findInRange(this.lines, query, startLine, startCol, lineCount, this)) {
                return true
            }
            // Second pass: from (0, 0) up to (cursorLine, cursorCol)
            // so we wrap once around the buffer. Don't pass startCol
            // here — we want to allow matches that end before the
            // cursor's column on its line.
            if (TextEditor.findInRange(this.lines, query, 0, 0, startLine + 1, this)) {
                return true
            }
            return false
        }

        // Scan `lines[fromLine .. toLine)` starting at `fromCol` for
        // the first occurrence of `query`. On a hit, applies it to
        // `target` (moves the cursor and fires the visibility /
        // repaint side-effects). Defined static so the same routine
        // serves both passes of findNext without duplicating the
        // cursor-mutation block.
        private static fun findInRange(
            lines: List<String>,
            query: String,
            fromLine: Int,
            fromCol: Int,
            toLine: Int,
            target: TextEditor
        ): Bool {
            var l = fromLine
            var c = fromCol
            while (l < toLine) {
                var lineText = lines.get(l)
                var idx = lineText.indexOfAfter(query, c)
                if (idx >= 0) {
                    target.cursorLine = l
                    target.cursorCol = idx
                    target.ensureCursorVisible()
                    target.forceFullRepaint()
                    target.requestRepaint()
                    target.fireCursorChanged()
                    return true
                }
                l = l + 1
                c = 0
            }
            return false
        }


        private fun fireCursorChanged() {
            // Defensive re-clamp before reporting. Every caller already
            // calls clampCursorCol() after a line change, but if any
            // path ever leaks a stale cursorCol (e.g. pageUp into a
            // shorter line where the clamp didn't take), the status
            // bar would otherwise display a column that doesn't match
            // where the cursor actually renders. clampCursorCol() is
            // a no-op when cursorCol is already in [0, lineLength].
            this.clampCursorCol()
            var cb = this.cursorChangeListener
            if (cb != null) {
                cb(this.cursorLine, this.cursorCol)
            }
        }

        fun getCursorLine(): Int {
            return this.cursorLine
        }

        fun getCursorCol(): Int {
            return this.cursorCol
        }

        private fun backspace() {
            var hadChange = false
            if (this.cursorCol > 0 || this.cursorLine > 0) {
                hadChange = true
            }
            if (!hadChange) {
                return
            }
            this.pushUndo()
            if (this.cursorCol > 0) {
                var line = this.currentLine()
                var sb = new StringBuilder()
                sb.add(line.substring(0UI, (this.cursorCol - 1).toUInt()))
                if (this.cursorCol < line.length()) {
                    sb.add(line.substringToEnd(this.cursorCol.toUInt()))
                }
                this.lines.set(this.cursorLine, sb.toString())
                this.cursorCol = this.cursorCol - 1
                this.markDirtyLine(this.cursorLine)
                if (this.ensureCursorVisible()) {
                    this.forceFullRepaint()
                }
            } else if (this.cursorLine > 0) {
                // Merge: previous line absorbs the current one, lines
                // below shift UP by one row.
                var mergedAt = this.cursorLine - 1
                var prev = this.lines.get(this.cursorLine - 1)
                var cur = this.currentLine()
                this.cursorCol = prev.length()
                this.lines.set(this.cursorLine - 1, prev + cur)
                this.lines.removeAt(this.cursorLine)
                this.cursorLine = this.cursorLine - 1

                // If the merge would pull the cursor above the
                // viewport (cursor moved up to a line that's now off
                // the top), advance scrollLine to match and do a full
                // repaint — the scroll-raster path can't represent
                // "remove a line AND shift the viewport up" in a
                // single frame.
                if (this.ensureCursorVisible()) {
                    this.forceFullRepaint()
                } else {
                    var lineHeight = this.getLineHeight()
                    this.queueScroll(mergedAt + 1, 0S - lineHeight)
                    var visible = (this.height.toShort() / lineHeight).toInt() + 1
                    this.markDirty(mergedAt, mergedAt + visible)
                }
            }
            this.requestRepaint()
            if (hadChange) {
                this.fireContentChanged()
                this.fireCursorChanged()
            }
        }

        // -------- rendering --------

        // Pixel width of `s` with tabs counted as `tabWidthPx`.
        // Splits the string on tab and sums each segment's natural
        // width plus one tab gap between consecutive segments.
        //
        // Two flavours because the editor measures from two
        // contexts: the paint path has Graphics in hand (and
        // Graphics always has a font set on the underlying
        // RastPort, even before our `font` field is populated by
        // onAttach); the click path only has the Font reference.
        // Falling back to Graphics in the paint path matters — on
        // the very first paint after a file is opened, getUsedFont()
        // can still return null, and the old "Font-only" measure
        // returned 0 here, which made the right-of-text fill cover
        // the entire row and erase the line we'd just drawn.
        //
        // Fast path: a line with no tab is a single
        // calculateStringWidth call, no array allocation.
        private fun measureLineWidthG(graphics: Graphics, s: String): Short {
            if (s == null || s.length() == 0) {
                return 0S
            }
            if (s.indexOf("\t") < 0) {
                return graphics.calculateStringWidth(s).toShort()
            }
            // Character-walk instead of split() because AmLang's
            // String.split drops trailing-separator segments: "\t"
            // and "abc\t" both split to a single element, so a
            // split-based gap count undercounts by 1 whenever the
            // string ends on a tab — and the cursor X for cursorCol
            // past such a tab would land at 0, not tabWidthPx.
            var nonTabWidth = 0S
            var tabCount = 0
            var sb = new StringBuilder()
            var len = s.length()
            var i = 0
            while (i < len) {
                var c = s.characterAt(i.toUInt())
                if (c == 0x0009US) {
                    if (sb.getLength() > 0) {
                        nonTabWidth = nonTabWidth + graphics.calculateStringWidth(sb.toString()).toShort()
                        sb = new StringBuilder()
                    }
                    tabCount = tabCount + 1
                } else {
                    sb.addChar(c)
                }
                i = i + 1
            }
            if (sb.getLength() > 0) {
                nonTabWidth = nonTabWidth + graphics.calculateStringWidth(sb.toString()).toShort()
            }
            return nonTabWidth + (tabCount.toShort() * this.tabWidthPx)
        }

        private fun measureLineWidthF(f: Font, s: String): Short {
            if (f == null || s == null || s.length() == 0) {
                return 0S
            }
            if (s.indexOf("\t") < 0) {
                return f.calculateStringWidth(s).toShort()
            }
            // See measureLineWidthG above for why this can't use
            // split() — same trailing-tab undercount.
            var nonTabWidth = 0S
            var tabCount = 0
            var sb = new StringBuilder()
            var len = s.length()
            var i = 0
            while (i < len) {
                var c = s.characterAt(i.toUInt())
                if (c == 0x0009US) {
                    if (sb.getLength() > 0) {
                        nonTabWidth = nonTabWidth + f.calculateStringWidth(sb.toString()).toShort()
                        sb = new StringBuilder()
                    }
                    tabCount = tabCount + 1
                } else {
                    sb.addChar(c)
                }
                i = i + 1
            }
            if (sb.getLength() > 0) {
                nonTabWidth = nonTabWidth + f.calculateStringWidth(sb.toString()).toShort()
            }
            return nonTabWidth + (tabCount.toShort() * this.tabWidthPx)
        }

        // Subclasses override this when they want to render the line as
        // multiple coloured runs (syntax highlighting). Default draws
        // the entire line with `this.textPen`, with tab characters
        // expanded to a `tabWidthPx`-wide gap.
        //
        // Selection: when selStartColOnLine(lineIndex) returns a non-
        // negative col, characters in that range paint with
        // selectionBackgroundPen as their text-bg cell so the highlight
        // shows up *under* the glyphs (not behind them, like a
        // separately-drawn fillRect would — the AmigaOS rastport mode
        // is JAM2, so each drawString cell repaints its own bg). The
        // walk flushes the buffer on bg-change as well as on tab so
        // the pen switch lands between segments. Tab cells in the
        // selection get a fillRect because drawString skips them; the
        // `rowTop` / `rowBottom` params bound that rect vertically.
        open fun drawLine(graphics: Graphics, line: String, lineIndex: Int, x: Short, y: Short, rowTop: Short, rowBottom: Short) {
            graphics.setForegroundPen(this.textPen)
            var selStart = this.selStartColOnLine(lineIndex)
            var selEnd   = this.selEndColOnLine(lineIndex)
            var lineLen = line.length()
            var hasInLine = selStart >= 0 && selEnd > selStart && selStart < lineLen

            // Pre-fill the selection's pixel range across the FULL
            // row height (rowTop..rowBottom) so the highlight stripe
            // reaches into the lineSpacing gap above and below the
            // glyph cells. Without this, drawString-with-JAM2 only
            // paints inside the glyph cell, leaving thin horizontal
            // gaps of editor-bg between selected lines that look
            // unintentional. Computed here in pixels by walking the
            // characters up to selStart / selEnd with tab expansion.
            if (hasInLine) {
                var selStartX = x
                var selEndX = x
                var px = x
                var ii = 0
                while (ii < lineLen) {
                    if (ii == selStart) { selStartX = px }
                    if (ii == selEnd)   { selEndX = px }
                    var cc = line.characterAt(ii.toUInt())
                    if (cc == 0x0009US) {
                        px = px + this.tabWidthPx
                    } else {
                        px = px + graphics.calculateStringWidth(line.substring(ii.toUInt(), 1UI)).toShort()
                    }
                    ii = ii + 1
                }
                if (selEnd >= lineLen) { selEndX = px }
                if (selEndX > selStartX) {
                    graphics.setForegroundPen(this.selectionBackgroundPen)
                    graphics.fillRect(selStartX, rowTop, selEndX - 1S, rowBottom)
                    graphics.setForegroundPen(this.textPen)
                }
            }

            // Fast path: no selection on this line, no tabs.
            if (!hasInLine && line.indexOf("\t") < 0) {
                graphics.setBackgroundPen(this.backgroundPen)
                graphics.drawString(line, x, y)
                return
            }

            var sb = new StringBuilder()
            var curX = x
            var i = 0
            var curBg = this.backgroundPen
            graphics.setBackgroundPen(curBg)
            while (i < lineLen) {
                var bg = this.backgroundPen
                if (hasInLine && i >= selStart && i < selEnd) {
                    bg = this.selectionBackgroundPen
                }
                var bgChanged = bg != curBg
                var c = line.characterAt(i.toUInt())
                var isTab = c == 0x0009US
                if ((bgChanged || isTab) && sb.getLength() > 0) {
                    var seg = sb.toString()
                    graphics.drawString(seg, curX, y)
                    curX = curX + graphics.calculateStringWidth(seg).toShort()
                    sb = new StringBuilder()
                }
                if (bgChanged) {
                    curBg = bg
                    graphics.setBackgroundPen(curBg)
                }
                if (isTab) {
                    // Paint the tab cell with the current bg so a
                    // selection that covers a tab still shows the
                    // highlight stripe (drawString doesn't paint any
                    // pixels under tabs — it just advances x).
                    if (curBg != this.backgroundPen) {
                        graphics.setForegroundPen(curBg)
                        graphics.fillRect(curX, rowTop, curX + this.tabWidthPx - 1S, rowBottom)
                        graphics.setForegroundPen(this.textPen)
                    }
                    curX = curX + this.tabWidthPx
                } else {
                    sb.addChar(c)
                }
                i = i + 1
            }
            if (sb.getLength() > 0) {
                graphics.drawString(sb.toString(), curX, y)
            }
            // Reset bg pen for the caller (cursor draw etc.).
            graphics.setBackgroundPen(this.backgroundPen)
        }

        // Render every visible line — used for full repaints (initial
        // paint, expose, setText, etc.). renderLines paints each row
        // with JAM2 (so each glyph cell carries its own bg) and the
        // right-of-text fill, and fillBelowLastLine covers the rows
        // past the buffer end — so every visible pixel is touched
        // without needing an extra full-viewport clear up front. The
        // clear is what was causing the visible flash on every scroll.
        private fun renderContent(graphics: Graphics) {
            this.renderLines(graphics, 0, this.lines.getSize() - 1, true)
            this.fillBelowLastLine(graphics)
        }

        // Render a clamped sub-range of lines. Used by incremental
        // updates after ScrollRaster has done the bulk shift.
        private fun renderLineRange(graphics: Graphics, fromLine: Int, toLine: Int) {
            this.renderLines(graphics, fromLine, toLine, false)
        }

        // The shared rendering loop. The trailing "fillBelowLastLine"
        // pass is only needed when we're doing a full repaint — partial
        // repaints know they don't need to touch the area below the
        // visible lines.
        private fun renderLines(graphics: Graphics, fromLine: Int, toLine: Int, isFullRepaint: Bool) {
            graphics.setBackgroundPen(this.backgroundPen)

            var f = this.getUsedFont()
            if (f != null) {
                graphics.setFont(f)
            }

            var lineHeight = this.getLineHeight()
            // fontHeight = the actual glyph row count; lineHeight
            // includes lineSpacing's blank pixels below the text.
            // Split them out so we can center text vertically inside
            // the lineHeight rect and extend the cursor 1px above
            // and below the text glyphs.
            var fontHeight = lineHeight - this.lineSpacing
            var halfSpacing = this.lineSpacing / 2S
            var availableHeight = this.height.toShort()
            // Excludes the scrollbar lane when one is visible — keep
            // the right-of-text fill from painting over the bar.
            var viewWidth = this.viewportWidth()

            // Clamp the requested range to lines that fall inside the
            // current viewport. `scrollLine` is the line currently at
            // y=0; anything below it (i < scrollLine) is above the
            // viewport, anything past `scrollLine + visibleCount` is
            // below the viewport. Both ends are no-ops to render.
            var lo = fromLine
            if (lo < this.scrollLine) { lo = this.scrollLine }
            var hi = toLine
            var lastLine = this.lines.getSize() - 1
            if (hi > lastLine) { hi = lastLine }

            var i = lo
            while (i <= hi) {
                // y is in viewport coords — i=scrollLine renders at y=0.
                var y = ((i - this.scrollLine) * lineHeight.toInt()).toShort()
                if (y >= availableHeight) {
                    return
                }
                var line = this.lines.get(i)
                var lineBottom = (y + lineHeight) - 1S

                // Pre-fill the whole row with bg, then draw glyphs
                // and cursor on top. Two reasons:
                //   1) tab segments don't paint pixels (drawString
                //      just advances curX over the gap), so without
                //      a pre-fill, anything that was previously
                //      under the tab area — most commonly a stale
                //      cursor — stays visible on screen.
                //   2) lineSpacing inserts blank pixel rows below
                //      each line; the pre-fill wipes those too so
                //      they don't bleed garbage from a prior render.
                // Replaces the old "right-of-text fill" pass — that
                // strip is now a subset of this pre-fill.
                if (this.fillBackground) {
                    graphics.setForegroundPen(this.backgroundPen)
                    graphics.fillRect(0S, y, viewWidth - 1S, lineBottom)
                }

                // Center the text vertically by offsetting it by
                // half the lineSpacing — splits the gap evenly above
                // and below.
                var textY = y + halfSpacing
                // Shift the entire line left by scrollPixelX so the
                // viewport shows a sliding window of each line.
                // Glyphs that fall past the left edge draw at
                // negative X and the graphics clip keeps them off
                // the surrounding chrome.
                var lineStartX = 0S - this.scrollPixelX

                // drawLine handles selection bg per-character (the
                // JAM2 mode means each glyph cell repaints its own
                // bg, so a separately-drawn fillRect would be
                // overwritten). It also fills the past-EOL gap when
                // a block selection extends past the line text.
                this.drawLine(graphics, line, i, lineStartX, textY, y, lineBottom)

                if (i == this.cursorLine && TextEditor.isCursorVisibleNow()) {
                    var cursorX = lineStartX
                    if (this.cursorCol > 0) {
                        var before = line.substring(0UI, this.cursorCol.toUInt())
                        cursorX = lineStartX + this.measureLineWidthG(graphics, before)
                    }
                    graphics.setForegroundPen(this.cursorPen)
                    // 2 px wide column, extended 1 px above + below
                    // the text glyphs. Width gives a clearer "I'm
                    // here" marker than the previous 1 px line; the
                    // vertical overhang stays inside the lineHeight
                    // rect (uses the gap pixels we add via
                    // lineSpacing).
                    graphics.fillRect(cursorX, textY - 1S, cursorX + 1S, textY + fontHeight)
                }
                i = i + 1
            }
        }

        private fun fillBelowLastLine(graphics: Graphics) {
            if (!this.fillBackground) {
                return
            }
            var lineHeight = this.getLineHeight()
            var availableHeight = this.height.toShort()
            // Last line's y is computed against scrollLine so that the
            // fill aligns with whatever the visible lines actually
            // ended at.
            var y = ((this.lines.getSize() - this.scrollLine) * lineHeight.toInt()).toShort()
            if (y < 0S) {
                y = 0S
            }
            if (y < availableHeight) {
                graphics.setForegroundPen(this.backgroundPen)
                graphics.fillRect(0S, y, this.viewportWidth() - 1S, availableHeight - 1S)
            }
        }

        // ScrollRaster the strip starting at pendingScrollLineFrom down to
        // the bottom of the visible editor by pendingScrollDy pixels.
        // After this the pixels for the unchanged lines are already in
        // the right place, and only the dirty lines need rendering.
        //
        // `pendingScrollLineFrom` is an *absolute* line index, but the
        // RastPort y axis is viewport-relative — we have to subtract
        // `scrollLine` before scaling by lineHeight, otherwise we'd
        // scroll a band of pixels that has nothing to do with the
        // edited rows (this was leaving stale text below the edit
        // point until the cursor stepped through it).
        private fun applyPendingScroll(graphics: Graphics) {
            var lineHeight = this.getLineHeight()
            var availableHeight = this.height.toShort()
            var relLine = this.pendingScrollLineFrom - this.scrollLine
            if (relLine < 0) {
                relLine = 0
            }
            var startY = (relLine * lineHeight.toInt()).toShort()
            if (startY >= availableHeight) {
                return
            }
            var h = availableHeight - startY
            if (h <= 0S) {
                return
            }
            // viewportWidth excludes the scrollbar lane so the bar
            // pixels stay put while the text rows shift.
            graphics.scrollRect(0S, startY, this.viewportWidth().toUShort(), h.toUShort(), 0S, this.pendingScrollDy, this.backgroundPen)
        }

        // Render via the window-level offscreen buffer (no flicker, but
        // also no incremental updates — every paint re-renders all
        // visible lines into offscreen and blits the rect back).
        private fun renderViaOffscreen(graphics: Graphics) {
            var window = this.getViewContext().getWindow()
            var off = window.getOffscreenGraphics()

            var absX = graphics.getTranslateX()
            var absY = graphics.getTranslateY()

            off.translate(absX, absY)
            // Set logical == effective at construction — this clip
            // is built from absolute translate coords, so there's
            // no shift to preserve at the origin.
            var clip: ClipRect = {
                x: absX, y: absY, width: this.width, height: this.height,
                logicalX: absX, logicalY: absY,
                logicalWidth: this.width, logicalHeight: this.height
            }
            off.pushClipRect(clip)

            this.renderContent(off)

            off.popClipRect()
            off.translate(0S - absX, 0S - absY)

            window.flushOffscreenRect(absX, absY, this.width, this.height)
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            // dirtyLineFrom < 0 used to be the only "full-repaint" signal,
            // but that bit got clobbered if a partial-dirty mark
            // arrived between forceFullRepaint() and the paint cycle.
            // pendingFullRepaint sticks across markDirty calls so a
            // post-scroll auto-repeated cursor move can't silently
            // demote the next paint to partial.
            var forceFull = graphics.shouldRepaintAll() || this.pendingFullRepaint || this.dirtyLineFrom < 0
            if (this.useOffscreen) {
                this.renderViaOffscreen(graphics)
            } else if (forceFull) {
                this.renderContent(graphics)
            } else {
                if (this.pendingScrollLineFrom >= 0 && this.pendingScrollDy != 0S) {
                    this.applyPendingScroll(graphics)
                }
                this.renderLineRange(graphics, this.dirtyLineFrom, this.dirtyLineTo)
            }

            // Re-stamp the scrollbar on every paint — partial paints
            // never touch the lane (viewportWidth() excludes it), so
            // we just paint the bar unconditionally to keep the thumb
            // in sync with scrollLine + total line count.
            this.paintScrollbar(graphics)

            // Consume the partial-repaint state — the next paint starts
            // from "full repaint" again unless an edit op reschedules.
            this.pendingFullRepaint = false
            this.dirtyLineFrom = -1
            this.dirtyLineTo = -1
            this.pendingScrollLineFrom = -1
            this.pendingScrollDy = 0S

            // Self-drive the cursor blink while we hold focus. Without
            // this, the cursor would render whatever phase the last
            // paint happened to catch and stay frozen until something
            // else (typing, scroll) triggered a refresh. Same self-
            // driving pattern as TextField's spinnerMode — Window.paint
            // resets repaintRequested at the start of each cycle, so
            // requesting from inside paint correctly queues the next
            // frame instead of being swallowed by an already-set flag.
            if (this.isEditorFocused()) {
                this.markCursorLineDirty()
                this.requestRepaint()
            }
        }

        // Triangular blink: cursor visible for the first half of every
        // CURSOR_BLINK_CYCLE_MS millis, hidden for the second half.
        // Time-driven so it stays in sync across the rendering of
        // multiple lines in the same paint cycle and across partial
        // re-renders that only touch a subset of lines.
        private static fun isCursorVisibleNow(): Bool {
            var nowMs = Date.now().getValue().toLong()
            var t = nowMs % TextEditor.CURSOR_BLINK_CYCLE_MS
            return t < (TextEditor.CURSOR_BLINK_CYCLE_MS / 2L)
        }

        // Mark only the cursor's line dirty for the next paint so the
        // blink doesn't force a full editor repaint every ~500 ms.
        // renderLineRange will re-pre-fill that line's strip, then
        // either draw the caret (visible half) or not (hidden half).
        private fun markCursorLineDirty() {
            this.markDirtyLine(this.cursorLine)
        }

        // True when this editor currently holds the window's keyboard
        // focus — used to gate the blink ticker so a background tab
        // doesn't keep requesting frames.
        private fun isEditorFocused(): Bool {
            var vc = this.getViewContext()
            if (vc == null) {
                return false
            }
            var w = vc.getWindow()
            if (w == null) {
                return false
            }
            return w.getKeyboardFocus() == this
        }

        // Full on/off cycle in milliseconds. 1000ms ≈ matches the
        // OS standard caret cadence (~500ms half). Tweak in one
        // place if you want a faster / slower blink.
        private static const CURSOR_BLINK_CYCLE_MS: Long = 1000L

        // -------- mouse positioning --------

        // Find the column index in `line` whose character cell most closely
        // aligns with `pixelX`. Walks one character at a time using the
        // font's own glyph-width measurement so the math stays correct for
        // proportional fonts. Boundary heuristic: place the cursor before
        // the character whose midpoint is past `pixelX`.
        private fun colForPixelX(line: String, pixelX: Short): Int {
            if (pixelX <= 0S || line.length() == 0) {
                return 0
            }
            var f = this.getUsedFont()
            if (f == null) {
                return 0
            }
            var len = line.length()
            var prevWidth = 0S
            var col = 0
            while (col < len) {
                var prefix = line.substring(0UI, (col + 1).toUInt())
                // Tab-aware so a click after a tab lands in the
                // right column (the prior measurement used raw
                // calculateStringWidth, which counted tabs as the
                // font's default glyph width).
                var curWidth = this.measureLineWidthF(f, prefix)
                var glyphMid = (prevWidth + curWidth) / 2S
                if (pixelX < glyphMid) {
                    return col
                }
                prevWidth = curWidth
                col = col + 1
            }
            return len
        }

        // Click-to-position. Left mouse-down inside the editor moves the
        // cursor to the character cell under the pointer. Mid-button and
        // motion events fall through to the base handler.
        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            // Active thumb drag — track move/up regardless of where
            // the cursor went so the bar keeps following.
            if (this.draggingThumb) {
                if (type == MouseEventType.move) {
                    var dy = (y - this.dragMouseStartY).toInt()
                    var travel = (this.height.toShort() - this.thumbHeight()).toInt()
                    if (travel > 0) {
                        var maxS = this.maxScrollLine()
                        var newScroll = this.dragScrollStartLine + (dy * maxS) / travel
                        if (newScroll < 0) { newScroll = 0 }
                        if (newScroll > maxS) { newScroll = maxS }
                        if (newScroll != this.scrollLine) {
                            this.scrollLine = newScroll
                            this.forceRepaintNow()
                        }
                    }
                    return true
                }
                if (type == MouseEventType.up) {
                    this.draggingThumb = false
                    this.forceRepaintNow()
                    return true
                }
            }

            if (!this.contains(x, y)) {
                this.setThumbHovered(false)
                return base.onMouseEvent(type, button, x, y)
            }

            // Hover lighting — runs on every in-bounds move.
            if (type == MouseEventType.move) {
                this.setThumbHovered(this.isPointOverThumb(x, y))
            }

            // Click landed in the scrollbar lane?
            if (this.needsScrollbar() && x >= this.scrollbarX()) {
                if (type == MouseEventType.down && button == MouseButton.left) {
                    var ty = this.thumbY()
                    var th = this.thumbHeight()
                    if (y >= ty && y < ty + th) {
                        this.draggingThumb = true
                        this.dragMouseStartY = y
                        this.dragScrollStartLine = this.scrollLine
                    } else {
                        // Track click — page by a viewport's worth of
                        // lines toward the click.
                        var page = this.visibleLineCount()
                        var maxS = this.maxScrollLine()
                        var newScroll = this.scrollLine
                        if (y < ty) {
                            newScroll = newScroll - page
                        } else {
                            newScroll = newScroll + page
                        }
                        if (newScroll < 0) { newScroll = 0 }
                        if (newScroll > maxS) { newScroll = maxS }
                        if (newScroll != this.scrollLine) {
                            this.scrollLine = newScroll
                            this.forceRepaintNow()
                        }
                    }
                    return true
                }
                // Other events inside the lane are swallowed so they
                // don't fall through into the cursor-positioning path
                // and move the cursor under the bar.
                return false
            }

            if (type == MouseEventType.down && button == MouseButton.left && this.contains(x, y)) {
                // Claim keyboard focus so subsequent typing routes to
                // this editor — the CliView in a bottom panel
                // otherwise keeps focus from its own click and
                // would swallow our keys.
                var vc = this.getViewContext()
                if (vc != null) {
                    var w = vc.getWindow()
                    if (w != null) {
                        w.setKeyboardFocus(this)
                    }
                }

                var oldLine = this.cursorLine
                var lineHeight = this.getLineHeight()
                var lastLine = this.lines.getSize() - 1
                if (lineHeight <= 0S) {
                    return base.onMouseEvent(type, button, x, y)
                }
                // y is in viewport coords (0 = top of editor area).
                // Add scrollLine back to recover the absolute line
                // index in the buffer.
                var newLine = (y.toInt() / lineHeight.toInt()) + this.scrollLine
                if (newLine < 0) { newLine = 0 }
                if (newLine > lastLine) { newLine = lastLine }
                var lineText = this.lines.get(newLine)
                // x is viewport-relative; add scrollPixelX back to
                // recover the click position in the line's own
                // pixel space, which is what colForPixelX expects.
                var newCol = this.colForPixelX(lineText, x + this.scrollPixelX)
                this.cursorLine = newLine
                this.cursorCol = newCol
                this.markCursorMoveDirty(oldLine)
                // Click resets the selection: drop any prior range,
                // exit block mode (per the user spec — "turned off
                // with click"), then plant the new anchor at the
                // cursor. We start tracking a drag immediately;
                // if the user releases without moving we'll detect
                // anchor == cursor and clearSelection() on up.
                var hadSelection = this.hasSelection() || this.selMode != 0
                this.selMode = 0
                this.selAnchorLine = newLine
                this.selAnchorCol = newCol
                this.selDragging = true
                if (hadSelection) {
                    // Old highlight has to clear from the previously-
                    // selected rows.
                    this.forceFullRepaint()
                }
                this.requestRepaint()
                this.fireCursorChanged()
                return true
            }
            // Mouse drag extends the selection while the left button
            // is held. The cursor follows the pointer; the anchor
            // stays where it was on the original press.
            if (type == MouseEventType.move && this.selDragging) {
                var lineHeight = this.getLineHeight()
                if (lineHeight <= 0S) {
                    return true
                }
                var lastLine = this.lines.getSize() - 1
                var newLine = (y.toInt() / lineHeight.toInt()) + this.scrollLine
                if (newLine < 0) { newLine = 0 }
                if (newLine > lastLine) { newLine = lastLine }
                var lineText = this.lines.get(newLine)
                var newCol = this.colForPixelX(lineText, x + this.scrollPixelX)
                if (newLine != this.cursorLine || newCol != this.cursorCol) {
                    var oldLine = this.cursorLine
                    this.cursorLine = newLine
                    this.cursorCol = newCol
                    this.markCursorMoveDirty(oldLine)
                    // Selection bounds changed — every line between
                    // the anchor row and the cursor row may need a
                    // repaint, so don't try to be clever with partial
                    // dirty tracking.
                    this.forceFullRepaint()
                    this.requestRepaint()
                    this.fireCursorChanged()
                }
                return true
            }
            // Mouse-up ends the drag. If the cursor never left the
            // anchor (= just a click, no movement), drop the
            // pseudo-selection so hasSelection() returns false.
            if (type == MouseEventType.up && this.selDragging) {
                this.selDragging = false
                if (!this.hasSelection()) {
                    this.clearSelection()
                }
                return true
            }
            return base.onMouseEvent(type, button, x, y)
        }

        // Wheel scrolls the buffer without moving the cursor.
        // 3 lines per tick — fast enough to feel responsive on long
        // files, slow enough to land on a specific row.
        override fun onMouseWheel(deltaY: Short, x: Short, y: Short): Bool {
            if (!this.contains(x, y)) {
                return false
            }
            var totalLines = this.lines.getSize()
            var visible = this.visibleLineCount()
            var maxScroll = totalLines - visible
            if (maxScroll < 0) {
                maxScroll = 0
            }
            var newScroll = this.scrollLine + (deltaY.toInt() * 3)
            if (newScroll < 0) {
                newScroll = 0
            }
            if (newScroll > maxScroll) {
                newScroll = maxScroll
            }
            if (newScroll == this.scrollLine) {
                return true
            }
            this.scrollLine = newScroll
            this.forceFullRepaint()
            this.requestRepaint()
            return true
        }

        override fun onKeyboardEvent(type: KeyboardEventType, keyCode: UShort, keyChar: UShort): Bool {
            // Focus gate: only consume keys when we're the focused
            // view, so typing in the terminal isn't echoed into the
            // active editor as well. A null focus means "nothing is
            // claiming keys" — in that case let the editor handle
            // so initial typing still works without a click.
            var vc = this.getViewContext()
            if (vc != null) {
                var w = vc.getWindow()
                if (w != null) {
                    var focus = w.getKeyboardFocus()
                    if (focus != null && focus != this) {
                        return false
                    }
                }
            }
            if (type != KeyboardEventType.down) {
                return false
            }
            // Ctrl+B — start (or end) a selection ("block" in Amiga
            // terminology = selected area). First press plants the
            // anchor at the cursor; arrow keys then extend the
            // selection from the anchor. Second press releases the
            // anchor and clears the selection. Click in the editor
            // also clears (handled in onMouseEvent).
            if (keyChar == 2US) {
                if (this.selMode == 0) {
                    this.selMode = 1
                    this.selAnchorLine = this.cursorLine
                    this.selAnchorCol = this.cursorCol
                } else {
                    this.selMode = 0
                    this.clearSelection()
                }
                this.forceFullRepaint()
                this.requestRepaint()
                return true
            }
            // Selection lifecycle on key press:
            //   - Arrow keys EXTEND any active selection (block or
            //     flowing): the anchor stays planted, the cursor moves
            //     below. Rendering shape (rectangle vs. flow) comes
            //     from selMode in drawLine, not from this branch.
            //   - Edit ops (typing, Enter, Backspace, Tab) clear any
            //     selection so the edit lands at a fresh cursor.
            //     Handled below, in-line with each op.
            //   - Ctrl-modifier shortcuts (Ctrl+C, Ctrl+V, Ctrl+F,
            //     Ctrl+G, Ctrl+/) deliberately PRESERVE the selection
            //     so e.g. Ctrl+C on a block can copy it.
            //   - Click (in onMouseEvent) clears the selection, plants
            //     a new anchor at the click position.
            var isArrow = keyCode == 76US || keyCode == 77US
                || keyCode == 78US || keyCode == 79US
            if (isArrow && (this.selMode == 1 || this.hasSelection())) {
                this.forceFullRepaint()
            }
            // AmigaOS raw key codes for arrows. The native handler
            // tags shifted arrows with keyChar=1 — we route Shift+Up
            // and Shift+Down to page navigation (the Amiga keyboard
            // has no dedicated PgUp/PgDn keys; this matches the
            // long-standing CED convention).
            if (keyCode == 76US && keyChar == 1US) {
                this.pageUp()
                return true
            }
            if (keyCode == 77US && keyChar == 1US) {
                this.pageDown()
                return true
            }
            // Shift+Left / Shift+Right — same keyChar=1 shift marker
            // as the page-nav arrows. Jumps several cols at a time,
            // clamped to the line — no wrap into the prev/next line.
            if (keyCode == 79US && keyChar == 1US) {
                this.skipLeft()
                return true
            }
            if (keyCode == 78US && keyChar == 1US) {
                this.skipRight()
                return true
            }
            if (keyCode == 79US) {
                this.moveCursorLeft()
                return true
            }
            if (keyCode == 78US) {
                this.moveCursorRight()
                return true
            }
            if (keyCode == 76US) {
                this.moveCursorUp()
                return true
            }
            if (keyCode == 77US) {
                this.moveCursorDown()
                return true
            }
            // Backspace with an active selection DELETES the selection
            // rather than just dropping it. Handled here — above the
            // generic isEditOp clear-selection block below — because
            // that block would otherwise wipe selAnchor before we ever
            // read the selection range. Pushes one undo entry so Ctrl+Z
            // restores the selection AND its text in a single step.
            if (keyChar == 8US && this.hasSelection()) {
                this.pushUndo()
                this.deleteSelection()
                return true
            }
            // Ctrl+X — cut (copy + delete selection, or cut current
            // line as fallback). Sits above the isEditOp clear because
            // its selection-delete path needs the range intact; keyChar
            // 24 isn't in isEditOp anyway (out of the printable range),
            // so no functional overlap.
            if (keyChar == 24US) {
                this.cutSelectionOrLine()
                return true
            }
            // Edit ops clear any active selection before the edit
            // (typing replaces selection vs. deleting it is a future
            // feature; today we just drop it and apply the edit at
            // the cursor's current position). Modifier shortcuts
            // (Ctrl+C/V/F/G//) are checked further down and never
            // touch the selection.
            var isEditOp = keyChar == 8US || keyChar == 13US || keyChar == 10US
                || keyChar == 9US || (keyChar >= 32US && keyChar <= 126US)
            if (isEditOp && (this.hasSelection() || this.selMode != 0)) {
                this.selMode = 0
                this.clearSelection()
                this.forceFullRepaint()
                this.requestRepaint()
            }
            // ASCII char keys.
            if (keyChar == 8US) {
                this.backspace()
                return true
            }
            // Ctrl+C — copy the current line. Falls back to a
            // line-level copy until a real selection model lands;
            // most users still get the "copy this snippet" reflex.
            if (keyChar == 3US) {
                this.copyCurrentLine()
                return true
            }
            // Ctrl+V — paste at the cursor. Multi-line clipboard
            // content splits on \n and inserts a newline between
            // each segment; \r is dropped (handles CRLF input).
            if (keyChar == 22US) {
                this.pasteAtCursor()
                return true
            }
            // Ctrl+Z — undo the most recent edit; Ctrl+Shift+Z — redo.
            // Per-editor history (each TextEditor instance has its own
            // undoStack / redoStack), so tabs don't share state. Falls
            // through and is consumed even when the stack was empty so
            // a missing-handler fallback doesn't insert 0x1A literally.
            //
            // The Shift bit rides on `keyCode` for Ctrl+letter combos:
            // 1 means Shift was held, 0 means Ctrl only — see the
            // amiga_code encoding in macos-arm/Am/Ui/Window.c. Older
            // Ctrl-only handlers only look at keyChar and remain
            // undisturbed.
            if (keyChar == 26US) {
                if (keyCode == 1US) {
                    this.redo()
                } else {
                    this.undo()
                }
                return true
            }
            // Ctrl+/ — toggle line comment on the cursor's line.
            // Routes through an open hook so HighlightedTextEditor
            // can apply the per-language commentLinePrefix; the base
            // class no-ops since vanilla TextEditor has no notion of
            // "what's a comment in this buffer". Most Amiga keymaps
            // send 0x1F for Ctrl+/, same as terminal Unix.
            if (keyChar == 31US) {
                if (this.toggleLineComment()) {
                    return true
                }
            }
            // Ctrl+F — open the embedder's find UI. The editor
            // doesn't own the find bar itself (it lives in the
            // IDE chrome so multiple tabs can share one); the
            // embedder wires `findRequestedListener` to bring the
            // bar up. We swallow the key only if a listener is
            // installed — otherwise Ctrl+F falls through and gets
            // inserted as `\x06` (the ASCII code itself), which is
            // wrong but at least visible.
            if (keyChar == 6US) {
                var fr = this.findRequestedListener
                if (fr != null) {
                    return fr()
                }
            }
            // Ctrl+G — find-next using the previously-entered query.
            // Embedder wires `findNextListener` so the find bar
            // doesn't need to be open to step through matches. Same
            // swallow-only-if-handled rule as Ctrl+F.
            if (keyChar == 7US) {
                var fn = this.findNextListener
                if (fn != null) {
                    return fn()
                }
            }
            // Ctrl+S — fire the embedder's "save this buffer" hook.
            // No-op (and falls through) when no listener is wired.
            if (keyChar == 19US) {
                var sl = this.saveRequestedListener
                if (sl != null) {
                    return sl()
                }
            }
            // Ctrl+A — select entire buffer. Only fires from a plain
            // Ctrl+A press, NOT from the arrow-key-with-Shift path
            // (those come with keyCode = 76/77/78/79 alongside the
            // keyChar==1 signal, filtered by the earlier arrow blocks
            // above so control doesn't fall through to here).
            if (keyChar == 1US) {
                this.selectAll()
                return true
            }
            if (keyChar == 13US || keyChar == 10US) {
                this.insertNewLine()
                return true
            }
            // Tab — insert literal tab for now.
            if (keyChar == 9US) {
                this.insertChar(9US)
                return true
            }
            if (keyChar >= 32US && keyChar <= 126US) {
                this.insertChar(keyChar)
                return true
            }
            return false
        }

        // Ctrl+C — copy the active selection to the clipboard. With
        // no selection, falls back to copying the current line so the
        // "copy this snippet" reflex still works without first
        // marking. After copying, the selection is cleared (the user
        // already has the content on the clipboard — keeping the
        // highlight live invites accidental overwrite on the next
        // keystroke).
        private fun copyCurrentLine() {
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var w = vc.getWindow()
            if (w == null) {
                return
            }
            var hadSelection = this.hasSelection()
            var payload: String? = null
            if (hadSelection) {
                payload = this.getSelectedText()
            } else {
                payload = this.currentLine()
            }
            w.copyToClipboard(payload)
            if (hadSelection || this.selMode != 0) {
                this.selMode = 0
                this.clearSelection()
                this.forceFullRepaint()
                this.requestRepaint()
            }
        }

        // Concatenate the lines the selection covers into a single
        // string, with `\n` between rows. The start row contributes
        // from selStartCol() to EOL; middle rows contribute fully;
        // the end row contributes from col 0 to selEndCol(). When the
        // selection is on a single row it's just the substring between
        // the start and end cols.
        fun getSelectedText(): String {
            if (!this.hasSelection()) {
                return ""
            }
            var sStart = this.selStartLine()
            var sEnd = this.selEndLine()
            if (sStart == sEnd) {
                var only = this.lines.get(sStart)
                var a = this.selStartCol()
                var b = this.selEndCol()
                if (a < 0) { a = 0 }
                if (b > only.length()) { b = only.length() }
                if (b <= a) {
                    return ""
                }
                return only.substring(a.toUInt(), b.toUInt())
            }
            var sb = new StringBuilder()
            // Start row: from selStartCol to EOL.
            var startLine = this.lines.get(sStart)
            var startCol = this.selStartCol()
            if (startCol < 0) { startCol = 0 }
            if (startCol < startLine.length()) {
                sb.add(startLine.substring(startCol.toUInt(), startLine.length().toUInt()))
            }
            sb.addChar(0x000AUS)
            // Middle rows in full.
            var i = sStart + 1
            while (i < sEnd) {
                sb.add(this.lines.get(i))
                sb.addChar(0x000AUS)
                i = i + 1
            }
            // End row: from col 0 to selEndCol.
            var endLine = this.lines.get(sEnd)
            var endCol = this.selEndCol()
            if (endCol > endLine.length()) { endCol = endLine.length() }
            if (endCol > 0) {
                sb.add(endLine.substring(0UI, endCol.toUInt()))
            }
            return sb.toString()
        }

        // Remove the current selection from the buffer, leaving the
        // cursor at the (former) selection start. No-op if there's no
        // active selection. Caller is responsible for pushUndo() BEFORE
        // this runs so cut / selection-backspace remain single-step
        // undoable.
        //
        // The mechanics mirror pasteAtCursor's splice logic inverted:
        // single-line selections shorten one row; multi-line selections
        // fuse the start row's prefix with the end row's suffix into
        // one row, then drop everything strictly between.
        fun deleteSelection() {
            if (!this.hasSelection()) {
                return
            }
            var sStart = this.selStartLine()
            var sEnd = this.selEndLine()
            var startCol = this.selStartCol()
            var endCol = this.selEndCol()
            if (startCol < 0) { startCol = 0 }
            if (sStart == sEnd) {
                var line = this.lines.get(sStart)
                if (endCol > line.length()) { endCol = line.length() }
                var before = ""
                var after = ""
                if (startCol > 0) {
                    before = line.substring(0UI, startCol.toUInt())
                }
                if (endCol < line.length()) {
                    after = line.substringToEnd(endCol.toUInt())
                }
                this.lines.set(sStart, before + after)
            } else {
                var startLine = this.lines.get(sStart)
                var endLine = this.lines.get(sEnd)
                if (endCol > endLine.length()) { endCol = endLine.length() }
                var before = ""
                var after = ""
                if (startCol > 0) {
                    before = startLine.substring(0UI, startCol.toUInt())
                }
                if (endCol < endLine.length()) {
                    after = endLine.substringToEnd(endCol.toUInt())
                }
                this.lines.set(sStart, before + after)
                // Drop rows (sStart+1) .. sEnd inclusive. Delete
                // repeatedly at the same index — each removeAt shifts
                // successors down by one, so the "next" row keeps
                // arriving at sStart+1.
                var toRemove = sEnd - sStart
                var ri = 0
                while (ri < toRemove) {
                    this.lines.removeAt(sStart + 1)
                    ri = ri + 1
                }
            }
            this.cursorLine = sStart
            this.cursorCol = startCol
            this.selMode = 0
            this.clearSelection()
            // Line count may have changed by an arbitrary amount and
            // rows below the deletion shifted up; a partial dirty range
            // can't express that in one frame.
            this.forceFullRepaint()
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
            this.onContentChanged()
        }

        // Ctrl+X — copy the active selection to the clipboard, then
        // delete it. With no selection, falls back to cutting the
        // current line (matches copyCurrentLine's line-level fallback
        // and mirrors VS Code / JetBrains behaviour). Pushes a single
        // undo entry so Ctrl+Z restores the buffer AND the cursor.
        private fun cutSelectionOrLine() {
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var w = vc.getWindow()
            if (w == null) {
                return
            }
            if (this.hasSelection()) {
                var payload = this.getSelectedText()
                w.copyToClipboard(payload)
                this.pushUndo()
                this.deleteSelection()
                return
            }
            // No selection: cut the current line. Removes the row
            // entirely (empties the buffer to a single blank line when
            // the last line is cut, since the model requires at least
            // one row).
            var lineText = this.currentLine()
            var payload = lineText + "\n"
            w.copyToClipboard(payload)
            this.pushUndo()
            var lineCount = this.lines.getSize()
            if (lineCount <= 1) {
                this.lines.set(0, "")
                this.cursorLine = 0
                this.cursorCol = 0
            } else {
                this.lines.removeAt(this.cursorLine)
                if (this.cursorLine >= this.lines.getSize()) {
                    this.cursorLine = this.lines.getSize() - 1
                }
                var newLine = this.lines.get(this.cursorLine)
                if (this.cursorCol > newLine.length()) {
                    this.cursorCol = newLine.length()
                }
            }
            this.forceFullRepaint()
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
            this.onContentChanged()
        }

        // Paste the system clipboard's contents at the cursor.
        // Iterates the string char-by-char; on LF the buffer
        // breaks the current line into a new one (insertNewLine),
        // on CR we skip (CRLF normalisation), everything else
        // routes through insertChar so the existing dirty / cursor
        // / scroll plumbing fires per char.
        // Ctrl+V — splice the clipboard's text in at the cursor. CRLF
        // is normalised to LF (we drop bare CR), and embedded LFs
        // split the current line into segments. Goes straight to the
        // lines list rather than routing each char through insertChar /
        // insertNewLine — pasted content must land verbatim, and the
        // smart-indent / auto-pair / skip-closer hooks would otherwise
        // mangle it (every embedded LF would re-apply the previous
        // line's leading whitespace, compounding into a pyramid
        // slope; a pasted `(` would auto-pair an extra `)`).
        private fun pasteAtCursor() {
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var w = vc.getWindow()
            if (w == null) {
                return
            }
            var text = w.pasteFromClipboard()
            if (text == null || text.length() == 0) {
                return
            }
            // Snapshot BEFORE the buffer mutates. One push per paste,
            // not per char — Ctrl+Z undoes the whole paste as a unit.
            this.pushUndo()
            // Split clipboard into per-line segments, dropping any CR
            // along the way.
            var segments = new List<String>()
            var seg = new StringBuilder()
            var ti = 0
            while (ti < text.length()) {
                var ch = text.substring(ti.toUInt(), 1UI).toBytes("UTF-8")[0UI].toUShort()
                if (ch == 10US) {
                    segments.add(seg.toString())
                    seg = new StringBuilder()
                } else if (ch == 13US) {
                    // CRLF normalises to just the LF; drop the CR.
                } else {
                    seg.addChar(ch)
                }
                ti = ti + 1
            }
            segments.add(seg.toString())

            // Splice into the buffer. Current line gets:
            //   <before-cursor> + segments[0]
            // segments[1 .. -2] become standalone new lines.
            // The final line gets:
            //   segments[-1] + <after-cursor>
            // (When only one segment exists — clipboard had no LF —
            // both branches collapse to "insert into current line".)
            var curLineText = this.currentLine()
            var before = ""
            var after = ""
            if (this.cursorCol > 0) {
                before = curLineText.substring(0UI, this.cursorCol.toUInt())
            }
            if (this.cursorCol < curLineText.length()) {
                after = curLineText.substringToEnd(this.cursorCol.toUInt())
            }
            var nSeg = segments.getSize()
            if (nSeg == 1) {
                var only = segments.get(0)
                this.lines.set(this.cursorLine, before + only + after)
                this.cursorCol = before.length() + only.length()
            } else {
                // First segment: append to before, replace current
                // line.
                this.lines.set(this.cursorLine, before + segments.get(0))
                // Middle segments: insert as standalone lines below.
                var si = 1
                while (si < nSeg - 1) {
                    this.lines.insertAt(this.cursorLine + si, segments.get(si))
                    si = si + 1
                }
                // Final segment: gets the after-cursor remainder.
                var last = segments.get(nSeg - 1)
                this.lines.insertAt(this.cursorLine + nSeg - 1, last + after)
                this.cursorLine = this.cursorLine + nSeg - 1
                this.cursorCol = last.length()
            }
            // Whole-buffer paint is the safest signal post-paste —
            // line count may have changed by an arbitrary amount.
            this.forceFullRepaint()
            if (this.ensureCursorVisible()) {
                this.forceFullRepaint()
            }
            this.requestRepaint()
            this.fireContentChanged()
            this.fireCursorChanged()
            this.onContentChanged()
        }

        // -------- Editable interface --------
        //
        // Menu-driven Copy / Cut / Paste / Select-All / Toggle-Select-
        // Mode surface for the IDE Edit menu. All actions delegate to
        // the existing private helpers (copyCurrentLine wraps "copy
        // selection or fall back to current line", cutSelectionOrLine
        // mirrors the same fallback for cut) so the menu path and the
        // Ctrl-shortcut path stay bit-identical.
        //
        // Every `can*` returns `true` so the items don't grey out
        // mid-edit — the underlying actions all handle "nothing to
        // do" gracefully (copy on an empty line = empty clipboard,
        // paste with empty clipboard = no-op, etc.), and grey-out
        // would flip on every selection / clipboard change and
        // require a much heavier notification pipeline.
        override fun canCopy(): Bool {
            return true
        }
        override fun canCut(): Bool {
            return true
        }
        override fun canPaste(): Bool {
            return true
        }
        override fun canSelectAll(): Bool {
            return true
        }
        override fun canToggleSelectMode(): Bool {
            return true
        }
        override fun editCopy(): Bool {
            this.copyCurrentLine()
            return true
        }
        override fun editCut(): Bool {
            this.cutSelectionOrLine()
            return true
        }
        override fun editPaste(): Bool {
            this.pasteAtCursor()
            return true
        }
        override fun editSelectAll(): Bool {
            this.selectAll()
            return true
        }
        override fun editToggleSelectMode(): Bool {
            // Same toggle path Ctrl+B uses in onKeyboardEvent: first
            // press plants the anchor at the caret; second press
            // clears it. Kept in one place there — this just wraps
            // the same state flip so the menu item shows the same
            // behaviour as the shortcut.
            if (this.selMode == 0) {
                this.selMode = 1
                this.selAnchorLine = this.cursorLine
                this.selAnchorCol = this.cursorCol
            } else {
                this.selMode = 0
                this.clearSelection()
            }
            this.forceFullRepaint()
            this.requestRepaint()
            return true
        }
        override fun canUndo(): Bool {
            return true
        }
        override fun canRedo(): Bool {
            return true
        }
        override fun editUndo(): Bool {
            this.undo()
            return true
        }
        override fun editRedo(): Bool {
            this.redo()
            return true
        }
    }
}
