namespace Am.Ui 
{

    class TextField : View {
        import Am.Lang

        private var text: String = ""
        // Focus is now sourced from the Window's keyboardFocus
        // (`window.getKeyboardFocus() == this`), so `isFocused()`
        // reflects window-wide state — only one focusable in the
        // window can be focused at a time, and losing focus to a
        // sibling field automatically swaps our cursor styling
        // (filled ↔ hollow) on the next paint thanks to Window
        // requesting a repaint on both old + new focus views.
        //
        // Direct callers of the legacy `setFocused()` API still work
        // — that method now just delegates to
        // window.setKeyboardFocus / clearKeyboardFocus.
        private var cursorPosition: Int = 0
        private var selectionStart: Int = 0
        private var selectionEnd: Int = 0
        private var scrollOffset: Short = 0S  // Horizontal scroll offset in pixels
        private var isDragging: Bool = false  // Track if we're dragging to select text
        private var dragStartPosition: Int = 0  // Track where drag selection started
        var maxLength: Int = 255
        var placeholder: String = ""
        var readOnly: Bool = false
        var passwordMode: Bool = false
        // When true, the cursor is replaced by a vertically-pulsing
        // bar that shrinks to zero height and grows back to the
        // full caret height, looping forever. Used as a poor-man's
        // spinner while the owning view is waiting for an async
        // operation. Caller is expected to flip readOnly too so the
        // user can't type into a "loading" field.
        //
        // Animation is time-driven (Date.now().getValue() mod cycle
        // ms) so no external ticker is required — paint() simply
        // re-requests a repaint at the end of every frame while
        // spinnerMode is on.
        var spinnerMode: Bool = false
        // Full cycle length for the spinner pulse, in ms. Triangular
        // wave: 0 → full → 0 once per cycle.
        private static const SPINNER_CYCLE_MS: Long = 600L

        // Fires on Tab or Enter while focused. Receives the current
        // text. Used by callers (e.g. FolderTreeView's inline
        // create-new-entry flow) to commit the edit.
        var submitListener: (text: String) => Bool = null
        // Fires on ESC. Used to cancel an in-progress inline edit.
        var cancelListener: () => Bool = null
        
        var textPen: UByte = 1UB
        var backgroundPen: UByte = 0UB
        var focusedBackgroundPen: UByte = 0UB
        var placeholderPen: UByte = 2UB
        var selectionPen: UByte = 3UB
        // Cursor fill / outline pen. Default kept at 3UB so unthemed
        // callers behave as before; themed apps should set this to
        // their accent (typically a blue) to match the CliView caret.
        var cursorPen: UByte = 3UB
        // Pen used to redraw a glyph that sits under the filled
        // cursor when focused, so it stays legible against the
        // cursor fill. Defaults to white-ish so the inverted glyph
        // contrasts whatever cursorPen the caller picked.
        var cursorTextPen: UByte = 2UB
        
        // Outer border: 2UB on left and upper, 1UB on lower and right
        var outerBorderPens: BorderPens = new BorderPens(2UB, 2UB, 1UB, 1UB)
        var focusedOuterBorderPens: BorderPens = new BorderPens(2UB, 2UB, 1UB, 1UB)

        // Inner border: 1UB on upper and left, 2UB on lower and right
        var innerBorderPens: BorderPens = new BorderPens(1UB, 1UB, 2UB, 2UB)
        var focusedInnerBorderPens: BorderPens = new BorderPens(1UB, 1UB, 2UB, 2UB)

        init {
            // setDefaultPadding / setDefaultBorder aren't invoked
            // anywhere in the View hierarchy — nothing calls them on
            // construction. Without these, padding stays (0,0,0,0)
            // and borderWidths stays (0,0,0,0), so minHeight()
            // collapses to just fontHeight and the field renders as
            // a one-glyph-tall strip with descenders clipped against
            // the background. Calling them here lands the same 4×2
            // padding + 2px border that the override declarations
            // already advertise as the widget's default look.
            this.setDefaultPadding()
            this.setDefaultBorder()
        }

        // Window-level mouse listener that clears our focus on any
        // mouseDown that lands outside our bounds — including clicks
        // routed to a different LayeredPane layer that never reach
        // our regular onMouseEvent. Held so onDetach can deregister.
        private var windowMouseListener: MouseEventListener = null

        override fun onAttach(viewContext: ViewContext) {
            base.onAttach(viewContext)
            var win = viewContext.getWindow()
            if (win == null) {
                return
            }
            var self = this
            var l = new MouseEventListener()
            l.listener = (me) => {
                if (me.type != MouseEventType.down) {
                    return false
                }
                var vc = self.getViewContext()
                if (vc == null) {
                    return false
                }
                var w = vc.getWindow()
                if (w == null) {
                    return false
                }
                // Only act when we're actually the focused view —
                // saves a rect compute on every cross-window click.
                if (w.getKeyboardFocus() != self) {
                    return false
                }
                var rect = self.computeWindowRect()
                var mx = w.getLastMouseX()
                var my = w.getLastMouseY()
                var x2 = rect.x + rect.width.toShort()
                var y2 = rect.y + rect.height.toShort()
                if (mx < rect.x || mx >= x2 || my < rect.y || my >= y2) {
                    w.clearKeyboardFocus(self)
                }
                return false
            }
            this.windowMouseListener = l
            win.addMouseEventListener(l)
        }

        override fun onDetach() {
            if (this.windowMouseListener != null) {
                var vc = this.getViewContext()
                if (vc != null) {
                    var win = vc.getWindow()
                    if (win != null) {
                        win.removeMouseEventListener(this.windowMouseListener)
                    }
                }
                this.windowMouseListener = null
            }
            base.onDetach()
        }

        fun getText(): String {
            return this.text
        }

        fun setText(text: String) {
            if (text.length() > this.maxLength) {
                this.text = text.substring(0UI, this.maxLength.toUInt())
            } else {
                this.text = text
            }
            this.cursorPosition = this.text.length()
            this.clearSelection()
            this.updateScrollOffset()
            this.requestRepaint()
        }

        fun setPlaceholder(placeholder: String) {
            this.placeholder = placeholder
            this.requestRepaint()
        }

        fun getPlaceholder(): String {
            return this.placeholder
        }

        // Legacy entry point — kept so callers that explicitly
        // grab/release focus on a field still work. Routes through
        // the Window's keyboard-focus tracker which itself fires
        // focus-changed listeners and requests repaints on the
        // previously-focused and newly-focused views.
        fun setFocused(focused: Bool) {
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var win = vc.getWindow()
            if (win == null) {
                return
            }
            if (focused) {
                win.setKeyboardFocus(this)
            } else {
                win.clearKeyboardFocus(this)
            }
        }

        // True when this TextField holds the window's keyboard focus.
        // Single source of truth — no separate `focused` field on
        // the TextField to fall out of sync with the Window. paint()
        // / placeholder-visible / drag-active logic all read here.
        fun isFocused(): Bool {
            var vc = this.getViewContext()
            if (vc == null) {
                return false
            }
            var win = vc.getWindow()
            if (win == null) {
                return false
            }
            return win.getKeyboardFocus() == this
        }


        fun setCursorPosition(position: Int) {
            if (position < 0) {
                this.cursorPosition = 0
            } else if (position > this.text.length()) {
                this.cursorPosition = this.text.length()
            } else {
                this.cursorPosition = position
            }
            this.updateScrollOffset()
            this.requestRepaint()
        }

        private fun updateScrollOffset() {
            var window = this.getWindow()
            if (window == null) {
                return
            }

            // Calculate available text width
            var textWidth = this.innerWidth() - this.padding.left - this.padding.right
            if (textWidth <= 0S) {
                return
            }

            // Get display text (accounting for password mode)
            var displayText = this.text
            if (this.passwordMode) {
                var stars = ""
                var i = 0
                while (i < displayText.length()) {
                    stars = stars + "*"
                    i = i + 1
                }
                displayText = stars
            }

            // Calculate cursor X position relative to text start (without scroll offset)
            var cursorX: Short = 0S
            if (this.cursorPosition > 0) {
                var beforeCursor = displayText.substring(0UI, this.cursorPosition.toUInt())
                cursorX = window.calculateStringWidth(null, beforeCursor).toShort()
            }

            // Calculate cursor width (for when cursor is at end or on a character)
            var cursorWidth: Short = 0S
            if (this.cursorPosition < displayText.length()) {
                // Cursor is on a character - get that character's width
                var cursorChar = displayText.substring(this.cursorPosition.toUInt(), 1UI)
                cursorWidth = window.calculateStringWidth(null, cursorChar).toShort()
            } else {
                // Cursor is at end of text - use width of "X" as cursor width
                cursorWidth = window.calculateStringWidth(null, "X").toShort()
            }

            // Calculate cursor position relative to visible area (with current scroll offset)
            var visibleCursorX = cursorX - this.scrollOffset
            var visibleCursorEndX = visibleCursorX + cursorWidth

            // Check if cursor (including its width) is outside the right edge
            if (visibleCursorEndX > textWidth) {
                // Scroll right to fit cursor (including its width) exactly at the right edge
                this.scrollOffset = cursorX + cursorWidth - textWidth
            }
            // Check if cursor is outside the left edge
            else if (visibleCursorX < 0S) {
                // Scroll left to fit cursor exactly at the left edge
                this.scrollOffset = cursorX
            }

            // Ensure scroll offset doesn't go negative
            if (this.scrollOffset < 0S) {
                this.scrollOffset = 0S
            }
        }

        fun getCursorPosition(): Int {
            return this.cursorPosition
        }

        private fun moveCursor(newPosition: Int, extendSelection: Bool) {
            if (newPosition < 0) {
                newPosition = 0
            } else if (newPosition > this.text.length()) {
                newPosition = this.text.length()
            }

            if (extendSelection) {
                if (!this.hasSelection()) {
                    // Start selection from current cursor position
                    this.selectionStart = this.cursorPosition
                }
                this.selectionEnd = newPosition
                this.cursorPosition = newPosition
            } else {
                this.cursorPosition = newPosition
                this.clearSelection()
            }
            
            this.updateScrollOffset()
            this.requestRepaint()
        }

        private fun clearSelection() {
            this.selectionStart = this.cursorPosition
            this.selectionEnd = this.cursorPosition
        }

        private fun hasSelection(): Bool {
            var result = this.selectionStart != this.selectionEnd
            return result
        }

        private fun isSelecting(): Bool {
            return this.isDragging && this.isFocused()
        }

        fun setSelection(start: Int, end: Int) {
            this.selectionStart = start
            this.selectionEnd = end
            if (end >= start) {
                this.cursorPosition = end
            } else {
                this.cursorPosition = start
            }
            this.updateScrollOffset()
            this.requestRepaint()
        }

        fun getSelectionStart(): Int {
            return this.selectionStart
        }

        fun getSelectionEnd(): Int {
            return this.selectionEnd
        }

        fun selectAll() {
            this.selectionStart = 0
            this.selectionEnd = this.text.length()
            this.cursorPosition = this.selectionEnd
            this.requestRepaint()
        }

        fun copySelectedText() {
            if (!this.hasSelection()) {
                return
            }
            
            var start = this.selectionStart
            var end = this.selectionEnd
            
            // Ensure start <= end
            if (start > end) {
                var temp = start
                start = end
                end = temp
            }
            
            var selectedText = this.text.substring(start.toUInt(), (end - start).toUInt())
            
            // Get the window and copy to clipboard
            var window = this.getWindow()
            if (window != null) {
                window.copyToClipboard(selectedText)
            }
        }

        fun pasteText() {
            // Get the window and paste from clipboard
            var window = this.getWindow()
            if (window != null) {
                var clipboardText = window.pasteFromClipboard()
                if (clipboardText != null) {
                    // insertText() already handles selection replacement properly
                    this.insertText(clipboardText)
                }
                // If clipboardText is null, do nothing (clipboard is empty)
            }
        }

        private fun textUpdated() {

        }

        fun insertText(newText: String) {
            if (this.readOnly) {
                return
            }

            var insertPosition = this.cursorPosition
            
            if (this.hasSelection()) {
                // Replace selection
                var start = this.selectionStart
                var end = this.selectionEnd
                
                // Ensure start <= end
                if (start > end) {
                    var temp = start
                    start = end
                    end = temp
                }
                
                var beforeSelection = this.text.substring(0UI, start.toUInt())
                var afterSelection = this.text.substring(end.toUInt(), (this.text.length() - end).toUInt())
                this.text = beforeSelection + newText + afterSelection
                insertPosition = start + newText.length()
            } else {
                // Insert at cursor
                var beforeCursor = this.text.substring(0UI, this.cursorPosition.toUInt())
                var afterCursor = this.text.substring(this.cursorPosition.toUInt(), (this.text.length() - this.cursorPosition).toUInt())
                this.text = beforeCursor + newText + afterCursor
                insertPosition = this.cursorPosition + newText.length()
            }

            // Trim to max length
            if (this.text.length() > this.maxLength) {
                this.text = this.text.substring(0UI, this.maxLength.toUInt())
                if (insertPosition > this.maxLength) {
                    insertPosition = this.maxLength
                }
            }

            this.setCursorPosition(insertPosition)
            this.clearSelection()
            this.requestRepaint()
        }

        fun deleteBackward() {
            if (this.readOnly) {
                return
            }

            if (this.hasSelection()) {
                this.insertText("")
            } else if (this.cursorPosition > 0) {
                var beforeCursor = this.text.substring(0UI, (this.cursorPosition - 1).toUInt())
                var afterCursor = this.text.substring(this.cursorPosition.toUInt(), (this.text.length() - this.cursorPosition).toUInt())
                this.text = beforeCursor + afterCursor
                this.setCursorPosition(this.cursorPosition - 1)
            }
            this.requestRepaint()
        }

        fun deleteForward() {
            if (this.readOnly) {
                return
            }

            if (this.hasSelection()) {
                this.insertText("")
            } else if (this.cursorPosition < this.text.length()) {
                var beforeCursor = this.text.substring(0UI, this.cursorPosition.toUInt())
                var afterCursor = this.text.substringToEnd((this.cursorPosition + 1).toUInt())
                this.text = beforeCursor + afterCursor
                this.requestRepaint()
            }
        }

        override fun setDefaultPadding() {
            this.setPadding(4S, 2S)
        }

        override fun setDefaultBorder() {
            this.setBorderWidths(2S) // Static border width - scaling handled during drawing
        }

        override fun minHeight(): Short {
            var vc = this.getViewContext()
            var fontHeight: Short = 0S
            if (vc != null) {
                fontHeight = vc.getWindow().getCurrentFontSize().toShort()
            } else {
                fontHeight = 12S
            }
            return fontHeight + base.minHeight()
        }

        override fun minWidth(): Short {
            return 100S + base.minWidth()
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            var innerW = this.innerWidth()
            var innerH = this.innerHeight()
            var x1 = 0S
            var y1 = 0S
            var x2 = this.width.toShort() - (this.margin.right + this.margin.left + 1S)
            var y2 = this.height.toShort() - (this.margin.bottom + this.margin.top + 1S)

            // Draw background
            var bgPen: UByte = 0UB
            if (this.isFocused()) {
                bgPen = this.focusedBackgroundPen
            } else {
                bgPen = this.backgroundPen
            }
            graphics.setForegroundPen(this.backgroundPen)
            graphics.fillRect(x1, y1, x2, y2)
            // Pin the rastport's bg pen to the field bg so every
            // subsequent drawString in this paint pass draws glyph
            // cells in the same colour as the fillRect above —
            // without this, the cells inherit whatever pen the
            // previous paint cycle left set (often a light grey)
            // and the text looks like it sits on its own opaque
            // block. The cursor / selection paths flip the bg pen
            // temporarily and restore to backgroundPen after, which
            // also reads back as the field bg.
            graphics.setBackgroundPen(bgPen)

            // Draw outer border
            var outerBorderPens: BorderPens
            if (this.isFocused()) {
                outerBorderPens = this.focusedOuterBorderPens
            } else {
                outerBorderPens = this.outerBorderPens
            }
            this.paintNativeBorder(graphics, outerBorderPens)
            
            // Draw inner border (1 pixel inside the outer border)
            var innerBorderPens: BorderPens
            if (this.isFocused()) {
                innerBorderPens = this.focusedInnerBorderPens
            } else {
                innerBorderPens = this.innerBorderPens
            }
            
            // Calculate inner border position using scaled pixel metrics
            var window = this.getWindow()
            var borderOffsetX = window.getScaledX(1S)
            var borderOffsetY = window.getScaledY(1S)
            var innerX1 = x1 + borderOffsetX
            var innerY1 = y1 + borderOffsetY
            var innerX2 = x2 - borderOffsetX
            var innerY2 = y2 - borderOffsetY
            
            // Draw inner border lines manually, using pixel metrics for proper scaling
            var scaledLineWidthX = window.getScaledX(1S)
            var scaledLineWidthY = window.getScaledY(1S)
            
            // Top line (1UB)
            graphics.setForegroundPen(innerBorderPens.top)
            graphics.drawLine(innerX1, innerY1, innerX2, innerY1)
            
            // Left line (1UB) - use scaled width for proper aspect ratio
            graphics.setForegroundPen(innerBorderPens.left)
            for (i = 0 to scaledLineWidthY.toUInt()) {
                var si = i.toShort()
                graphics.drawLine(innerX1 + si, innerY1, innerX1 + si, innerY2)
            }
            
            // Bottom line (2UB)
            graphics.setForegroundPen(innerBorderPens.bottom)
            graphics.drawLine(innerX1, innerY2, innerX2, innerY2)
            
            // Right line (2UB) - use scaled width for proper aspect ratio
            graphics.setForegroundPen(innerBorderPens.right)
            for (i = 0 to scaledLineWidthX.toUInt()) {
                var si = i.toShort()
                graphics.drawLine(innerX2 - si, innerY1, innerX2 - si, innerY2)
            }

            // Calculate text area
            var textX = this.borderWidths.left + this.padding.left
            var textY = this.borderWidths.top + this.padding.top
            var textWidth = innerW - this.padding.left - this.padding.right
            var textHeight = innerH - this.padding.top - this.padding.bottom

            // Set clipping area for text. The clip is extended by 1
            // pixel above and below textY+fontHeight so the caret's
            // top/bottom strips (filled cursor) or the hollow cursor's
            // top/bottom lines aren't cropped — drawCursor uses
            // y1 = textY - 1 and y2 = textY + fontHeight, which would
            // otherwise sit just outside a clip rect aligned to the
            // text rows. The 1-px gap is safe as long as padding.top
            // and padding.bottom are >= 1 (TextField's default is 2
            // and the IDE-themed fields use 8), so the extension
            // stays inside the inner content area and never bleeds
            // onto the field border.
            var currentClip = graphics.getCurrentClipRect()
            var textClipRect = currentClip.createInnerClipRect(textX, textY - 1S, textWidth.toUShort(), (textHeight + 2S).toUShort())

            graphics.pushClipRect(textClipRect)

            // Draw text or placeholder
            var displayText = this.text
            if (displayText.length() == 0 && !this.placeholder.length() == 0 && !this.isFocused()) {
                graphics.setForegroundPen(this.placeholderPen)
                graphics.drawString(this.placeholder, textX, textY)
            } else {
                if (this.passwordMode) {
                    var stars = ""
                    var i = 0
                    while (i < displayText.length()) {
                        stars = stars + "*"
                        i = i + 1
                    }
                    displayText = stars
                }
                
                var scrolledTextX = textX - this.scrollOffset
                var focused = this.isFocused()

                // A "real" selection only paints if focused AND it
                // spans at least one character. Anything else
                // (unfocused, collapsed range, no selection) falls
                // through to the plain-text-plus-cursor path.
                var drawSel = false
                if (focused && (this.hasSelection() || this.isSelecting())) {
                    var ss = this.selectionStart
                    var se = this.selectionEnd
                    if (ss > se) {
                        var tmp = ss
                        ss = se
                        se = tmp
                    }
                    drawSel = (ss != se)
                }

                if (drawSel) {
                    // Selection background + the un-selected text
                    // slices on either side.
                    this.drawSelection(graphics, displayText, scrolledTextX, textY)

                    var start = this.selectionStart
                    var end = this.selectionEnd
                    if (start > end) {
                        var temp = start
                        start = end
                        end = temp
                    }

                    if (start > 0) {
                        var beforeSelection = displayText.substring(0UI, start.toUInt())
                        graphics.setForegroundPen(this.textPen)
                        graphics.drawString(beforeSelection, scrolledTextX, textY)
                    }

                    if (end < displayText.length()) {
                        var afterSelection = displayText.substringToEnd(end.toUInt())
                        var afterSelectionX = scrolledTextX
                        if (end > 0) {
                            var beforeAfterSelection = displayText.substring(0UI, end.toUInt())
                            afterSelectionX = scrolledTextX + graphics.calculateStringWidth(beforeAfterSelection).toShort()
                        }
                        graphics.setForegroundPen(this.textPen)
                        graphics.drawString(afterSelection, afterSelectionX, textY)
                    }
                } else {
                    // Plain text. The cursor still paints in both
                    // focused and unfocused states (filled vs. hollow
                    // outline) to mirror CliView's caret semantics.
                    graphics.setForegroundPen(this.textPen)
                    graphics.drawString(displayText, scrolledTextX, textY)

                    if (this.cursorPosition <= displayText.length()) {
                        this.drawCursor(graphics, displayText, scrolledTextX, textY, focused)
                    }
                }
            }
            graphics.popClipRect()

            // Self-drive the spinner animation by re-queuing a paint
            // at the end of each frame. requestRepaint() is gated by
            // a `repaintRequested` flag so back-to-back calls inside
            // a single cycle are cheap; the next IDCMP refresh tick
            // brings us back here for the next frame.
            if (this.spinnerMode) {
                this.requestRepaint()
            }
        }

        // Spinner half-height in pixels for the current frame. Maps
        // the system clock through a triangular wave so the cursor
        // pulses from full height to zero and back over
        // SPINNER_CYCLE_MS ms. `fullSpan` is the full cursor height
        // in pixels (y2 - y1); the result is clamped into [0,
        // fullSpan/2] so the centred bar never exceeds the original
        // cursor's vertical footprint.
        private static fun spinnerHalfHeight(fullSpan: Short): Short {
            var fullHalf = (fullSpan / 2S).toLong()
            if (fullHalf <= 0L) {
                return 0S
            }
            var nowMs = Date.now().getValue().toLong()
            var t = nowMs % TextField.SPINNER_CYCLE_MS
            var half = TextField.SPINNER_CYCLE_MS / 2L
            // Triangle 0..half..0 across one full cycle. `tri` is
            // seeded to the falling-edge value so the renderer emits
            // the declaration — bare `var tri: Long` without an
            // initializer is silently dropped on amlc today.
            var tri: Long = TextField.SPINNER_CYCLE_MS - t
            if (t < half) {
                tri = t
            }
            // Map 0..half → 0..fullHalf
            return ((tri * fullHalf) / half).toShort()
        }

        // Paint the caret at `this.cursorPosition`.
        //
        // - focused  : filled rect in cursorPen + redraw the glyph
        //              under the caret inverted (cursorPen bg /
        //              cursorTextPen fg) so it stays legible.
        // - unfocused: 4-line hollow outline in cursorPen, no glyph
        //              repaint — the text underneath is already in
        //              textPen, so leaving it alone shows the
        //              character through the outline.
        //
        // The outline / fill cover the same y-band (textY-1 to
        // textY+fontHeight) so the cursor stays visually anchored
        // when focus moves between fields. Mirrors CliView's caret.
        private fun drawCursor(graphics: Graphics, displayText: String, scrolledTextX: Short, textY: Short, focused: Bool) {
            var cursorX = scrolledTextX
            if (this.cursorPosition > 0) {
                var beforeCursor = displayText.substring(0UI, this.cursorPosition.toUInt())
                cursorX = cursorX + graphics.calculateStringWidth(beforeCursor).toShort()
            }
            var fontHeight = graphics.getCurrentFontSize().toShort()
            var onChar = this.cursorPosition < displayText.length()
            var cursorChar = ""
            var cursorWidth: Short = 0S
            if (onChar) {
                cursorChar = displayText.substring(this.cursorPosition.toUInt(), 1UI)
                cursorWidth = graphics.calculateStringWidth(cursorChar).toShort()
            } else {
                // Caret past the last glyph — use "X" as a stand-in
                // width so the empty caret stays the same size as
                // an on-glyph caret.
                cursorWidth = graphics.calculateStringWidth("X").toShort()
            }
            var x1 = cursorX
            var x2 = cursorX + cursorWidth - 1S
            var y1 = textY - 1S
            var y2 = textY + fontHeight

            graphics.setForegroundPen(this.cursorPen)
            if (focused) {
                if (this.spinnerMode) {
                    // Time-driven triangular wave around the cursor's
                    // vertical midpoint. Reads as the cursor "folding
                    // edge-on" and back — a cheap loading indicator
                    // that doesn't need a real timer thread.
                    var halfH = TextField.spinnerHalfHeight(y2 - y1)
                    var midY = (y1 + y2) / 2S
                    var sy1 = midY - halfH
                    var sy2 = midY + halfH
                    graphics.fillRect(x1, sy1, x2, sy2)
                } else if (onChar) {
                    // Just the top + bottom bands; the glyph repaint
                    // below fills the middle row with the inverted
                    // character.
                    graphics.fillRect(x1, y1, x2, y1)
                    graphics.fillRect(x1, y2, x2, y2)
                    graphics.setBackgroundPen(this.cursorPen)
                    graphics.setForegroundPen(this.cursorTextPen)
                    graphics.drawString(cursorChar, cursorX, textY)
                    graphics.setBackgroundPen(this.backgroundPen)
                } else {
                    // Block caret at end of text.
                    graphics.fillRect(x1, y1, x2, y2)
                }
            } else {
                // Hollow outline — top, right, bottom, left.
                graphics.drawLine(x1, y1, x2, y1)
                graphics.drawLine(x2, y1, x2, y2)
                graphics.drawLine(x2, y2, x1, y2)
                graphics.drawLine(x1, y2, x1, y1)
            }
        }

        private fun drawSelection(graphics: Graphics, displayText: String, textX: Short, textY: Short) {
            if (!this.hasSelection() && !this.isSelecting()) {
                return
            }

            var window = this.getWindow()
            if (window == null) {
                return
            }

            var start = this.selectionStart
            var end = this.selectionEnd
            
            // Ensure start <= end
            if (start > end) {
                var temp = start
                start = end
                end = temp
            }

            // Get font height for drawing lines above and below
            var fontHeight = graphics.getCurrentFontSize().toShort()

            // Draw selection character by character with inverted colors
            var i = start
            while (i < end) {
                if (i >= displayText.length()) {
                    break
                }

                // Calculate position of this character
                var charX = textX
                if (i > 0) {
                    var beforeChar = displayText.substring(0UI, i.toUInt())
                    charX = textX + window.calculateStringWidth(null, beforeChar).toShort()
                }

                // Get the character
                var char = displayText.substring(i.toUInt(), 1UI)
                var charWidth = window.calculateStringWidth(null, char).toShort()

                // Draw selection background with lines above and below (like cursor)
                graphics.setForegroundPen(this.selectionPen)
                graphics.fillRect(charX, textY - 1S, charX + charWidth - 1S, textY - 1S) // Line above
                graphics.fillRect(charX, textY + fontHeight, charX + charWidth - 1S, textY + fontHeight) // Line below

                // Draw character with inverted colors
                graphics.setBackgroundPen(this.selectionPen)
                graphics.setForegroundPen(2UB) // White text on selection background
                graphics.drawString(char, charX, textY)

                i = i + 1
            }

            // Restore background pen
            graphics.setBackgroundPen(this.backgroundPen)
        }

        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            var isInside = this.contains(x, y)
//            ("TextField Mouse: type=" + type.toString() + " button=" + button.toString() + " x=" + x.toString() + " y=" + y.toString() + " inside=" + isInside.toString()).println()
//            ("Current isDragging=" + this.isDragging.toString() + " focused=" + this.isFocused().toString()).println()
            
            if (type == MouseEventType.down && button == MouseButton.left) {
                if (isInside) {
                    this.setFocused(true)
                    
                    // Calculate cursor position from x coordinate
                    var textX = this.borderWidths.left + this.padding.left
                    var relativeX = x - textX + this.scrollOffset // Account for scroll offset
                    var clickPosition = this.getPositionFromX(relativeX)
                    
                    // Start potential drag selection
                    this.isDragging = true
                    this.dragStartPosition = clickPosition  // Remember where we started
                    this.setCursorPosition(clickPosition)
                    this.clearSelection()
                    return true
                } else {
                    this.setFocused(false)
                    this.isDragging = false
                    return false
                }
            } else if (type == MouseEventType.move && this.isDragging) {
                // Drag selection - handle even when mouse is outside the TextField area
                if (this.isFocused()) {
                    var textX = this.borderWidths.left + this.padding.left
                    var relativeX = x - textX + this.scrollOffset // Account for scroll offset
                    var dragPosition = this.getPositionFromX(relativeX)
                    
//                    ("Drag: x=" + x.toString() + " textX=" + textX.toString() + " relativeX=" + relativeX.toString() + " dragPos=" + dragPosition.toString()).println()
//                    ("Drag: dragStart=" + this.dragStartPosition.toString() + " selStart=" + this.selectionStart.toString() + " selEnd=" + this.selectionEnd.toString()).println()
                    
                    // Set selection from drag start position to current drag position
                    this.selectionStart = this.dragStartPosition
                    this.selectionEnd = dragPosition
                    this.cursorPosition = dragPosition
                    
//                    ("After: selStart=" + this.selectionStart.toString() + " selEnd=" + this.selectionEnd.toString()).println()
                    
                    this.updateScrollOffset()
                    this.requestRepaint()
                    return true
                }
            } else if (this.isDragging && type == MouseEventType.up && button == MouseButton.left) {
                // Always stop dragging on mouse up, regardless of where the mouse is
                this.isDragging = false
                return isInside
            }
            
            return false
        }

        private fun getPositionFromX(relativeX: Short): Int {
//            ("getPositionFromX: relativeX=" + relativeX.toString()).println()
            
            // Handle dragging to the left of the text (should select from beginning)
            if (relativeX <= 0S) {
//                ("getPositionFromX: returning 0 for negative relativeX").println()
                return 0
            }

            // Calculate which character position corresponds to the x coordinate
            var displayText = this.text
            if (this.passwordMode) {
                var stars = ""
                var i = 0
                while (i < displayText.length()) {
                    stars = stars + "*"
                    i = i + 1
                }
                displayText = stars
            }
            
            var window = this.getWindow()
            if (window != null) {
                var bestPosition = 0
                var bestDistance = relativeX.toInt()
                
                // Check each position in the text
                var pos = 0
                while (pos <= displayText.length()) {
                    var width = 0S
                    if (pos > 0) {
                        var substring = displayText.substring(0UI, pos.toUInt())
                        width = window.calculateStringWidth(null, substring).toShort()
                    }
                    
                    var distance = (relativeX - width).toInt()
                    if (distance < 0) {
                        distance = -distance
                    }
                    
                    if (distance < bestDistance) {
                        bestDistance = distance
                        bestPosition = pos
                    }
                    
                    pos = pos + 1
                }
                
                // Handle dragging far to the right (should select to end)
                if (relativeX > 0S && bestPosition == displayText.length()) {
                    var totalWidth = 0S
                    if (displayText.length() > 0) {
                        totalWidth = window.calculateStringWidth(null, displayText).toShort()
                    }
                    if (relativeX > totalWidth) {
//                        ("getPositionFromX: dragging beyond text, returning end position " + displayText.length().toString()).println()
                        return displayText.length() // Select to end when dragging beyond text
                    }
                }
                
//                ("getPositionFromX: returning bestPosition=" + bestPosition.toString()).println()
                return bestPosition
            } else {
                // Fallback if no graphics context
                return this.text.length()
            }
        }

        override fun onKeyboardEvent(type: KeyboardEventType, keyCode: UShort, keyChar: UShort): Bool {           
            if (!this.isFocused() || this.readOnly) {
                return false
            }
//            "Key code: ${keyCode.toString()}, char: ${keyChar.toString()}".println()
            if (type == KeyboardEventType.down) {
                // Handle arrow keys and navigation first (using keyCode)
                if (keyCode == 79US) { // Left arrow (AmigaOS raw key)
                    var extendSelection = (keyChar == 1US) // keyChar=1 indicates Shift was held
                    this.moveCursor(this.cursorPosition - 1, extendSelection)
                    return true
                } else if (keyCode == 78US) { // Right arrow (AmigaOS raw key)
                    var extendSelection = (keyChar == 1US) // keyChar=1 indicates Shift was held
                    this.moveCursor(this.cursorPosition + 1, extendSelection)
                    return true
                } else if (keyCode == 76US) { // Up arrow (could be used for Home)
                    var extendSelection = (keyChar == 1US) // keyChar=1 indicates Shift was held
                    this.moveCursor(0, extendSelection)
                    return true
                } else if (keyCode == 77US) { // Down arrow (could be used for End)
                    var extendSelection = (keyChar == 1US) // keyChar=1 indicates Shift was held
                    this.moveCursor(this.text.length(), extendSelection)
                    return true
                } else if (keyCode == 70US) { // Delete key (AmigaOS raw key)
                    this.deleteForward()
                    return true
                }
                
                // Shift+arrow key support is now implemented above
                // keyChar=1 indicates Shift modifier was held during arrow key press
                
                // Handle special character keys using keyChar
                if (keyChar == 8US) { // Backspace (ASCII)
                    this.deleteBackward()
                    return true
                } else if (keyChar == 127US) { // Delete (ASCII)
                    this.deleteForward()
                    return true
                } else if (keyChar == 1US) { // Ctrl+A (Select All)
                    this.selectAll()
                    return true
                } else if (keyChar == 3US) { // Ctrl+C (Copy)
                    if (this.hasSelection()) {
                        this.copySelectedText()
                    }
                    return true
                } else if (keyChar == 22US) { // Ctrl+V (Paste)
                    this.pasteText()
                    return true
                } else if (keyChar == 9US) { // Tab
                    if (this.submitListener != null) {
                        return this.submitListener(this.text)
                    }
                    return false
                } else if (keyChar == 13US || keyChar == 10US) { // Return/Enter
                    if (this.submitListener != null) {
                        return this.submitListener(this.text)
                    }
                    return false
                } else if (keyChar == 27US) { // ESC
                    if (this.cancelListener != null) {
                        return this.cancelListener()
                    }
                    return false
                } else if (keyChar >= 32US && keyChar <= 126US) { // Printable ASCII from keyChar
                    // Convert keyChar to string and use existing insertText method
                    var sb = new StringBuilder()
                    sb.addChar(keyChar)
                    var charString = sb.toString()
                    
                    this.insertText(charString)
                    return true
                }
                
                // Also check if keyChar has control character values for special keys
                if (keyChar == 37US) { // Left arrow (if passed as ASCII)
                    this.moveCursor(this.cursorPosition - 1, false)
                    return true
                } else if (keyChar == 39US) { // Right arrow (if passed as ASCII)
                    this.moveCursor(this.cursorPosition + 1, false)
                    return true
                } else if (keyChar == 36US) { // Home (if passed as ASCII)
                    this.moveCursor(0, false)
                    return true
                } else if (keyChar == 35US) { // End (if passed as ASCII)
                    this.moveCursor(this.text.length(), false)
                    return true
                }
            }
            return false
        }
    }
}