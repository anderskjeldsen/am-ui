namespace Am.Ui
{
    // A hardware bitmap backed by a native AmigaOS struct BitMap (CyberGraphX true color).
    // Create via the static factory methods rather than constructing directly.
    #implementationPlatforms "libc", "amigaos", "amigaos-sim", "morphos-ppc", "macos-arm", "linux-x64"
    native class Bitmap {
        import Am.Lang
        import Am.Imaging

        var width: UShort
        var height: UShort
        var pixelFormat: BitmapPixelFormat

        // Create an empty (cleared) true-colour bitmap.
        // window is used to obtain a friend bitmap matching the screen's pixel format.
        private native fun createEmpty(width: UShort, height: UShort, window: Window)

        // Populate the bitmap from an Am.Imaging.Image.
        // window is used to obtain a friend bitmap matching the screen's pixel format.
        private native fun createFromImage(image: Am.Imaging.Image, window: Window)

        // Like createFromImage but ALSO builds a 1-bit mask from the
        // source image's alpha channel — pixels with alpha < 128 read
        // as "transparent" and are skipped by drawBitmap (uses
        // BltMaskBitMapRastPort with the mask plane). Gives chroma-
        // key style transparency: hard edges, no anti-aliasing, but
        // works on every Amiga display target (classic chunky AND
        // RTG). Indexed-source images get an all-opaque mask — no
        // alpha to read.
        private native fun createFromImageWithMask(image: Am.Imaging.Image, window: Window)

        fun getWidth(): UShort {
            return this.width
        }

        fun getHeight(): UShort {
            return this.height
        }

        fun getPixelFormat(): BitmapPixelFormat {
            return this.pixelFormat
        }

        // Factory: allocate a blank bitmap of the given size.
        static fun empty(width: UShort, height: UShort, window: Window): Bitmap {
            var bmp = new Bitmap()
            bmp.createEmpty(width, height, window)
            return bmp
        }

        // Factory: create a bitmap from an image.
        static fun fromImage(image: Image, window: Window): Bitmap {
            var bmp = new Bitmap()
            bmp.createFromImage(image, window)
            return bmp
        }

        // Factory: same as fromImage but with a 1-bit transparency
        // mask derived from the source image's alpha channel. Use
        // this for icons / glyphs that need to composite over an
        // arbitrary background — drawBitmap detects the mask and
        // routes through BltMaskBitMapRastPort so the destination
        // pixels under "transparent" source pixels survive.
        static fun fromImageWithMask(image: Image, window: Window): Bitmap {
            var bmp = new Bitmap()
            bmp.createFromImageWithMask(image, window)
            return bmp
        }
    }
}
