
namespace Am.Ui
{

    class ScrollView() : View {
        import Am.Lang
        import Am.Collections

        private var child: View? = null
        private var scrollY: Short = 0S

        // Thumb / track colours. Default thumb is pen 1 (host black);
        // owners typically override with a theme-appropriate dark grey.
        // trackPen = 0 paints the track in pen 0 (Workbench background);
        // matches the sidebar in the IDE theme so the thumb visually
        // floats on the bar.
        var scrollbarThumbPen: UByte = 1UB
        var scrollbarTrackPen: UByte = 0UB
        // Highlight pen used while the cursor sits over the thumb or
        // a drag is in progress. Default matches the idle pen so
        // unthemed scrollers behave as before; themed callers set
        // this to their accent colour.
        var scrollbarThumbHoverPen: UByte = 1UB

        // Fill pen for the viewport background. Used to wipe the
        // off-screen buffer below the child before re-painting on
        // every cycle. Without this, scrolling drags rows leave
        // ghost pixels behind in the gaps between rows (anything
        // the child does NOT draw over). `fillBackground` gates the
        // fill so the legacy "paint() is a no-op" behaviour stays
        // the default — callers opt in by flipping the flag and
        // setting `backgroundPen`.
        var backgroundPen: UByte = 0UB
        var fillBackground: Bool = false

        private static const SCROLLBAR_W: Short  = 10S
        private static const MIN_THUMB_H: Short  = 16S
        private static const THUMB_INSET: Short  = 1S

        // Active thumb-drag state. dragMouseStartY is in local coords
        // (relative to the scroll view); dragScrollStartY snapshots
        // scrollY at the moment the drag began so cursor deltas map
        // back to absolute scroll positions without compounding.
        private var draggingThumb: Bool       = false
        private var dragMouseStartY: Short    = 0S
        private var dragScrollStartY: Short   = 0S

        // Hover state for the thumb. Tracked separately from the
        // drag flag so the highlight stays lit during a drag even
        // if the cursor wanders off the lane (matches the OS
        // conventions for scrollbar feedback).
        private var thumbHovered: Bool        = false

        // Window-level mouse listener. Subscribed in onAttach so
        // the scrollbar's drag and hover state stay correct even
        // when LayeredPane routes moves to a *different* layer
        // (e.g. an overlay sits over us): the global listener
        // fires for every move + button event regardless of
        // routing, and the dispatch path keeps handling in-bounds
        // clicks and clean wheel events.
        private var mouseListener: MouseEventListener? = null

        override fun setDefaultPadding() {
            this.setPadding(0S)
        }

        override fun setDefaultBorder() {
            this.setBorderWidths(0S)
        }

        override fun onAttach(viewContext: ViewContext) {
            base.onAttach(viewContext)
            this.child?.onAttach(viewContext)

            // Hook the window's global mouse stream. We want move
            // events even when the cursor sits in another layer
            // (LayeredPane stopped routing those to us), so a
            // thumb drag started inside this view keeps tracking
            // and hover state clears when the user lifts the
            // button without sliding back onto the bar.
            var win = viewContext.getWindow()
            if (win == null) {
                return
            }
            var self = this
            var ml = new MouseEventListener()
            ml.listener = (me) => {
                self.onWindowMouse(me)
                return false
            }
            this.mouseListener = ml
            win.addMouseEventListener(ml)
        }

        override fun onDetach() {
            if (this.mouseListener != null) {
                var vc = this.getViewContext()
                if (vc != null) {
                    var win = vc.getWindow()
                    if (win != null) {
                        win.removeMouseEventListener(this.mouseListener)
                    }
                }
                this.mouseListener = null
            }
            base.onDetach()
            this.child?.onDetach()
        }

        // Window-level mouse event handler. NOT private — the
        // listener lambda is compiled into a separate inner class
        // that can't reach private members of ScrollView (silent
        // runtime no-op per [[feedback-amlang-lambda-gotchas]]
        // §Bonus rule).
        //
        // Three things we care about:
        //   * move while dragging: update scrollY from absolute
        //     coords. The dispatch path also fires when the
        //     cursor is still in-bounds, so we only do work here
        //     when the dispatch path can't reach us — but it's
        //     cheap, so just doing it unconditionally is fine.
        //   * up while dragging: end the drag. Mirrors the
        //     existing onMouseEvent up handler; this one runs
        //     even if the cursor lifted in a sibling layer.
        //   * move without drag: clear hover state when the
        //     cursor leaves the bar lane. Without this, the hover
        //     highlight stays lit after the cursor enters an
        //     overlay above us.
        fun onWindowMouse(me: MouseEvent) {
            if (me.type == MouseEventType.move) {
                if (this.draggingThumb) {
                    this.updateDragFromWindow(me.x, me.y)
                }
                // Always update hover, even during a drag. The visual
                // override (`thumbHovered || draggingThumb`) keeps the
                // highlight lit while dragging regardless, so this is
                // cosmetic-only — but if the drag flag got stuck
                // somehow, at least the hover state reflects reality.
                this.updateHoverFromWindow(me.x, me.y)
            } else if (me.type == MouseEventType.down) {
                // Defensive clear: an unfinished previous drag (e.g.
                // user released the button outside the window so we
                // never saw the up event) would otherwise keep
                // draggingThumb set forever. A fresh mousedown is the
                // earliest reliable signal that the previous gesture
                // is over.
                if (this.draggingThumb) {
                    this.draggingThumb = false
                }
                this.updateHoverFromWindow(me.x, me.y)
            } else if (me.type == MouseEventType.up) {
                if (this.draggingThumb) {
                    this.draggingThumb = false
                }
                if (!this.cursorIsOverThumbWindow(me.x, me.y)) {
                    this.setThumbHovered(false)
                }
            }
        }

        // Translate window-absolute coords into the scroll view's
        // local frame and feed them through the drag math used by
        // onMouseEvent's move path. Same delta-from-drag-start
        // formula so the thumb tracks the cursor 1:1.
        fun updateDragFromWindow(wx: Short, wy: Short) {
            var r = this.computeWindowRect()
            var ly = wy - r.y
            // Clamp to the ScrollView's vertical extent — SDL keeps
            // delivering move events with the raw mouse position
            // when the cursor exits the app window (button-held
            // capture behaviour), and those can be very negative or
            // larger than the window height. Without the clamp, the
            // dy delta blew past the track and dragScrollStartY +
            // (dy * max) / travel resolved to a large negative
            // number, which clampScrollY then pinned to 0 — i.e.
            // "jumps to the top" the moment you drift off the edge.
            // Clamping to [0, viewportHeight] pins the thumb at
            // the track boundary instead; when you drift back in
            // from that edge the drag picks up where it left off.
            var vh = this.viewportHeight()
            if (ly < 0S) { ly = 0S }
            if (ly > vh) { ly = vh }
            var dy = (ly - this.dragMouseStartY).toInt()
            var travel = (vh - this.thumbHeight()).toInt()
            if (travel <= 0) {
                return
            }
            var max = this.maxScrollY().toInt()
            var newScroll = this.dragScrollStartY.toInt() + (dy * max) / travel
            this.scrollY = newScroll.toShort()
            this.clampScrollY()
            this.forceRepaintNow()
        }

        // Re-evaluate the thumb-hover highlight using window-
        // absolute coords. Used by the window mouse listener so
        // the highlight clears even when the cursor enters an
        // overlay above us (LayeredPane stops dispatching moves
        // to our layer in that case).
        fun updateHoverFromWindow(wx: Short, wy: Short) {
            this.setThumbHovered(this.cursorIsOverThumbWindow(wx, wy))
        }

        // Window-absolute hit test against the thumb's pane-space
        // rect. Returns false when there's no scrollbar at all.
        private fun cursorIsOverThumbWindow(wx: Short, wy: Short): Bool {
            if (!this.needsScrollbar()) {
                return false
            }
            var r = this.computeWindowRect()
            var sbX = r.x + this.scrollbarX()
            var sbX2 = sbX + ScrollView.SCROLLBAR_W
            if (wx < sbX || wx >= sbX2) {
                return false
            }
            var ty = r.y + this.thumbY()
            var ty2 = ty + this.thumbHeight()
            return wy >= ty && wy < ty2
        }

        override fun minHeight(): Short {
            return 0S
        }

        override fun minWidth(): Short {
            return 0S
        }

        // -------- geometry helpers --------

        private fun contentHeight(): Short {
            if (this.child == null) {
                return 0S
            }
            return this.child.minHeight()
        }

        private fun needsScrollbar(): Bool {
            return this.contentHeight() > this.height.toShort()
        }

        private fun viewportWidth(): Short {
            var w = this.width.toShort()
            if (this.needsScrollbar()) {
                w = w - ScrollView.SCROLLBAR_W
            }
            return w
        }

        private fun viewportHeight(): Short {
            return this.height.toShort()
        }

        private fun maxScrollY(): Short {
            var m = this.contentHeight() - this.viewportHeight()
            if (m < 0S) {
                return 0S
            }
            return m
        }

        private fun clampScrollY() {
            var max = this.maxScrollY()
            if (this.scrollY < 0S) {
                this.scrollY = 0S
            }
            if (this.scrollY > max) {
                this.scrollY = max
            }
        }

        private fun scrollbarX(): Short {
            return this.width.toShort() - ScrollView.SCROLLBAR_W
        }

        private fun thumbHeight(): Short {
            var vpH = this.viewportHeight().toInt()
            var ch = this.contentHeight().toInt()
            if (ch <= 0) {
                return ScrollView.MIN_THUMB_H
            }
            // Thumb height = viewport² / content (the usual visible-
            // fraction → thumb-height mapping). Promote to Int — at
            // viewport heights above 180px, vpH*vpH overflows Short.
            // Clamp to a minimum so very long lists still leave a
            // draggable target.
            var th = (vpH * vpH) / ch
            if (th < ScrollView.MIN_THUMB_H.toInt()) {
                th = ScrollView.MIN_THUMB_H.toInt()
            }
            if (th > vpH) {
                th = vpH
            }
            return th.toShort()
        }

        private fun thumbY(): Short {
            var max = this.maxScrollY().toInt()
            if (max <= 0) {
                return 0S
            }
            var travel = (this.viewportHeight() - this.thumbHeight()).toInt()
            if (travel <= 0) {
                return 0S
            }
            // Int math — scrollY*travel overflows Short for any long
            // file list (content height > ~150 rows).
            var ty = (this.scrollY.toInt() * travel) / max
            return ty.toShort()
        }

        // -------- layout + paint --------

        override fun layout(x: Short, y: Short, width: UShort, height: UShort) {
            base.layout(x, y, width, height)
            this.layoutChildren()
        }

        private fun layoutChildren() {
            if (this.child == null) {
                return
            }
            var fullWidth = this.width.toShort()
            var availH = this.height.toShort()
            // Probe pass — lay the child out at full width so its
            // wrap state (and therefore minHeight) reflects the
            // "no scrollbar yet" case. Without this, the child's
            // minHeight may still be the small cached value from a
            // previous narrower layout, the probe says
            // "scrollbar needed = false", the child gets the full
            // width, but then a new bubble (added between layouts)
            // pushes minHeight past the viewport — and the scrollbar
            // paints on top of the content's right edge.
            this.child.layout(0S, 0S, fullWidth.toUShort(), availH.toUShort())
            var vw = fullWidth
            if (this.child.minHeight() > availH) {
                vw = fullWidth - ScrollView.SCROLLBAR_W
            }
            // Narrowing forces a re-wrap on WrappedTextView-bearing
            // children, which can grow minHeight further. Lay out
            // again at the actual viewport width so the row count is
            // re-counted before the final height pass below.
            if (vw != fullWidth) {
                this.child.layout(0S, 0S, vw.toUShort(), availH.toUShort())
            }
            // Final pass — give the child whichever is taller of its
            // natural content height or the viewport itself, so the
            // scroll-y math has room to walk.
            var ch = this.child.minHeight()
            var laidH = ch
            if (laidH < availH) {
                laidH = availH
            }
            this.child.layout(0S, 0S, vw.toUShort(), laidH.toUShort())
            this.clampScrollY()
        }

        override fun paintAll(graphics: Graphics) {
            var b1 = graphics.shouldRepaintAll()
            var b2 = this.getRepaintRequested()

            // Phase 1: scroll view's own background (paint() is a no-op
            // by default; subclasses or styled callers can fill).
            var ix = this.x + this.margin.left
            var iy = this.y + this.margin.top
            var viewWidth = this.width.toShort() - this.margin.left - this.margin.right
            var viewHeight = this.height.toShort() - this.margin.top - this.margin.bottom

            var currentClip = graphics.getCurrentClipRect()
            var viewClipRect: ClipRect = currentClip.createInnerClipRect(ix, iy, viewWidth.toUShort(), viewHeight.toUShort())

            // Sub-rect clip narrowing — see View.paintAll for rationale.
            // ScrollView.paint() does a full-inner bg fillRect; without
            // narrowing it wipes the offscreen pixels of every child
            // (especially the inner resultStack rows / labels) when this
            // view was invalidated only in a sub-region by the cross-
            // layer dirty cascade. The flagged children re-paint inside
            // the sub-rect, but children outside get cleared and never
            // repainted → blank rows / missing content.
            //
            // BUT: when scroll (or any owner-driven change) fired
            // requestRepaintTree, b2 is set and the intent is "redraw
            // the whole viewport at the new offset" — every child moved,
            // every pixel matters. Any stale dirty rect that survived
            // from a prior cross-layer cascade would narrow the fill to
            // a strip and leak the previous frame's row pixels into the
            // gaps between (transparent) rows. So the narrowing only
            // fires for pure descendant-driven partial invalidations
            // (b1 == b2 == false, hasDirtyRects() == true).
            var paintClipRect: ClipRect = viewClipRect
            if (!b1 && !b2 && this.hasDirtyRects()) {
                var union = this.dirtyRectUnion()
                paintClipRect = viewClipRect.createInnerClipRect(union.x, union.y, union.width, union.height)
            }
            graphics.pushClipRect(paintClipRect)

            if (b1 || b2) {
                graphics.translate(ix, iy)
                this.beginPaintCycle()
                this.paint(graphics)
                this.reportPaintedBounds(graphics, viewWidth, viewHeight)
                graphics.translate(-ix, -iy)
            }
            this.markAsPainted()

            graphics.popClipRect()

            // Phase 2: child, clipped to the viewport (which excludes
            // the scrollbar lane).
            //
            // We bake the scroll offset directly into the child's
            // immediate children's y positions, rather than relying
            // on a translate. createInnerClipRect computes new clips
            // as (parent_clip_origin + child_local_xy) and clamps to
            // the parent. A translate-only approach desyncs from this
            // math: the child draws at the translated y but its clip
            // sits at the unshifted y and clips the draw out. By
            // shifting the immediate children's y values down/up by
            // -scrollY for the duration of the paint, the natural
            // clip-and-translate composition gives the right world
            // positions and the labels' clips align with where they
            // actually draw. Restored immediately after the paint so
            // layout (which assigns these positions) stays the source
            // of truth between frames.
            if (this.child != null) {
                var vpW = this.viewportWidth()
                var vpH = this.viewportHeight()
                viewClipRect = currentClip.createInnerClipRect(this.x, this.y, vpW.toUShort(), vpH.toUShort())
                graphics.pushClipRect(viewClipRect)

                // Shift the direct child's y (single write) instead of
                // iterating grandchildren via applyScrollOffset. This
                // works for any child type — BitMapView, Label, Panel,
                // VStack — not just ViewGroups (View's base
                // applyScrollOffset is a no-op). Same "apply → paint
                // → restore" shape as before; the shift is transient
                // so layout code that reads `child.y` between paints
                // still sees the layout position.
                this.child.y = this.child.y - this.scrollY

                graphics.translate(this.x, this.y)
                this.child.paintAll(graphics)
                graphics.translate(0S - this.x, 0S - this.y)

                this.child.y = this.child.y + this.scrollY

                graphics.popClipRect()
            }

            // Phase 3: scrollbar, on top of everything else, clipped
            // to the scroll view's full rect.
            //
            // Gated on `b1 || b2` so the lane only re-stamps when the
            // ScrollView is genuinely dirty. Painting unconditionally
            // would overwrite higher-z layers in the offscreen buffer
            // (e.g. an open Settings sidebar overlapping the file
            // tree's lane); the LayeredPane pre-pass that flags
            // overlay layers when a lower-z descendant is dirty is
            // flag-driven, so Phase 3 has to respect the flag to be
            // visible to it.
            //
            // Every scrollbar-state change (scrollY drag/wheel/page,
            // thumbHovered, draggingThumb) routes through
            // `forceRepaintNow()` → `requestRepaintTree()`, which
            // sets `b2` on the ScrollView. So the gate is non-lossy:
            // any genuine state change still triggers Phase 3.
            if (this.needsScrollbar() && (b1 || b2)) {
                viewClipRect = currentClip.createInnerClipRect(this.x, this.y, this.width, this.height)
                graphics.pushClipRect(viewClipRect)
                graphics.translate(this.x, this.y)
                this.paintScrollbar(graphics)
                this.reportScrollbarBounds(graphics)
                graphics.translate(-this.x, -this.y)
                graphics.popClipRect()
            }
        }

        // Tighter version of reportPaintedBounds for Phase 3 — the
        // scrollbar only writes pixels into a narrow vertical strip
        // on the right edge, so reporting the full outer rect would
        // pull a 600 × 500 sub-rect into the cycle's dirty union for
        // a thumb that fits in 10 × ~30 px.
        private fun reportScrollbarBounds(graphics: Graphics) {
            var vc = this.getViewContext()
            if (vc == null) {
                return
            }
            var win = vc.getWindow()
            if (win == null) {
                return
            }
            var sbX = this.scrollbarX()
            win.expandDirtyBounds(graphics.getTranslateX() + sbX,
                                  graphics.getTranslateY(),
                                  ScrollView.SCROLLBAR_W,
                                  this.viewportHeight())
        }

        // Phase-1 viewport fill — needed when scrolling, otherwise
        // the offscreen buffer keeps the previous frame's pixels in
        // any area the children don't repaint (between rows, below
        // a short list, etc). Partial scroll cycles don't trigger
        // the slot's bg fill, so without this the gaps show stale
        // card / row content.
        //
        // Opt-in via `fillBackground` so legacy callers that wrap
        // the ScrollView in a Panel keep working. Pen is the
        // caller-set `backgroundPen` — restyleScrollbar in
        // AminetView / ChatGptView keeps it in sync with their
        // sidebar-bg.
        override fun paint(graphics: Graphics) {
            if (!this.fillBackground) {
                return
            }
            var w = this.viewportWidth()
            var h = this.viewportHeight()
            if (w <= 0S || h <= 0S) {
                return
            }
            graphics.setForegroundPen(this.backgroundPen)
            graphics.fillRect(0S, 0S, w - 1S, h - 1S)
        }

        private fun paintScrollbar(graphics: Graphics) {
            var sbX = this.scrollbarX()
            var sbW = ScrollView.SCROLLBAR_W
            var vpH = this.viewportHeight()

            // Track.
            graphics.setForegroundPen(this.scrollbarTrackPen)
            graphics.fillRect(sbX, 0S, (sbX + sbW) - 1S, vpH - 1S)

            // Thumb — inset by 1 px on each side so the lane edge is
            // visible regardless of track pen.
            var ty = this.thumbY()
            var th = this.thumbHeight()
            var thumbPen = this.scrollbarThumbPen
            if (this.thumbHovered || this.draggingThumb) {
                thumbPen = this.scrollbarThumbHoverPen
            }
            graphics.setForegroundPen(thumbPen)
            graphics.fillRect((sbX + ScrollView.THUMB_INSET), ty, ((sbX + sbW) - ScrollView.THUMB_INSET) - 1S, (ty + th) - 1S)
        }

        // Wheel ticks scroll the thumb when the cursor is over the
        // viewport. Inner scrollers get first crack — a nested
        // ScrollView under the cursor handles before we do, which is
        // the standard "innermost scrollable wins" rule. Forwarding
        // uses the same scroll-shifted local-coord conversion as
        // mouse clicks so the inner view sees coords in its own
        // post-scroll frame.
        override fun onMouseWheel(deltaY: Short, x: Short, y: Short): Bool {
            if (!this.contains(x, y)) {
                return false
            }
            var c = this.child
            if (c != null) {
                var lx = x - c.x
                var ly = (y - c.y) + this.scrollY
                if (c.onMouseWheel(deltaY, lx, ly)) {
                    return true
                }
            }
            if (!this.needsScrollbar()) {
                return false
            }
            // 30 px per wheel tick — about three rows of Topaz/8.
            // deltaY > 0 means wheel rolled DOWN (content moves up,
            // scrollY increases).
            var step = (deltaY.toInt() * 30)
            this.scrollY = (this.scrollY.toInt() + step).toShort()
            this.clampScrollY()
            this.forceRepaintNow()
            return true
        }

        // Single-child wrapper held outside ViewGroup.children, so
        // the default walk would only mark the scroll view itself.
        // Recurse so the wrapped content actually repaints on a
        // subtree request.
        override fun requestRepaintTree() {
            base.requestRepaintTree()
            this.child?.requestRepaintTree()
        }

        fun setChild(child: View) {
            if (this.child != null && this.child != child) {
                this.child.parentView = null
            }
            this.child = child
            if (child != null) {
                child.parentView = this
            }
        }

        override fun invalidateOverlapping(winRect: Rectangle) {
            base.invalidateOverlapping(winRect)
            if (this.child != null) {
                this.child.invalidateOverlapping(winRect)
            }
        }

        override fun hasDirtyOverlapping(target: Rectangle): Bool {
            var mine = this.computeWindowRect()
            if (!View.rectsOverlap(mine, target)) {
                return false
            }
            if (this.getRepaintRequested()) {
                return true
            }
            if (this.child != null) {
                return this.child.hasDirtyOverlapping(target)
            }
            return false
        }

        override fun collectFocusable(out: List<View>) {
            if (this.isFocusable()) {
                out.add(this)
            }
            if (this.child != null) {
                this.child.collectFocusable(out)
            }
        }

        fun getChild(): View {
            return this.child
        }

        // -------- mouse handling --------

        // Synchronous repaint helper: scroll changes have to land in
        // the visible window *during* the drag, not after the next
        // event loop tick. Drag-move events on AmigaOS arrive via
        // INTUITICKS (~10Hz), so waiting for the natural refresh
        // cadence makes the bar feel completely unresponsive.
        private fun forceRepaintNow() {
            this.requestRepaintTree()
            var w = this.getWindow()
            if (w != null) {
                w.repaint()
            }
        }

        // Cursor-over-thumb test. Caller passes coordinates already
        // in the scroll view's local frame.
        private fun isPointOverThumb(x: Short, y: Short): Bool {
            if (!this.needsScrollbar()) {
                return false
            }
            if (x < this.scrollbarX()) {
                return false
            }
            var ty = this.thumbY()
            var th = this.thumbHeight()
            return y >= ty && y < ty + th
        }

        // Update hover state and force a synchronous repaint if it
        // actually changed. Centralised so every code path that
        // changes hover (move-in-lane, move-out-of-view, drag end)
        // funnels through the same paint trigger.
        private fun setThumbHovered(hovered: Bool) {
            if (this.thumbHovered == hovered) {
                return
            }
            this.thumbHovered = hovered
            this.forceRepaintNow()
        }

        override fun onMouseEvent(type: MouseEventType, button: MouseButton, x: Short, y: Short): Bool {
            // Active drag: move / up are handled EXCLUSIVELY by
            // onWindowMouse. The layer-scoped dispatch path here
            // gets fed (-1, -1) by LayeredPane whenever the cursor
            // leaves the current owner layer (e.g. drags out of a
            // ModalDialog that hosts this ScrollView) — running
            // the drag math on those bogus coords races the window
            // listener's real-coord update every frame, and the
            // resulting delta pinned scrollY to the track edge
            // ("jumps to the top" the moment the mouse leaves).
            if (this.draggingThumb) {
                if (type == MouseEventType.move) {
                    return true
                }
                if (type == MouseEventType.up) {
                    this.draggingThumb = false
                    return true
                }
            }

            if (!this.contains(x, y)) {
                // Cursor left the view — clear the hover highlight.
                this.setThumbHovered(false)
                // Mouse-up still has to reach the child so any drag
                // state it's holding can be cleared. Mouse-move also
                // has to reach the child so any *hover* state it's
                // holding (a Label's [...] glyph, etc.) can clear
                // when the cursor slides off into a sibling view.
                //
                // Forward the event for cleanup, but DO NOT claim it:
                // when scrolled content is taller than the viewport,
                // the clipped-out portion still occupies translated
                // coords that overlap sibling views beyond this
                // ScrollView. A label inside a clipped chat bubble,
                // for instance, would otherwise `contains()` an
                // up-click that visually landed on a sibling agent-
                // mode checkbox / dropdown / button below the scroll,
                // returning true and stopping the parent's walk
                // before the real target sees the click. Forcing
                // false here keeps the cleanup side-effect while
                // letting the parent ViewGroup continue dispatching
                // to its later children.
                if (this.child != null) {
                    if (type == MouseEventType.up || type == MouseEventType.move) {
                        var ux = x - this.child.x
                        var uy = (y - this.child.y) + this.scrollY
                        this.child.onMouseEvent(type, button, ux, uy)
                    }
                }
                return false
            }

            // Hover-state update for every move that lands inside
            // the view. Runs before the lane-vs-child dispatch so a
            // cursor sliding from the content into the scrollbar
            // (or vice versa) lights up the highlight correctly.
            if (type == MouseEventType.move) {
                this.setThumbHovered(this.isPointOverThumb(x, y))
            }

            // Click landed in the scrollbar lane?
            if (this.needsScrollbar() && x >= this.scrollbarX()) {
                if (type == MouseEventType.down && button == MouseButton.left) {
                    var ty = this.thumbY()
                    var th = this.thumbHeight()
                    if (y >= ty && y < ty + th) {
                        // Begin thumb drag.
                        this.draggingThumb = true
                        this.dragMouseStartY = y
                        this.dragScrollStartY = this.scrollY
                    } else {
                        // Track click — page by a viewport height in
                        // the direction of the click.
                        var page = this.viewportHeight()
                        if (y < ty) {
                            this.scrollY = this.scrollY - page
                        } else {
                            this.scrollY = this.scrollY + page
                        }
                        this.clampScrollY()
                        this.forceRepaintNow()
                    }
                    return true
                }
                // Other events in the bar lane are swallowed.
                return false
            }

            // Forward to child with the scroll offset added back in,
            // so clicks land on whatever row is *visually* under the
            // cursor (the child is painted shifted by -scrollY).
            if (this.child != null) {
                var lx = x - this.child.x
                var ly = (y - this.child.y) + this.scrollY
                return this.child.onMouseEvent(type, button, lx, ly)
            }
            return false
        }
    }
}

