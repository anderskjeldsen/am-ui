namespace Am.Ui
{
    // Renders a Bitmap within the view's bounds, scaling to fit when requested.
    class BitmapView(var bitmap: Bitmap) : View {
        import Am.Lang

        var scaleToFit: Bool = true
        var maintainAspectRatio: Bool = true

        fun setBitmap(bitmap: Bitmap) {
            this.bitmap = bitmap
            this.requestRepaint()
        }

        override fun minWidth(): Short {
            if (this.bitmap != null) {
                return this.bitmap.getWidth().toShort() + base.minWidth()
            }
            return base.minWidth()
        }

        override fun minHeight(): Short {
            if (this.bitmap != null) {
                return this.bitmap.getHeight().toShort() + base.minHeight()
            }
            return base.minHeight()
        }

        override fun paint(graphics: Graphics) {
            base.paint(graphics)

            if (this.bitmap == null) {
                return
            }

            var innerW = this.innerWidth()
            var innerH = this.innerHeight()
            var bmpW = this.bitmap.getWidth().toShort()
            var bmpH = this.bitmap.getHeight().toShort()

            if (innerW <= 0S || innerH <= 0S || bmpW <= 0S || bmpH <= 0S) {
                return
            }

            var innerWInt = innerW.toInt()
            var innerHInt = innerH.toInt()
            var bmpWInt = bmpW.toInt()
            var bmpHInt = bmpH.toInt()

            var drawX = 0S
            var drawY = 0S
            var drawW = bmpW
            var drawH = bmpH

            var drawWInt = bmpWInt
            var drawHInt = bmpHInt
            var drawXInt = 0
            var drawYInt = 0

            if (this.scaleToFit) {
                if (this.maintainAspectRatio) {
                    // Pick the scale factor that fits both dimensions
                    var useXScale = (innerWInt * bmpHInt) <= (innerHInt * bmpWInt)

                    if (useXScale) {
                        drawWInt = innerWInt
                        drawHInt = (bmpHInt * innerWInt) / bmpWInt
                    } else {
                        drawWInt = (bmpWInt * innerHInt) / bmpHInt
                        drawHInt = innerHInt
                    }

                    if (drawWInt < 1) {
                        drawWInt = 1
                    }
                    if (drawHInt < 1) {
                        drawHInt = 1
                    }

                    // Center within inner area
                    drawXInt = (innerWInt - drawWInt) / 2
                    drawYInt = (innerHInt - drawHInt) / 2
                } else {
                    drawWInt = innerWInt
                    drawHInt = innerHInt
                    drawXInt = 0
                    drawYInt = 0
                }
            } else {
                // Original size, centred
                drawWInt = bmpWInt
                drawHInt = bmpHInt
                drawXInt = (innerWInt - bmpWInt) / 2
                drawYInt = (innerHInt - bmpHInt) / 2
            }

            if (drawWInt <= 0 || drawHInt <= 0) {
                return
            }

            drawW = drawWInt.toShort()
            drawH = drawHInt.toShort()
            drawX = drawXInt.toShort()
            drawY = drawYInt.toShort()

            graphics.drawBitmap(this.bitmap, drawX, drawY, drawW, drawH)
        }
    }
}
