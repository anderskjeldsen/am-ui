namespace Am.Ui
{
    class MenuItem(var label: String, var clickListener: (item: MenuItem) => Bool) {
        import Am.Lang
        import Am.Collections

        var enabled: Bool = true
        // Single-character keyboard shortcut (Right-Amiga + key) for the
        // item. Null/empty leaves the item without a shortcut — Magic
        // Menu and similar enhancers use the presence of a CommKey to
        // pick a more spacious layout, so even a dummy key adds padding.
        var commKey: String = null

        // Optional sub-items, rendered as a cascading submenu under
        // this item (Intuition NM_SUB). When non-empty, this item's
        // own clickListener typically stays null — Intuition only
        // fires picks on the deepest level the user landed on.
        // Only one level of nesting is wired through to the native
        // strip today (NM_SUB inside NM_ITEM); deeper trees get
        // flattened by Window.setMenuStrip.
        var subItems: List<MenuItem> = new List<MenuItem>()

        // When TRUE, the native menu builder emits a horizontal bar
        // (NM_BARLABEL on Intuition) instead of a clickable item.
        // Build one via MenuItem.separator(); the label is irrelevant
        // for separator entries.
        var isSeparator: Bool = false

        fun addSubItem(item: MenuItem) {
            this.subItems.add(item)
        }

        fun invokeClick(): Bool {
            if (!this.enabled) {
                return false
            }
            var cl = this.clickListener
            if (cl != null) {
                return cl(this)
            }
            return false
        }

        // Build a non-clickable bar entry that the native side renders
        // as a horizontal separator. Use to group related items inside
        // a single Menu without having to split into multiple menus.
        static fun separator(): MenuItem {
            var noop: (item: MenuItem) => Bool = (i) => { return true }
            var mi = new MenuItem("-", noop)
            mi.isSeparator = true
            return mi
        }
    }
}
