
namespace Am.Ui 
{

    #implementationPlatforms "libc", "amigaos", "amigaos-sim", "morphos-ppc"
    native class Font(private var name: String, private var size: UByte) {
        import Am.Lang
        import Am.Collections

        private static var cache: HashMap<String, Font> = new HashMap<String, Font>()

        fun getName(): String {
            return this.name
        }

        fun getSize(): UByte {
            return this.size
        }

        native fun calculateStringWidth(text: String): UShort

        static fun loadFont(var name: String, var size: UByte): Font {
            var key = name + ":" + size.toString()
            ("[font.loadFont] enter key=" + key).println()
            if (Font.cache == null) {
                ("[font.loadFont] cache is NULL — static init didn't fire").println()
                return null
            }
            ("[font.loadFont] cache size before lookup=" + Font.cache.getSize().toString()).println()
            var font: Font = null
            try {
                font = Font.cache.get(key)
            } catch (e: Exception) {
                ("[font.loadFont] cache.get threw: " + e.message).println()
                font = null
            }
            if (font == null) {
                ("[font.loadFont] miss — constructing new Font(" + name + ", " + size.toString() + ")").println()
                try {
                    font = new Font(name, size)
                } catch (e: Exception) {
                    ("[font.loadFont] `new Font` threw: " + e.message).println()
                    return null
                }
                if (font == null) {
                    ("[font.loadFont] `new Font` returned null").println()
                } else {
                    ("[font.loadFont] constructed font OK").println()
                }
                try {
                    Font.cache.set(key, font)
                    ("[font.loadFont] cache.set OK (size now=" + Font.cache.getSize().toString() + ")").println()
                } catch (e: Exception) {
                    ("[font.loadFont] cache.set threw: " + e.message).println()
                }
            } else {
                ("[font.loadFont] hit — returning cached font").println()
            }
            return font
        }
    }

}

